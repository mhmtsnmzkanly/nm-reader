# ==============================================================================
# NM-Reader — Production Nginx Configuration Example
# ==============================================================================
# Installation:
#   1. Copy to: /etc/nginx/sites-available/nm-reader.conf
#   2. Update 'server_name', 'root' path and 'fastcgi_pass' socket
#   3. Enable site: ln -s /etc/nginx/sites-available/nm-reader.conf /etc/nginx/sites-enabled/
#   4. Validate: nginx -t
#   5. Reload: systemctl reload nginx
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    # Redirect HTTP to HTTPS (uncomment when SSL certificate is configured)
    # return 301 https://$host$request_uri;

    # Document root MUST point to the public/ subfolder
    root /var/www/nm-reader/public;
    index index.php index.html;

    charset utf-8;

    # Maximum upload size for chapter ZIPs and manga covers (UploadService supports up to 200MB)
    client_max_body_size 256M;

    # Security headers (supplements application middleware)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        application/json
        application/javascript
        application/xml
        application/xml+rss
        image/svg+xml;

    # --------------------------------------------------------------------------
    # 1. Protected HTML Templates
    # These shells are rendered by PHP controllers and must not be accessed directly.
    # --------------------------------------------------------------------------
    location ~* ^/(?:admin|install|maintenance)\.html$ {
        return 404;
    }

    # --------------------------------------------------------------------------
    # 2. Block Hidden & Sensitive Files (.env, .git, .htaccess)
    # --------------------------------------------------------------------------
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }

    # --------------------------------------------------------------------------
    # 3. Dynamic Virtual Endpoints
    # These routes are handled dynamically by Slim/PHP even if they look like files.
    # --------------------------------------------------------------------------
    location = /robots.txt {
        try_files $uri /index.php$is_args$args;
    }

    location = /sitemap.xml {
        try_files $uri /index.php$is_args$args;
    }

    location ^~ /api/ {
        try_files $uri /index.php$is_args$args;
    }

    location ^~ /media/ {
        try_files $uri /index.php$is_args$args;
    }

    # --------------------------------------------------------------------------
    # 4. Static Assets & Direct 404 Protection
    # Serve existing files directly with strong caching.
    # If a static asset does NOT exist, return 404 directly without waking PHP/React.
    # --------------------------------------------------------------------------
    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location ~* \.(?:css|js|mjs|map|json|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|eot|otf|mp4|webm|pdf|zip)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
        log_not_found off;
    }

    # --------------------------------------------------------------------------
    # 5. Application Front Controller (React SPA & Clean URLs)
    # --------------------------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    # --------------------------------------------------------------------------
    # 6. PHP-FPM FastCGI Handler
    # --------------------------------------------------------------------------
    location ~ \.php$ {
        try_files $uri =404;

        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        # Adjust PHP-FPM socket path to your installed PHP version
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        # Or TCP:
        # fastcgi_pass 127.0.0.1:9000;

        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        include fastcgi_params;

        # Longer timeout for heavy maintenance jobs (backup, warmup, sitemap)
        fastcgi_read_timeout 300s;
        fastcgi_buffer_size 128k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 256k;
    }
}
