Options -MultiViews -Indexes
DirectoryIndex index.php

RewriteEngine On

# These HTML shells are controller-owned templates. They must not bypass PHP
# placeholder replacement when requested directly.
RewriteRule ^(?:admin|install|maintenance)\.html$ - [F,END]

# Let Apache serve existing assets and other public files directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

# All clean URLs are handled by Slim's single entrypoint.
RewriteRule ^ index.php [QSA,END]
