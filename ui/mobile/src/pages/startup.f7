<template>
  <div class="page" data-name="startup">
    <div class="page-content startup-screen">
      <div class="startup-screen__content">
        <div class="startup-screen__brand">NMR Mobile</div>
        <div class="preloader color-blue"></div>
        <p>${state.message}</p>
      </div>
    </div>
  </div>
</template>
<script>
import { runStartup } from '../js/bootstrap.js';
import { debugError, debugTrace } from '../utils/debug.js';

export default (props, { $f7router, $onMounted, $update }) => {
  const state = {
    message: 'Preparing your mobile session...',
  };

  /**
   * Executes the startup redirect flow once the page is mounted.
   */
  async function start() {
    debugTrace({
      scope: 'route',
      action: 'startup:start',
      caller: 'ui/mobile/src/pages/startup.f7#start',
      callee: 'runStartup',
      next: 'resolve initial route target',
    });

    try {
      const result = await runStartup();
      debugTrace({
        scope: 'route',
        action: 'startup:navigate',
        caller: 'startup route',
        callee: `$f7router.navigate(${result.route || '/home/'})`,
        next: 'leave startup screen',
      });
      $f7router.navigate(result.route || '/home/', {
        reloadCurrent: true,
      });
    } catch (error) {
      debugError({
        scope: 'route',
        action: 'startup:error',
        caller: 'startup route',
        callee: 'startup fallback',
        next: 'navigate to /home/ after fallback timeout',
        error,
      });
      state.message = 'Startup fallback engaged. Opening home...';
      $update();
      window.setTimeout(() => {
        debugTrace({
          scope: 'route',
          action: 'startup:fallbackNavigate',
          caller: 'startup fallback timeout',
          callee: '$f7router.navigate(/home/)',
          next: 'render home page',
        });
        $f7router.navigate('/home/', {
          reloadCurrent: true,
        });
      }, 150);
    }
  }

  $onMounted(() => {
    debugTrace({
      scope: 'route',
      action: 'startup:mounted',
      caller: 'startup page lifecycle',
      callee: 'start',
      next: 'execute startup flow',
    });
    start();
  });

  return $render;
};
</script>
