<template>
  <div class="page" data-name="register">
    ${$h`${renderAppHeader({ title: 'Register', subtitle: 'Create a mobile account', back: true, large: true })}`}
    <div class="page-content">
      <div class="list inset">
        <ul>
          <li class="item-content item-input">
            <div class="item-inner">
              <div class="item-title item-label">Username</div>
              <div class="item-input-wrap">
                <input type="text" name="username" placeholder="Username" value="${state.form.username}" />
              </div>
            </div>
          </li>
          <li class="item-content item-input">
            <div class="item-inner">
              <div class="item-title item-label">Email</div>
              <div class="item-input-wrap">
                <input type="email" name="email" placeholder="you@example.com" value="${state.form.email}" />
              </div>
            </div>
          </li>
          <li class="item-content item-input">
            <div class="item-inner">
              <div class="item-title item-label">Password</div>
              <div class="item-input-wrap">
                <input type="password" name="password" placeholder="Password" value="${state.form.password}" />
              </div>
            </div>
          </li>
        </ul>
      </div>
      <div class="block">
        ${state.error ? $h`<div class="mobile-inline-error">${state.error}</div>` : ''}
        <button class="button button-fill" data-action="submit-register" ${state.submitting ? 'disabled' : ''}>${state.submitting ? 'Creating account...' : 'Register'}</button>
      </div>
      <div class="block-footer">
        Already registered?
        <a href="/login/">Login</a>
      </div>
    </div>
  </div>
</template>
<script>
import { register } from '../services/auth/auth-service.js';
import { renderAppHeader } from '../components/app-header.js';
import { debugError, debugTrace } from '../utils/debug.js';
import { resolveComponentElement } from '../utils/dom.js';

export default (props, { $el, $onMounted, $onBeforeUnmount, $update, $f7, $f7router }) => {
  const rootEl = () => resolveComponentElement($el);
  const state = {
    form: {
      username: '',
      email: '',
      password: '',
    },
    error: '',
    submitting: false,
  };

  /**
   * Reads current register inputs into local component state.
   */
  function syncForm() {
    debugTrace({
      scope: 'registerPage',
      action: 'syncForm',
      caller: 'registerPage.syncForm',
      callee: 'DOM.inputs',
      next: 'prepare-register-payload',
    });
    state.form.username = rootEl()?.querySelector('input[name="username"]')?.value || '';
    state.form.email = rootEl()?.querySelector('input[name="email"]')?.value || '';
    state.form.password = rootEl()?.querySelector('input[name="password"]')?.value || '';
  }

  /**
   * Submits registration and redirects to login on success.
   */
  async function submit() {
    debugTrace({
      scope: 'registerPage',
      action: 'submit:start',
      caller: 'registerPage.submit',
      callee: 'authService.register',
      next: 'navigate-login-on-success',
    });
    syncForm();
    state.error = '';
    state.submitting = true;
    $update();

    try {
      await register(state.form);
      debugTrace({
        scope: 'registerPage',
        action: 'submit:success',
        caller: 'registerPage.submit',
        callee: 'authService.register',
        next: 'show-success-dialog',
        detail: { username: state.form.username },
      });
      $f7.dialog.alert('Account created. Please log in.', 'Registration');
      $f7router.navigate('/login/', { reloadCurrent: true });
    } catch (error) {
      state.error = error.message || 'Registration failed.';
      debugError({
        scope: 'registerPage',
        action: 'submit:error',
        caller: 'registerPage.submit',
        callee: 'authService.register',
        next: 'render-register-error',
        detail: { message: state.error },
      });
    } finally {
      state.submitting = false;
      $update();
    }
  }

  /**
   * Handles register button taps.
   */
  function handleClick(event) {
    if (event.target.closest('[data-action="submit-register"]')) {
      debugTrace({
        scope: 'registerPage',
        action: 'submit:click',
        caller: 'registerPage.handleClick',
        callee: 'registerPage.submit',
        next: 'attempt-register',
      });
      submit();
    }
  }

  $onMounted(() => {
    debugTrace({
      scope: 'registerPage',
      action: 'mounted',
      caller: 'framework7.page',
      callee: 'registerPage.handleClick',
      next: 'wait-for-register-submit',
    });
    rootEl()?.addEventListener('click', handleClick);
  });

  $onBeforeUnmount(() => {
    rootEl()?.removeEventListener('click', handleClick);
  });

  return $render;
};
</script>
