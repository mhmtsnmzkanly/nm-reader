<template>
  <div class="page nmr-page" data-name="search">
    <div class="navbar nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <a class="link back">
            <i class="f7-icons">chevron_left</i>
          </a>
        </div>
        <div class="title nmr-title">Explore</div>
        <div class="subnavbar">
          <!-- F7 Searchbar Component -->
          <form class="searchbar nmr-searchbar">
            <div class="searchbar-inner">
              <div class="searchbar-input-wrap">
                <input type="search" name="q" placeholder="Search title, author, genre..." />
                <i class="searchbar-icon"></i>
                <span class="input-clear-button"></span>
              </div>
              <span class="searchbar-disable-button">Cancel</span>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="page-content">
      <div class="searchbar-backdrop"></div>

      <!-- Suggestions List -->
      ${state.suggestions.length > 0 && !state.loading ? $h`
        <div class="list simple-list inset no-margin-top margin-bottom-sm shadow-sm animate-fade-in">
          <ul>
            ${state.suggestions.map((s) => $h`
              <li>
                <a href="#" class="item-link" @click="${() => runSearch(s.title || s)}">${s.title || s}</a>
              </li>
            `)}
          </ul>
        </div>
      ` : ''}

      ${state.loading
        ? $h`
          <div class="list media-list no-hairlines no-chevron skeleton-text skeleton-effect-blink">
            <ul>
              ${[1, 2, 3, 4, 5].map(() => $h`
                <li>
                  <div class="item-content">
                    <div class="item-media">
                      <div class="skeleton-block" style="width: 60px; height: 80px; border-radius: 8px"></div>
                    </div>
                    <div class="item-inner">
                      <div class="item-title-row"><div class="item-title">Loading series title</div></div>
                      <div class="item-subtitle">Manga</div>
                      <div class="item-text">This is a long description text for skeleton placeholder</div>
                    </div>
                  </div>
                </li>
              `)}
            </ul>
          </div>
        `
        : state.items.length
          ? $h`
            <div class="list media-list no-hairlines no-chevron animate-fade-in">
              <ul>
                ${state.items.map((item) => $h`
                  <li>
                    <a href="/content/${item.type}/${item.slug}/" class="item-link item-content nmr-card-hover">
                      <div class="item-media">
                        <img src="${item.cover}" width="60" style="border-radius: 10px" />
                      </div>
                      <div class="item-inner">
                        <div class="item-title-row">
                          <div class="item-title font-bold text-white">${item.title}</div>
                        </div>
                        <div class="item-subtitle text-xs text-slate-500 uppercase tracking-widest mt-1">${item.type}</div>
                        <div class="item-text text-xs text-slate-400 mt-2 line-clamp-2">Dive into this amazing story and explore new worlds.</div>
                      </div>
                    </a>
                  </li>
                `)}
              </ul>
            </div>`
          : state.query.length > 1
            ? $h`<div class="block text-center pt-12 text-slate-500">No results found for "${state.query}"</div>`
            : $h`
              <div class="block text-center pt-12 space-y-4">
                <i class="f7-icons size-64 text-slate-700">search</i>
                <div class="text-slate-500">Search for your favorite manga or novels</div>
              </div>
            `
      }
    </div>
  </div>
</template>
<script>
import $ from 'dom7';
import api from '../js/api.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $el }) => {
  const i18n = getI18n();
  const state = {
    loading: false,
    error: '',
    items: [],
    suggestions: [],
    query: '',
  };

  const normalizeCover = (value) => {
    if (typeof value !== 'string') return '/assets/img/covers/placeholder.svg';
    if (value === '') return '/assets/img/covers/placeholder.svg';
    if (value.startsWith('http://') || value.startsWith('https://')) return value;
    let normalized = value;
    while (normalized.startsWith('/')) normalized = normalized.slice(1);
    return `/${normalized}`;
  };

  const normalizeItem = (item) => ({
    title: item.title || 'Series',
    slug: item.slug || '',
    type: item.type || item.type_path || 'novel',
    cover: normalizeCover(item.cover_image || item.cover || item.thumbnail || item.image),
  });

  const runSearch = async (q) => {
    if (!q) return;
    state.loading = true;
    state.error = '';
    state.suggestions = [];
    state.query = q;
    $update();
    try {
      const payload = await api.content.search(q, 1, 20);
      const data = payload?.data || payload || [];
      state.items = (Array.isArray(data) ? data : []).map(normalizeItem).filter((row) => row.slug);
    } catch (err) {
      state.error = err.message || 'Search failed.';
    } finally {
      state.loading = false;
      $update();
    }
  };

  const runSuggest = async (q) => {
    try {
      const payload = await api.content.suggest(q);
      const data = payload?.data || payload || [];
      state.suggestions = (Array.isArray(data) ? data : []).slice(0, 5);
      $update();
    } catch (err) {
      state.suggestions = [];
    }
  };

  $onMounted(() => {
    const input = $($el).find('input[name="q"]')[0];
    if (!input) return;
    
    let timer = null;
    input.addEventListener('input', (event) => {
      const value = event.target.value || '';
      state.query = value;
      if (value.length < 2) {
        state.items = [];
        state.suggestions = [];
        state.error = '';
        $update();
        return;
      }
      
      clearTimeout(timer);
      timer = setTimeout(() => {
        runSuggest(value);
      }, 300);
    });

    input.addEventListener('search', (event) => {
      runSearch(event.target.value);
    });
  });

  return $render;
};
</script>
