<template>
  <div class="page nmr-page" data-name="sessions">
    <div class="navbar nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left"><a class="link back text-slate-200">Back</a></div>
        <div class="title nmr-title">Sessions</div>
      </div>
    </div>

    <div class="page-content px-5 pb-6 space-y-5">
      ${state.loading
        ? $h`<div class="nmr-panel">${i18n.loading || 'Loading...'}</div>`
        : state.error
          ? $h`<div class="nmr-panel text-red-200">${state.error}</div>`
          : state.items.length
            ? $h`<div class="space-y-3">
              ${state.items.map((item) => $h`
                <div class="nmr-card px-4 py-3 space-y-2">
                  <div class="text-sm text-slate-100">${item.user_agent}</div>
                  <div class="text-xs text-slate-400">${item.last_active}</div>
                  <button class="nmr-button nmr-button-ghost" data-action="revoke" data-key="${item.session_key}">Revoke</button>
                </div>
              `)}
            </div>`
            : $h`<div class="nmr-panel text-slate-300">No sessions.</div>`
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $f7, $el }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    items: [],
  };

  const normalize = (item) => ({
    session_key: item.session_key || item.sessionKey || '',
    user_agent: item.user_agent || item.userAgent || 'Session',
    last_active: item.last_active || item.updated_at || item.created_at || '',
  });

  const load = async () => {
    try {
      const payload = await api.sessions.list();
      const data = payload?.data || payload || [];
      state.items = (Array.isArray(data) ? data : []).map(normalize);
    } catch (err) {
      state.error = err.message || 'Failed to load sessions.';
    } finally {
      state.loading = false;
      $update();
    }
  };

  $onMounted(async () => {
    if (!store.state.auth.isLoggedIn) {
      state.loading = false;
      state.error = i18n.login_required || 'Login required.';
      $f7.popup.open('.login-popup');
      $update();
      return;
    }
    await load();
  });

  $onMounted(() => {
    $el.on('click', '[data-action="revoke"]', async (event) => {
      event.preventDefault();
      const key = event.target.getAttribute('data-key');
      if (!key) return;
      try {
        await api.sessions.revoke(key);
        await load();
      } catch (err) {
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Revoke failed' } }));
      }
    });
  });

  return $render;
};
</script>
