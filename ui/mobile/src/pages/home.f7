<template>
  <div class="page" data-name="home">
    <div class="navbar navbar-large">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="title">NMR Reader</div>
        <div class="right">
          <a class="link icon-only" href="/search/">
            <i class="f7-icons">search</i>
          </a>
          <a class="link icon-only sheet-open" data-sheet=".language-sheet" href="#">
            <i class="f7-icons">globe</i>
          </a>
        </div>
        <div class="title-large">
          <div class="title-large-text">NMR Reader</div>
        </div>
      </div>
    </div>

    <div class="page-content">
      <!-- Featured Swiper -->
      <div class="block-title">Featured Stories</div>
      <div class="swiper-container swiper-init" data-slides-per-view="auto" data-space-between="10" data-centered-slides="false">
        <div class="swiper-wrapper">
          ${state.recent.slice(0, 5).map((item) => $h`
            <div class="swiper-slide" style="width: 240px">
              <a href="/content/${item.type}/${item.slug}/" class="card card-outline no-margin">
                <div class="card-content">
                  <img src="${item.cover}" style="width: 100%; height: 320px; object-fit: cover; display: block;" />
                  <div class="card-footer font-bold">${item.title}</div>
                </div>
              </a>
            </div>
          `)}
        </div>
      </div>

      <!-- Content Type Tabs -->
      <div class="block">
        <div class="segmented segmented-strong">
          <a href="/types/manga/" class="button">Manga</a>
          <a href="/types/novel/" class="button">Novel</a>
          <a href="/types/manhwa/" class="button">Manhwa</a>
        </div>
      </div>

      <!-- Latest Updates -->
      <div class="list media-list no-chevron">
        <div class="block-title">Latest Updates</div>
        <ul>
          ${state.loading
            ? [1, 2, 3].map(() => $h`
              <li class="skeleton-text skeleton-effect-blink">
                <div class="item-content">
                  <div class="item-media"><div class="skeleton-block" style="width: 48px; height: 64px"></div></div>
                  <div class="item-inner"><div class="item-title">Loading title</div><div class="item-text">Loading info</div></div>
                </div>
              </li>
            `)
            : state.latest.map((item) => $h`
              <li>
                <a href="/reader/${item.type}/${item.slug}/${item.chapter_number}/" class="item-link item-content">
                  <div class="item-media">
                    <img src="${item.cover}" width="48" style="border-radius: 4px" />
                  </div>
                  <div class="item-inner">
                    <div class="item-title-row">
                      <div class="item-title">${item.title}</div>
                      <div class="item-after">
                        ${item.is_locked ? $h`<span class="badge color-orange">COIN</span>` : $h`<span class="badge color-green">FREE</span>`}
                      </div>
                    </div>
                    <div class="item-subtitle">Chapter ${item.chapter_number}</div>
                    <div class="item-text">${item.type}</div>
                  </div>
                </a>
              </li>
            `)}
        </ul>
      </div>

      <div class="fab fab-right-bottom color-blue">
        <a href="/search/">
          <i class="f7-icons">search</i>
        </a>
      </div>
    </div>
  </div>
</template>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $onBeforeUnmount }) => {
  const state = {
    loading: true,
    latest: [],
    recent: [],
    isLoggedIn: store.state.auth.isLoggedIn,
  };
  const i18n = getI18n();

  const normalizeCover = (value) => {
    if (!value) return '/assets/img/covers/placeholder.svg';
    if (value.startsWith('http://') || value.startsWith('https://')) return value;
    let normalized = value;
    while (normalized.startsWith('/')) {
      normalized = normalized.slice(1);
    }
    return `/${normalized}`;
  };

  const normalizeLatest = (item) => ({
    title: item.title || item.series_title || 'Chapter',
    slug: item.slug || item.series_slug || '',
    type: item.type || item.series_type || '',
    chapter_number: item.chapter_number || item.chapterNumber || item.number || '',
    price_coin: item.price_coin || item.access?.chapter_unlock_price || 0,
    is_locked: item.is_locked ?? !(item.access?.granted ?? true),
    cover: normalizeCover(item.cover_image || item.cover || item.thumbnail || item.image || item.series_cover || item.series_cover_image || item.series_thumbnail),
  });

  const normalizeSeries = (item) => ({
    title: item.title || 'Series',
    slug: item.slug || '',
    type: item.type || '',
    cover: normalizeCover(item.cover_image || item.cover || item.thumbnail || item.image || item.series_cover || item.series_cover_image || item.series_thumbnail),
  });

  const syncAuth = () => {
    state.isLoggedIn = store.state.auth.isLoggedIn;
    $update();
  };

  $onMounted(async () => {
    document.addEventListener('auth:updated', syncAuth);
    try {
      const payload = await api.content.getHome();
      const data = payload?.data || payload || {};
      const latest = data.recent_chapters || data.latest_chapters || [];
      const recent = data.recently_added || [];
      state.latest = latest.map(normalizeLatest).filter((row) => row.slug && row.type);
      state.recent = recent.map(normalizeSeries).filter((row) => row.slug && row.type);
    } catch (err) {
      state.latest = [];
      state.recent = [];
    } finally {
      state.loading = false;
      $update();
    }
  });

  $onBeforeUnmount(() => {
    document.removeEventListener('auth:updated', syncAuth);
  });

  return $render;
};
</script>
