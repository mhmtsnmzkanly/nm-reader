<template>
  <div class="page nmr-page" data-name="home">
    <div class="navbar navbar-large nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="title nmr-title">NMR Reader</div>
        <div class="right">
          <a class="link icon-only" href="/search/">
            <i class="f7-icons">search</i>
          </a>
          <a class="link icon-only sheet-open" data-sheet=".language-sheet" href="#">
            <i class="f7-icons">globe</i>
          </a>
        </div>
        <div class="title-large">
          <div class="title-large-text nmr-title">NMR Reader</div>
        </div>
      </div>
    </div>

    <div class="page-content">
      <!-- Featured Swiper (F7 Swiper Component) -->
      <div class="block-title nmr-section-title">Featured Stories</div>
      <div class="swiper-container swiper-init" data-slides-per-view="auto" data-space-between="20" data-centered-slides="true">
        <div class="swiper-wrapper">
          ${state.recent.slice(0, 5).map((item) => $h`
            <div class="swiper-slide" style="width: 280px">
              <a href="/content/${item.type}/${item.slug}/" class="nmr-card block no-margin">
                <div class="card-content">
                  <div class="card-content-inner p-0 relative">
                    <img src="${item.cover}" style="width: 100%; height: 380px; object-fit: cover; display: block;" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                    <div class="absolute bottom-4 left-4 right-4">
                      <div class="text-[10px] uppercase tracking-[2px] text-amber-200 font-bold mb-1">${item.type}</div>
                      <div class="text-xl font-bold text-white nmr-title">${item.title}</div>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          `)}
        </div>
      </div>

      <!-- Content Type Tabs (Segmented Control) -->
      <div class="block">
        <div class="segmented segmented-strong segmented-round">
          <a href="/types/manga/" class="button">Manga</a>
          <a href="/types/novel/" class="button">Novel</a>
          <a href="/types/manhwa/" class="button">Manhwa</a>
        </div>
      </div>

      <!-- Latest Updates (F7 Media List Component) -->
      <div class="list media-list no-chevron no-hairlines animate-fade-in">
        <div class="block-title nmr-section-title">Latest Updates</div>
        <ul>
          ${state.loading
            ? [1, 2, 3, 4].map(() => $h`
              <li class="skeleton-text skeleton-effect-blink">
                <div class="item-content">
                  <div class="item-media">
                    <div class="skeleton-block" style="width: 64px; height: 80px; border-radius: 8px"></div>
                  </div>
                  <div class="item-inner">
                    <div class="item-title-row">
                      <div class="item-title">Loading...</div>
                    </div>
                    <div class="item-subtitle">Subtitle</div>
                    <div class="item-text">Text line one and line two</div>
                  </div>
                </div>
              </li>
            `)
            : state.latest.map((item) => $h`
              <li>
                <a href="/reader/${item.type}/${item.slug}/${item.chapter_number}/" class="item-link item-content nmr-card-hover">
                  <div class="item-media">
                    <img src="${item.cover}" width="64" style="border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.3)" />
                  </div>
                  <div class="item-inner">
                    <div class="item-title-row">
                      <div class="item-title font-bold text-slate-100">${item.title}</div>
                      <div class="item-after">
                        ${item.is_locked 
                          ? $h`<span class="badge color-orange">${item.price_coin}</span>` 
                          : $h`<span class="badge color-green">FREE</span>`}
                      </div>
                    </div>
                    <div class="item-subtitle text-xs text-slate-400 mt-1 uppercase tracking-tight">Chapter ${item.chapter_number}</div>
                    <div class="item-text text-slate-500">${item.type} • Updated Today</div>
                  </div>
                </a>
              </li>
            `)}
        </ul>
      </div>

      <!-- Quick Action Floating Button (F7 FAB) -->
      <div class="fab fab-right-bottom color-purple">
        <a href="/search/">
          <i class="f7-icons">search</i>
        </a>
      </div>
    </div>
  </div>
</template>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $onBeforeUnmount }) => {
  const state = {
    loading: true,
    latest: [],
    recent: [],
    isLoggedIn: store.state.auth.isLoggedIn,
  };
  const i18n = getI18n();

  const normalizeCover = (value) => {
    if (!value) return '/assets/img/covers/placeholder.svg';
    if (value.startsWith('http://') || value.startsWith('https://')) return value;
    let normalized = value;
    while (normalized.startsWith('/')) {
      normalized = normalized.slice(1);
    }
    return `/${normalized}`;
  };

  const normalizeLatest = (item) => ({
    title: item.title || item.series_title || 'Chapter',
    slug: item.slug || item.series_slug || '',
    type: item.type || item.series_type || '',
    chapter_number: item.chapter_number || item.chapterNumber || item.number || '',
    price_coin: item.price_coin || item.access?.chapter_unlock_price || 0,
    is_locked: item.is_locked ?? !(item.access?.granted ?? true),
    cover: normalizeCover(item.cover_image || item.cover || item.thumbnail || item.image || item.series_cover || item.series_cover_image || item.series_thumbnail),
  });

  const normalizeSeries = (item) => ({
    title: item.title || 'Series',
    slug: item.slug || '',
    type: item.type || '',
    cover: normalizeCover(item.cover_image || item.cover || item.thumbnail || item.image || item.series_cover || item.series_cover_image || item.series_thumbnail),
  });

  const syncAuth = () => {
    state.isLoggedIn = store.state.auth.isLoggedIn;
    $update();
  };

  $onMounted(async () => {
    document.addEventListener('auth:updated', syncAuth);
    try {
      const payload = await api.content.getHome();
      const data = payload?.data || payload || {};
      const latest = data.recent_chapters || data.latest_chapters || [];
      const recent = data.recently_added || [];
      state.latest = latest.map(normalizeLatest).filter((row) => row.slug && row.type);
      state.recent = recent.map(normalizeSeries).filter((row) => row.slug && row.type);
    } catch (err) {
      state.latest = [];
      state.recent = [];
    } finally {
      state.loading = false;
      $update();
    }
  });

  $onBeforeUnmount(() => {
    document.removeEventListener('auth:updated', syncAuth);
  });

  return $render;
};
</script>
