<template>
  <div class="page nmr-page" data-name="home">
    <div class="navbar navbar-large nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="title nmr-title">NMR Mobile</div>
        <div class="title-large">
          <div class="title-large-text nmr-title">NMR Mobile</div>
        </div>
        <div class="right flex items-center gap-3">
          ${state.isLoggedIn
            ? $h`<a class="text-sm text-slate-200" data-action="logout" href="#">${i18n.logout || 'Logout'}</a>`
            : $h`<a class="text-sm text-slate-200 popup-open" data-popup=".login-popup" href="#">${i18n.login || 'Login'}</a>`
          }
          <a class="text-sm text-slate-200 sheet-open" data-sheet=".language-sheet" href="#">${i18n.language || 'Language'}</a>
          <a class="text-sm text-slate-200" href="/wallet/">${i18n.wallet || 'Wallet'}</a>
        </div>
      </div>
    </div>

    <div class="page-content px-5 pb-6 space-y-6">
      <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/5 shadow-[0_20px_50px_rgba(0,0,0,0.45)]">
        <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/30 to-transparent"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_20%,rgba(139,92,246,0.35),transparent_55%)]"></div>
        <div class="absolute inset-0 opacity-60" style="background-image:url('/assets/img/covers/placeholder.svg');background-size:cover;background-position:center;"></div>
        <div class="relative z-10 p-7 space-y-4">
          <div class="text-xs uppercase tracking-[1.4px] text-amber-200/80">Premium</div>
          <div class="text-3xl font-semibold text-slate-100 leading-tight">Story Library</div>
          <div class="text-sm text-slate-300 leading-6">Curated new chapters and cinematic reading.</div>
          <div class="flex gap-3 pt-1">
            <a class="nmr-button nmr-button-primary" href="/types/manga/">Explore</a>
            <a class="nmr-button nmr-button-ghost" href="/wallet/">Wallet</a>
          </div>
        </div>
      </div>
      <div class="flex gap-3">
        <a class="nmr-button nmr-button-ghost" href="/types/manga/">Manga</a>
        <a class="nmr-button nmr-button-ghost" href="/types/novel/">Novel</a>
        <a class="nmr-button nmr-button-ghost" href="/types/manhwa/">Manhwa</a>
        <a class="nmr-button nmr-button-ghost" href="/search/">Search</a>
        <a class="nmr-button nmr-button-ghost" href="/profile/">Profile</a>
        <a class="nmr-button nmr-button-ghost" href="/blogs/">Blogs</a>
      </div>

      <div class="space-y-4">
        <div class="nmr-section-title">Featured</div>
        <div class="flex gap-4 overflow-x-auto pb-2">
          ${state.recent.slice(0, 6).map((item) => $h`
            <a class="min-w-[180px] rounded-2xl overflow-hidden border border-white/10 bg-white/5 shadow-[0_18px_40px_rgba(0,0,0,0.45)]" href="/content/${item.type}/${item.slug}/">
              <div class="h-28 w-full" style="background-image:url('${item.cover}');background-size:cover;background-position:center;"></div>
              <div class="p-4 space-y-1">
                <div class="text-sm font-semibold text-slate-100">${item.title}</div>
                <div class="text-xs text-slate-400">${item.type}</div>
              </div>
            </a>
          `)}
        </div>
      </div>

      <div class="space-y-5">
        <div class="nmr-section-title">${i18n.latest_chapters || 'Latest Chapters'}</div>
        ${state.loading
          ? $h`<div class="nmr-panel">${i18n.loading || 'Loading...'}</div>`
          : state.latest.length > 0
            ? $h`<div class="space-y-4">
                ${state.latest.map((item) => $h`
                  <a class="nmr-card nmr-card-hover block px-4 py-3" href="/reader/${item.type}/${item.slug}/${item.chapter_number}/">
                    <div class="flex items-start gap-4">
                      <div class="w-14 h-16 rounded-xl bg-white/10 border border-white/10 overflow-hidden shrink-0" style="background-image:url('${item.cover}');background-size:cover;background-position:center;"></div>
                      <div class="flex-1">
                        <div class="flex items-start justify-between gap-3">
                          <div>
                            <div class="font-semibold text-slate-100">${item.title}</div>
                            <div class="text-xs text-slate-400 mt-1">${item.type}</div>
                          </div>
                          <div class="text-xs text-slate-300">#${item.chapter_number}</div>
                        </div>
                        <div class="mt-3">
                          ${item.is_locked
                            ? $h`<span class="nmr-chip nmr-chip--price">${item.price_coin} ${i18n.coins || 'coins'}</span>`
                            : $h`<span class="nmr-chip nmr-chip--free">${i18n.free || 'Free'}</span>`
                          }
                        </div>
                      </div>
                    </div>
                  </a>
                `)}
              </div>` 
            : $h`<div class="nmr-panel">${i18n.no_chapters || 'No chapters yet.'}</div>`
        }
      </div>

      <div class="space-y-5">
        <div class="nmr-section-title">${i18n.recently_added || 'Recently Added'}</div>
        ${state.loading
          ? $h`<div class="nmr-panel">${i18n.loading || 'Loading...'}</div>`
          : state.recent.length > 0
            ? $h`<div class="space-y-4">
                ${state.recent.map((item) => $h`
                  <a class="nmr-card nmr-card-hover block px-4 py-3" href="/content/${item.type}/${item.slug}/">
                    <div class="flex items-center gap-4">
                      <div class="w-14 h-16 rounded-xl bg-white/10 border border-white/10 overflow-hidden shrink-0" style="background-image:url('${item.cover}');background-size:cover;background-position:center;"></div>
                      <div class="flex-1 flex items-center justify-between">
                        <div class="font-semibold text-slate-100">${item.title}</div>
                        <div class="text-xs text-slate-400">${item.type}</div>
                      </div>
                    </div>
                  </a>
                `)}
              </div>` 
            : $h`<div class="nmr-panel">${i18n.no_recent || 'No recent series.'}</div>`
        }
      </div>
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $onBeforeUnmount }) => {
  const state = {
    loading: true,
    latest: [],
    recent: [],
    isLoggedIn: store.state.auth.isLoggedIn,
  };
  const i18n = getI18n();

  const normalizeCover = (value) => {
    if (!value) return '/assets/img/covers/placeholder.svg';
    if (value.startsWith('http://') || value.startsWith('https://')) return value;
    let normalized = value;
    while (normalized.startsWith('/')) {
      normalized = normalized.slice(1);
    }
    return `/${normalized}`;
  };

  const normalizeLatest = (item) => ({
    title: item.title || item.series_title || 'Chapter',
    slug: item.slug || item.series_slug || '',
    type: item.type || item.series_type || '',
    chapter_number: item.chapter_number || item.chapterNumber || item.number || '',
    price_coin: item.price_coin || item.access?.chapter_unlock_price || 0,
    is_locked: item.is_locked ?? !(item.access?.granted ?? true),
    cover: normalizeCover(item.cover_image || item.cover || item.thumbnail || item.image || item.series_cover || item.series_cover_image || item.series_thumbnail),
  });

  const normalizeSeries = (item) => ({
    title: item.title || 'Series',
    slug: item.slug || '',
    type: item.type || '',
    cover: normalizeCover(item.cover_image || item.cover || item.thumbnail || item.image || item.series_cover || item.series_cover_image || item.series_thumbnail),
  });

  const syncAuth = () => {
    state.isLoggedIn = store.state.auth.isLoggedIn;
    $update();
  };

  $onMounted(async () => {
    document.addEventListener('auth:updated', syncAuth);
    try {
      const payload = await api.content.getHome();
      const data = payload?.data || payload || {};
      const latest = data.recent_chapters || data.latest_chapters || [];
      const recent = data.recently_added || [];
      state.latest = latest.map(normalizeLatest).filter((row) => row.slug && row.type);
      state.recent = recent.map(normalizeSeries).filter((row) => row.slug && row.type);
    } catch (err) {
      state.latest = [];
      state.recent = [];
    } finally {
      state.loading = false;
      $update();
    }
  });

  $onBeforeUnmount(() => {
    document.removeEventListener('auth:updated', syncAuth);
  });

  return $render;
};
</script>
