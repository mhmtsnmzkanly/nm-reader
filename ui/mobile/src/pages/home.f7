<template>
  <div class="page" data-name="home">
    <div class="navbar navbar-large">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="title">NMR Mobile</div>
        <div class="title-large">
          <div class="title-large-text">NMR Mobile</div>
        </div>
        <div class="right">
          ${state.isLoggedIn
            ? $h`<a class="link" data-action="logout" href="#">${i18n.logout || 'Logout'}</a>`
            : $h`<a class="link popup-open" data-popup=".login-popup" href="#">${i18n.login || 'Login'}</a>`
          }
          <a class="link sheet-open" data-sheet=".language-sheet" href="#">${i18n.language || 'Language'}</a>
          <a class="link" href="/wallet/">${i18n.wallet || 'Wallet'}</a>
        </div>
      </div>
    </div>

    <div class="page-content">
      <div class="block">
        <div class="segmented">
          <a class="button button-small" href="/types/manga/">Manga</a>
          <a class="button button-small" href="/types/novel/">Novel</a>
          <a class="button button-small" href="/types/manhwa/">Manhwa</a>
        </div>
      </div>

      <div class="block-title">${i18n.latest_chapters || 'Latest Chapters'}</div>
      ${state.loading
        ? $h`<div class="block">${i18n.loading || 'Loading...'}</div>`
        : state.latest.length
          ? $h`<div class="list media-list">
            <ul>
              ${state.latest.map((item) => $h`
                <li>
                  <a class="item-link item-content" href="/reader/${item.type}/${item.slug}/${item.chapter_number}/">
                    <div class="item-inner">
                      <div class="item-title-row">
                        <div class="item-title">${item.title}</div>
                        <div class="item-after">#${item.chapter_number}</div>
                      </div>
                      <div class="item-subtitle">
                        ${item.type}
                        ${item.is_locked
                          ? $h` · <span class="badge badge--price">${item.price_coin} ${i18n.coins || 'coins'}</span>`
                          : $h` · <span class="badge badge--free">${i18n.free || 'Free'}</span>`
                        }
                      </div>
                    </div>
                  </a>
                </li>
              `)}
            </ul>
          </div>`
          : $h`<div class="block empty-state">${i18n.no_chapters || 'No chapters yet.'}</div>`
      }

      <div class="block-title">${i18n.recently_added || 'Recently Added'}</div>
      ${state.loading
        ? $h`<div class="block">${i18n.loading || 'Loading...'}</div>`
        : state.recent.length
          ? $h`<div class="list">
            <ul>
              ${state.recent.map((item) => $h`
                <li>
                  <a class="item-link item-content" href="/content/${item.type}/${item.slug}/">
                    <div class="item-inner">
                      <div class="item-title">${item.title}</div>
                      <div class="item-after">${item.type}</div>
                    </div>
                  </a>
                </li>
              `)}
            </ul>
          </div>`
          : $h`<div class="block empty-state">${i18n.no_recent || 'No recent series.'}</div>`
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $onBeforeUnmount }) => {
  const state = {
    loading: true,
    latest: [],
    recent: [],
    isLoggedIn: store.state.auth.isLoggedIn,
  };
  const i18n = getI18n();

  const normalizeLatest = (item) => ({
    title: item.title || item.series_title || 'Chapter',
    slug: item.slug || item.series_slug || '',
    type: item.type || item.series_type || '',
    chapter_number: item.chapter_number || item.chapterNumber || item.number || '',
    price_coin: item.price_coin || item.access?.chapter_unlock_price || 0,
    is_locked: item.is_locked ?? !(item.access?.granted ?? true),
  });

  const normalizeSeries = (item) => ({
    title: item.title || 'Series',
    slug: item.slug || '',
    type: item.type || '',
  });

  const syncAuth = () => {
    state.isLoggedIn = store.state.auth.isLoggedIn;
    $update();
  };

  $onMounted(async () => {
    document.addEventListener('auth:updated', syncAuth);
    try {
      const payload = await api.content.getHome();
      const data = payload?.data || payload || {};
      const latest = data.recent_chapters || data.latest_chapters || [];
      const recent = data.recently_added || [];
      state.latest = latest.map(normalizeLatest).filter((row) => row.slug && row.type);
      state.recent = recent.map(normalizeSeries).filter((row) => row.slug && row.type);
    } catch (err) {
      state.latest = [];
      state.recent = [];
    } finally {
      state.loading = false;
      $update();
    }
  });

  $onBeforeUnmount(() => {
    document.removeEventListener('auth:updated', syncAuth);
  });

  return $render;
};
</script>
