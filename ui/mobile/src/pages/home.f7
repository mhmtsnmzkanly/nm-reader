<template>
  <div class="page" data-name="home">
    <div class="navbar navbar-large">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="title">NMR Mobile</div>
        <div class="title-large">
          <div class="title-large-text">NMR Mobile</div>
        </div>
        <div class="right">
          {{#if state.isLoggedIn}}
            <a class="link" data-action="logout" href="#">Logout</a>
          {{else}}
            <a class="link popup-open" data-popup=".login-popup" href="#">{{@global.i18n.login}}</a>
          {{/if}}
          <a class="link sheet-open" data-sheet=".language-sheet" href="#">{{@global.i18n.language}}</a>
          <a class="link" href="/wallet/">{{@global.i18n.wallet}}</a>
        </div>
      </div>
    </div>

    <div class="page-content">
      <div class="block">
        <div class="segmented">
          <a class="button button-small" href="/types/manga/">Manga</a>
          <a class="button button-small" href="/types/novel/">Novel</a>
          <a class="button button-small" href="/types/manhwa/">Manhwa</a>
        </div>
      </div>

      <div class="block-title">{{@global.i18n.latest_chapters}}</div>
      {{#if state.loading}}
        <div class="block">{{@global.i18n.loading}}</div>
      {{else}}
        {{#if state.latest.length}}
          <div class="list media-list">
            <ul>
              {{#each state.latest}}
                <li>
                  <a class="item-link item-content" href="/reader/{{type}}/{{slug}}/{{chapter_number}}/">
                    <div class="item-inner">
                      <div class="item-title-row">
                        <div class="item-title">{{title}}</div>
                        <div class="item-after">#{{chapter_number}}</div>
                      </div>
                      <div class="item-subtitle">
                        {{type}}
                        {{#if is_locked}}
                          · <span class="badge badge--price">{{price_coin}} {{@global.i18n.coins}}</span>
                        {{else}}
                          · <span class="badge badge--free">{{@global.i18n.free}}</span>
                        {{/if}}
                      </div>
                    </div>
                  </a>
                </li>
              {{/each}}
            </ul>
          </div>
        {{else}}
          <div class="block empty-state">{{@global.i18n.no_chapters}}</div>
        {{/if}}
      {{/if}}

      <div class="block-title">{{@global.i18n.recently_added}}</div>
      {{#if state.loading}}
        <div class="block">{{@global.i18n.loading}}</div>
      {{else}}
        {{#if state.recent.length}}
          <div class="list">
            <ul>
              {{#each state.recent}}
                <li>
                  <a class="item-link item-content" href="/content/{{type}}/{{slug}}/">
                    <div class="item-inner">
                      <div class="item-title">{{title}}</div>
                      <div class="item-after">{{type}}</div>
                    </div>
                  </a>
                </li>
              {{/each}}
            </ul>
          </div>
        {{else}}
          <div class="block empty-state">{{@global.i18n.no_recent}}</div>
        {{/if}}
      {{/if}}
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';

export default (props, { $onMounted, $update, $onBeforeUnmount }) => {
  const state = {
    loading: true,
    latest: [],
    recent: [],
    isLoggedIn: store.state.auth.isLoggedIn,
  };

  const normalizeLatest = (item) => ({
    title: item.title || item.series_title || 'Chapter',
    slug: item.slug || item.series_slug || '',
    type: item.type || item.series_type || '',
    chapter_number: item.chapter_number || item.chapterNumber || item.number || '',
    price_coin: item.price_coin || item.access?.chapter_unlock_price || 0,
    is_locked: item.is_locked ?? !(item.access?.granted ?? true),
  });

  const normalizeSeries = (item) => ({
    title: item.title || 'Series',
    slug: item.slug || '',
    type: item.type || '',
  });

  const syncAuth = () => {
    state.isLoggedIn = store.state.auth.isLoggedIn;
    $update();
  };

  $onMounted(async () => {
    document.addEventListener('auth:updated', syncAuth);
    try {
      const payload = await api.content.getHome();
      const data = payload?.data || payload || {};
      const latest = data.recent_chapters || data.latest_chapters || [];
      const recent = data.recently_added || [];
      state.latest = latest.map(normalizeLatest).filter((row) => row.slug && row.type);
      state.recent = recent.map(normalizeSeries).filter((row) => row.slug && row.type);
    } catch (err) {
      state.latest = [];
      state.recent = [];
    } finally {
      state.loading = false;
      $update();
    }
  });

  $onBeforeUnmount(() => {
    document.removeEventListener('auth:updated', syncAuth);
  });

  return $render;
};
</script>
