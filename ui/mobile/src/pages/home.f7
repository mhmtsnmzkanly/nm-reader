<template>
  <div class="page" data-name="home">
    ${renderAppHeader($h, { title: 'Home', subtitle: 'Discover novels and manga', large: true })}
    <div class="page-content">
      ${state.loading ? renderLoadingBlock($h, 'Loading discovery feed...') : ''}
      ${state.error ? renderErrorState($h, { title: 'Home feed failed', message: state.error }) : ''}

      ${!state.loading && !state.error ? $h`
        <div class="block block-strong mobile-hero-block">
          <div class="mobile-hero-block__title">Continue exploring</div>
          <div class="mobile-hero-block__actions">
            <a href="/types/manga/" class="button button-fill">Manga</a>
            <a href="/types/novel/" class="button button-outline">Novel</a>
          </div>
        </div>

        <div class="block-title">Featured</div>
        ${state.explore.length
          ? state.explore.map((item) => renderContentCard($h, item))
          : renderEmptyState($h, { title: 'No featured content', message: 'Featured stories will appear here.' })}

        <div class="block-title">Latest chapters</div>
        ${state.latest.length ? $h`
          <div class="list media-list inset no-chevron">
            <ul>
              ${state.latest.map((chapter) => $h`
                <li>
                  <a href="/reader/${chapter.type}/${chapter.slug}/${chapter.number}/" class="item-link item-content">
                    <div class="item-inner">
                      <div class="item-title-row">
                        <div class="item-title">${chapter.title}</div>
                        <div class="item-after">${chapter.isLocked ? 'Locked' : 'Open'}</div>
                      </div>
                      <div class="item-subtitle">${chapter.type} • Chapter ${chapter.number}</div>
                    </div>
                  </a>
                </li>
              `)}
            </ul>
          </div>
        ` : renderEmptyState($h, { title: 'No recent chapters', message: 'Recent updates will appear here.' })}
      ` : ''}
    </div>
    ${renderBottomNav($h, 'home')}
  </div>
</template>
<script>
import { fetchHome } from '../services/content/content-service.js';
import { renderAppHeader } from '../components/app-header.js';
import { renderBottomNav } from '../components/bottom-nav.js';
import { renderContentCard } from '../components/content-card.js';
import { renderLoadingBlock } from '../components/loading-block.js';
import { renderErrorState } from '../components/error-state.js';
import { renderEmptyState } from '../components/empty-state.js';
import { debugError, debugTrace } from '../utils/debug.js';
import { resolveComponentElement } from '../utils/dom.js';

export default (props, { $onMounted, $onBeforeUnmount, $update, $el }) => {
  const rootEl = () => resolveComponentElement($el);
  const state = {
    loading: true,
    error: '',
    explore: [],
    latest: [],
  };

  /**
   * Loads the home dashboard payload.
   */
  async function loadPage() {
    debugTrace({
      scope: 'route',
      action: 'home:loadPage:start',
      caller: 'ui/mobile/src/pages/home.f7#loadPage',
      callee: 'fetchHome',
      next: 'render discovery sections',
    });

    state.loading = true;
    state.error = '';
    $update();

    try {
      const payload = await fetchHome();
      state.explore = payload.explore;
      state.latest = payload.latestChapters.map((chapter) => ({
        ...chapter,
        type: chapter.type || 'content',
        slug: chapter.slug || '',
        title: chapter.title || `Chapter ${chapter.number}`,
      }));
      debugTrace({
        scope: 'route',
        action: 'home:loadPage:success',
        caller: 'home loadPage',
        callee: 'home state',
        next: 'render featured and latest sections',
        detail: {
          exploreCount: state.explore.length,
          latestCount: state.latest.length,
        },
      });
    } catch (error) {
      debugError({
        scope: 'route',
        action: 'home:loadPage:error',
        caller: 'home loadPage',
        callee: 'fetchHome',
        next: 'render retryable home error state',
        error,
      });
      state.error = error.message || 'Unable to load discovery feed.';
    } finally {
      state.loading = false;
      $update();
    }
  }

  /**
   * Handles local retry actions from the shared error state.
   */
  function handleClick(event) {
    if (event.target.closest('[data-action="retry-page"]')) {
      debugTrace({
        scope: 'route',
        action: 'home:retry',
        caller: 'home click handler',
        callee: 'loadPage',
        next: 'retry home dashboard request',
      });
      loadPage();
    }
  }

  $onMounted(() => {
    debugTrace({
      scope: 'route',
      action: 'home:mounted',
      caller: 'home page lifecycle',
      callee: 'loadPage',
      next: 'fetch discovery dashboard',
    });
    rootEl()?.addEventListener('click', handleClick);
    loadPage();
  });

  $onBeforeUnmount(() => {
    rootEl()?.removeEventListener('click', handleClick);
  });

  return $render;
};
</script>
