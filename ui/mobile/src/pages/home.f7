<template>
  <div class="page nmr-page" data-name="home">
    <div class="navbar navbar-large nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="title nmr-title">NMR Mobile</div>
        <div class="title-large">
          <div class="title-large-text nmr-title">NMR Mobile</div>
        </div>
        <div class="right flex items-center gap-3">
          ${state.isLoggedIn
            ? $h`<a class="text-sm text-slate-200" data-action="logout" href="#">${i18n.logout || 'Logout'}</a>`
            : $h`<a class="text-sm text-slate-200 popup-open" data-popup=".login-popup" href="#">${i18n.login || 'Login'}</a>`
          }
          <a class="text-sm text-slate-200 sheet-open" data-sheet=".language-sheet" href="#">${i18n.language || 'Language'}</a>
          <a class="text-sm text-slate-200" href="/wallet/">${i18n.wallet || 'Wallet'}</a>
        </div>
      </div>
    </div>

    <div class="page-content px-5 pb-6 space-y-8">
      <!-- Hero Section -->
      <div class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-[#0a0a0f] shadow-[0_30px_60px_rgba(0,0,0,0.6)]">
        <div class="absolute -top-24 -right-24 w-64 h-64 bg-purple-600/20 blur-[80px] rounded-full"></div>
        <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-cyan-600/10 blur-[80px] rounded-full"></div>
        
        <div class="relative z-10 p-8 space-y-5">
          <div class="flex items-center gap-2">
            <span class="w-8 h-[1px] bg-amber-200/50"></span>
            <div class="text-[10px] uppercase tracking-[3px] text-amber-200/80 font-bold">Featured Stories</div>
          </div>
          <div class="space-y-2">
            <div class="text-4xl nmr-title text-slate-100 leading-[1.1]">Infinite<br/><i class="font-medium opacity-80">Reading.</i></div>
            <p class="text-sm text-slate-400 leading-relaxed max-w-[220px]">Immerse yourself in curated worlds and cinematic storytelling.</p>
          </div>
          <div class="flex gap-3 pt-2">
            <a class="nmr-button nmr-button-primary" href="/types/manga/">Explore Now</a>
            <a class="nmr-button nmr-button-ghost px-5" href="/search/">
              <i class="f7-icons text-lg">search</i>
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Nav -->
      <div class="flex gap-3 overflow-x-auto no-scrollbar pb-2">
        <a class="nmr-button nmr-button-ghost whitespace-nowrap" href="/types/manga/">Manga</a>
        <a class="nmr-button nmr-button-ghost whitespace-nowrap" href="/types/novel/">Novel</a>
        <a class="nmr-button nmr-button-ghost whitespace-nowrap" href="/types/manhwa/">Manhwa</a>
        <a class="nmr-button nmr-button-ghost whitespace-nowrap" href="/blogs/">Community</a>
      </div>

      <!-- Featured Horizontal -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <div class="nmr-section-title mb-0">Featured</div>
          <a href="/types/manga/" class="text-xs text-purple-400 font-semibold">View All</a>
        </div>
        <div class="flex gap-5 overflow-x-auto no-scrollbar pb-4 -mx-5 px-5">
          ${state.recent.slice(0, 6).map((item) => $h`
            <a class="min-w-[160px] max-w-[160px] group block" href="/content/${item.type}/${item.slug}/">
              <div class="nmr-card aspect-[3/4] mb-3 relative">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-active:scale-110" style="background-image:url('${item.cover}');"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
                <div class="absolute bottom-3 left-3">
                   <span class="nmr-chip text-[9px] px-2 py-1">${item.type}</span>
                </div>
              </div>
              <div class="space-y-1 px-1">
                <div class="text-sm font-bold text-slate-100 line-clamp-1 truncate">${item.title}</div>
                <div class="text-[10px] text-slate-500 font-medium uppercase tracking-wider">Updated Recently</div>
              </div>
            </a>
          `)}
        </div>
      </div>

      <!-- Latest Chapters -->
      <div class="space-y-5">
        <div class="nmr-section-title">Latest Updates</div>
        ${state.loading
          ? $h`
            <div class="space-y-4">
              ${[1, 2, 3].map((i) => $h`
                <div class="nmr-skeleton-card p-3 flex items-center gap-4">
                  <div class="w-16 h-20 rounded-xl skeleton-block"></div>
                  <div class="flex-1 space-y-2">
                    <div class="h-4 w-3/4 skeleton-text"></div>
                    <div class="h-3 w-1/2 skeleton-text"></div>
                  </div>
                </div>
              `)}
            </div>
          `
          : state.latest.length > 0
            ? $h`<div class="space-y-4">
                ${state.latest.map((item, index) => $h`
                  <a class="nmr-card nmr-card-hover block p-3 animate-fade-in delay-${(index % 5) + 1}" href="/reader/${item.type}/${item.slug}/${item.chapter_number}/">
                    <div class="flex items-center gap-4">
                      <div class="w-16 h-20 rounded-xl bg-slate-800 shrink-0 shadow-lg overflow-hidden">
                        <img src="${item.cover}" class="w-full h-full object-cover" loading="lazy" />
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-start justify-between gap-2 mb-2">
                          <div class="font-bold text-slate-100 truncate text-sm">${item.title}</div>
                          <div class="text-[10px] font-black text-purple-400 bg-purple-400/10 px-1.5 py-0.5 rounded">CH.${item.chapter_number}</div>
                        </div>
                        <div class="flex items-center justify-between">
                          <span class="text-[10px] text-slate-500 font-semibold uppercase tracking-tight">${item.type}</span>
                          ${item.is_locked
                            ? $h`<span class="nmr-chip nmr-chip--price">${item.price_coin} <i class="f7-icons text-[10px] ml-1">money_dollar</i></span>`
                            : $h`<span class="nmr-chip nmr-chip--free">FREE</span>`
                          }
                        </div>
                      </div>
                    </div>
                  </a>
                `)}
              </div>` 
            : $h`<div class="nmr-panel">${i18n.no_chapters || 'No chapters yet.'}</div>`
        }
      </div>
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $onBeforeUnmount }) => {
  const state = {
    loading: true,
    latest: [],
    recent: [],
    isLoggedIn: store.state.auth.isLoggedIn,
  };
  const i18n = getI18n();

  const normalizeCover = (value) => {
    if (!value) return '/assets/img/covers/placeholder.svg';
    if (value.startsWith('http://') || value.startsWith('https://')) return value;
    let normalized = value;
    while (normalized.startsWith('/')) {
      normalized = normalized.slice(1);
    }
    return `/${normalized}`;
  };

  const normalizeLatest = (item) => ({
    title: item.title || item.series_title || 'Chapter',
    slug: item.slug || item.series_slug || '',
    type: item.type || item.series_type || '',
    chapter_number: item.chapter_number || item.chapterNumber || item.number || '',
    price_coin: item.price_coin || item.access?.chapter_unlock_price || 0,
    is_locked: item.is_locked ?? !(item.access?.granted ?? true),
    cover: normalizeCover(item.cover_image || item.cover || item.thumbnail || item.image || item.series_cover || item.series_cover_image || item.series_thumbnail),
  });

  const normalizeSeries = (item) => ({
    title: item.title || 'Series',
    slug: item.slug || '',
    type: item.type || '',
    cover: normalizeCover(item.cover_image || item.cover || item.thumbnail || item.image || item.series_cover || item.series_cover_image || item.series_thumbnail),
  });

  const syncAuth = () => {
    state.isLoggedIn = store.state.auth.isLoggedIn;
    $update();
  };

  $onMounted(async () => {
    document.addEventListener('auth:updated', syncAuth);
    try {
      const payload = await api.content.getHome();
      const data = payload?.data || payload || {};
      const latest = data.recent_chapters || data.latest_chapters || [];
      const recent = data.recently_added || [];
      state.latest = latest.map(normalizeLatest).filter((row) => row.slug && row.type);
      state.recent = recent.map(normalizeSeries).filter((row) => row.slug && row.type);
    } catch (err) {
      state.latest = [];
      state.recent = [];
    } finally {
      state.loading = false;
      $update();
    }
  });

  $onBeforeUnmount(() => {
    document.removeEventListener('auth:updated', syncAuth);
  });

  return $render;
};
</script>
