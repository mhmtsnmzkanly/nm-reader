<template>
  <div class="page nmr-page" data-name="wallet-transactions">
    <div class="navbar nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left"><a class="link back text-slate-200">Back</a></div>
        <div class="title nmr-title">${i18n.transactions || 'Transactions'}</div>
      </div>
    </div>

    <div class="page-content px-5 pb-6 space-y-5">
      ${state.loading
        ? $h`<div class="nmr-panel">${i18n.loading || 'Loading...'}</div>`
        : state.error
          ? $h`<div class="nmr-panel text-red-200">${state.error}</div>`
          : $h`
            <div class="space-y-4">
              ${state.items.map((item) => $h`
                <div class="nmr-card px-4 py-3">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <div class="font-semibold text-slate-100">${item.description}</div>
                      ${item.created_at ? $h`<div class="text-xs text-slate-400 mt-1">${item.created_at}</div>` : ''}
                    </div>
                    <div class="text-sm text-amber-200">${item.amount}</div>
                  </div>
                </div>
              `)}
            </div>
            ${state.hasMore
              ? $h`<div>
                <button class="nmr-button nmr-button-ghost w-full" data-action="load-more" ${state.loadingMore ? 'disabled' : ''}>${i18n.load_more || 'Load more'}</button>
              </div>`
              : ''
            }
          `
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $f7, $el }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    items: [],
    page: 1,
    perPage: 20,
    hasMore: false,
    loadingMore: false,
  };

  const formatDate = (value) => {
    if (!value) return '';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return value;
    return date.toLocaleString();
  };

  const normalize = (item) => ({
    description: item.description || item.reference_type || 'Transaction',
    amount: item.amount ? `${item.amount}` : `${item.coin_amount || 0}`,
    created_at: formatDate(item.created_at || item.createdAt || ''),
  });

  const fetchPage = async (page) => {
    const payload = await api.wallet.getTransactions(page, state.perPage);
    const data = payload?.data || payload || [];
    return Array.isArray(data) ? data : [];
  };

  $onMounted(async () => {
    if (!store.state.auth.isLoggedIn) {
      state.loading = false;
      state.error = i18n.login_required || 'Login required.';
      $f7.popup.open('.login-popup');
      $update();
      return;
    }
    try {
      const data = await fetchPage(state.page);
      state.items = data.map(normalize);
      state.hasMore = data.length === state.perPage;
    } catch (err) {
      state.error = err.message || i18n.failed_load_transactions || 'Failed to load transactions.';
      document.dispatchEvent(new CustomEvent('page:error', { detail: { message: state.error } }));
    } finally {
      state.loading = false;
      $update();
    }

    $el.on('click', '[data-action="load-more"]', async (event) => {
      event.preventDefault();
      if (state.loadingMore || !state.hasMore) return;
      state.loadingMore = true;
      try {
        const nextPage = state.page + 1;
        const data = await fetchPage(nextPage);
        state.items = state.items.concat(data.map(normalize));
        state.page = nextPage;
        state.hasMore = data.length === state.perPage;
      } catch (err) {
        state.error = err.message || i18n.failed_load_transactions || 'Failed to load transactions.';
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: state.error } }));
      } finally {
        state.loadingMore = false;
        $update();
      }
    });
  });

  return $render;
};
</script>
