<template>
  <div class="page" data-name="wallet-transactions">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left"><a class="link back">Back</a></div>
        <div class="title">{{@global.i18n.transactions}}</div>
      </div>
    </div>

    <div class="page-content">
      {{#if state.loading}}
        <div class="block">{{@global.i18n.loading}}</div>
      {{else}}
        {{#if state.error}}
          <div class="block error-state">{{state.error}}</div>
        {{else}}
          <div class="list">
            <ul>
              {{#each state.items}}
                <li>
                  <div class="item-content">
                    <div class="item-inner">
                      <div class="item-title">{{description}}</div>
                      <div class="item-after">{{amount}}</div>
                      {{#if created_at}}
                        <div class="item-subtitle">{{created_at}}</div>
                      {{/if}}
                    </div>
                  </div>
                </li>
              {{/each}}
            </ul>
          </div>
          {{#if state.hasMore}}
            <div class="block">
              <button class="button button-outline" data-action="load-more" {{#if state.loadingMore}}disabled{{/if}}>{{@global.i18n.load_more}}</button>
            </div>
          {{/if}}
        {{/if}}
      {{/if}}
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';
import { Template7 } from 'framework7';

export default (props, { $onMounted, $update, $f7, $el }) => {
  const state = {
    loading: true,
    error: '',
    items: [],
    page: 1,
    perPage: 20,
    hasMore: false,
    loadingMore: false,
  };

  const formatDate = (value) => {
    if (!value) return '';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return value;
    return date.toLocaleString();
  };

  const normalize = (item) => ({
    description: item.description || item.reference_type || 'Transaction',
    amount: item.amount ? `${item.amount}` : `${item.coin_amount || 0}`,
    created_at: formatDate(item.created_at || item.createdAt || ''),
  });

  const fetchPage = async (page) => {
    const payload = await api.wallet.getTransactions(page, state.perPage);
    const data = payload?.data || payload || [];
    return Array.isArray(data) ? data : [];
  };

  $onMounted(async () => {
    if (!store.state.auth.isLoggedIn) {
      const i18n = Template7.global?.i18n || {};
      state.loading = false;
      state.error = i18n.login_required || 'Login required.';
      $f7.popup.open('.login-popup');
      $update();
      return;
    }
    try {
      const data = await fetchPage(state.page);
      state.items = data.map(normalize);
      state.hasMore = data.length === state.perPage;
    } catch (err) {
      const i18n = Template7.global?.i18n || {};
      state.error = err.message || i18n.failed_load_transactions || 'Failed to load transactions.';
      document.dispatchEvent(new CustomEvent('page:error', { detail: { message: state.error } }));
    } finally {
      state.loading = false;
      $update();
    }

    $el.on('click', '[data-action="load-more"]', async (event) => {
      event.preventDefault();
      if (state.loadingMore || !state.hasMore) return;
      state.loadingMore = true;
      try {
        const nextPage = state.page + 1;
        const data = await fetchPage(nextPage);
        state.items = state.items.concat(data.map(normalize));
        state.page = nextPage;
        state.hasMore = data.length === state.perPage;
      } catch (err) {
        const i18n = Template7.global?.i18n || {};
        state.error = err.message || i18n.failed_load_transactions || 'Failed to load transactions.';
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: state.error } }));
      } finally {
        state.loadingMore = false;
        $update();
      }
    });
  });

  return $render;
};
</script>
