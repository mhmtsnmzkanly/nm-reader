<template>
  <div class="page nmr-page" data-name="preferences">
    <div class="navbar nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left"><a class="link back text-slate-200">Back</a></div>
        <div class="title nmr-title">Preferences</div>
      </div>
    </div>

    <div class="page-content px-5 pb-6 space-y-5">
      ${state.loading
        ? $h`<div class="nmr-panel">${i18n.loading || 'Loading...'}</div>`
        : state.error
          ? $h`<div class="nmr-panel text-red-200">${state.error}</div>`
          : $h`
            <form class="nmr-card px-4 py-4 space-y-4" id="prefs-form">
              <div>
                <label class="block text-sm text-slate-300 mb-2">Language</label>
                <select class="nmr-input" name="lang">
                  <option value="en" ${state.prefs.lang === 'en' ? 'selected' : ''}>English</option>
                  <option value="tr" ${state.prefs.lang === 'tr' ? 'selected' : ''}>Turkish</option>
                </select>
              </div>
              <div>
                <label class="block text-sm text-slate-300 mb-2">Theme</label>
                <select class="nmr-input" name="theme">
                  <option value="dark" ${state.prefs.theme === 'dark' ? 'selected' : ''}>Dark</option>
                  <option value="default" ${state.prefs.theme === 'default' ? 'selected' : ''}>Default</option>
                </select>
              </div>
              <button class="nmr-button nmr-button-primary" type="submit">Save</button>
            </form>
          `
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $f7, $el }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    prefs: { lang: 'en', theme: 'dark' },
  };

  $onMounted(async () => {
    if (!store.state.auth.isLoggedIn) {
      state.loading = false;
      state.error = i18n.login_required || 'Login required.';
      $f7.popup.open('.login-popup');
      $update();
      return;
    }
    try {
      const payload = await api.user.getPreferences();
      const data = payload?.data || payload || {};
      state.prefs = {
        lang: data.lang || 'en',
        theme: data.theme || 'dark',
      };
    } catch (err) {
      state.error = err.message || 'Failed to load preferences.';
    } finally {
      state.loading = false;
      $update();
    }
  });

  $onMounted(() => {
    $el.on('submit', '#prefs-form', async (event) => {
      event.preventDefault();
      const form = event.target;
      const payload = {
        lang: form.querySelector('select[name="lang"]')?.value || 'en',
        theme: form.querySelector('select[name="theme"]')?.value || 'dark',
      };
      try {
        await api.user.updatePreferences(payload);
        $f7.toast.create({ text: 'Preferences saved', closeTimeout: 2000 }).open();
      } catch (err) {
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Save failed' } }));
      }
    });
  });

  return $render;
};
</script>
