<template>
  <div class="page" data-name="public-profile">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <a class="link back">
            <i class="icon icon-back"></i>
            <span class="if-not-md">Back</span>
          </a>
        </div>
        <div class="title">${state.user.username || 'User Profile'}</div>
      </div>
    </div>

    <div class="page-content">
      ${state.loading
        ? $h`<div class="block text-center pt-12"><div class="preloader"></div></div>`
        : state.error
          ? $h`<div class="block block-strong inset color-red text-center"><p>${state.error}</p></div>`
          : $h`
            <!-- Hero Header -->
            <div class="card card-outline no-margin-top no-margin-horizontal no-border-radius shadow-sm">
              <div class="card-content card-content-padding flex-direction-column align-items-center display-flex pb-6">
                <div style="width: 100px; height: 100px; border-radius: 32px; background: var(--f7-theme-color); color: #fff; font-size: 40px; font-weight: 900; box-shadow: 0 8px 20px rgba(0,0,0,0.15);" class="display-flex align-items-center justify-content-center mb-4">
                  ${state.user.avatar ? $h`<img src="${state.user.avatar}" style="width:100%; height:100%; object-fit:cover; border-radius:32px" />` : (state.user.username || 'U')[0].toUpperCase()}
                </div>
                <div class="text-align-center">
                  <div class="block-title no-margin" style="font-size: 24px; font-weight: 900; color: var(--f7-text-color); text-transform: uppercase;">${state.user.username}</div>
                  <div class="chip color-blue margin-top-xs">
                    <div class="chip-label font-bold uppercase tracking-widest" style="font-size: 10px">Score: ${state.stats.score}</div>
                  </div>
                </div>
                
                <div class="display-flex justify-content-center gap-8 margin-top-lg w-full">
                  <div class="text-align-center">
                    <span class="display-block font-bold text-lg">${state.stats.followers}</span>
                    <span class="text-color-gray uppercase font-bold" style="font-size: 9px; letter-spacing: 1px">Followers</span>
                  </div>
                  <div class="text-align-center">
                    <span class="display-block font-bold text-lg">${state.stats.following}</span>
                    <span class="text-color-gray uppercase font-bold" style="font-size: 9px; letter-spacing: 1px">Following</span>
                  </div>
                  <div class="text-align-center">
                    <span class="display-block font-bold text-lg">${state.stats.blogs}</span>
                    <span class="text-color-gray uppercase font-bold" style="font-size: 9px; letter-spacing: 1px">Blogs</span>
                  </div>
                </div>

                <div class="margin-top-lg">
                  <button class="button button-fill button-round px-8 ${state.isFollowing ? 'color-gray' : 'color-blue'}" @click="${toggleFollow}">
                    ${state.isFollowing ? 'Following' : 'Follow'}
                  </button>
                </div>
              </div>
            </div>

            <!-- Bio -->
            ${state.user.bio ? $h`
              <div class="block-title uppercase tracking-widest font-bold" style="font-size: 11px">About</div>
              <div class="block block-strong-ios block-inset-ios margin-vertical-sm">
                <p class="text-color-gray">${state.user.bio}</p>
              </div>
            ` : ''}

            <!-- Activity Tabs -->
            <div class="toolbar tabbar toolbar-top no-shadow">
              <div class="toolbar-inner">
                <a href="#tab-blogs" class="tab-link tab-link-active uppercase font-bold tracking-widest" style="font-size: 10px">Blogs</a>
                <a href="#tab-comments" class="tab-link uppercase font-bold tracking-widest" style="font-size: 10px">Comments</a>
              </div>
            </div>

            <div class="tabs">
              <div id="tab-blogs" class="tab tab-active">
                ${state.blogs.length > 0 ? $h`
                  <div class="list media-list no-chevron no-hairlines">
                    <ul>
                      ${state.blogs.map((blog) => $h`
                        <li>
                          <a href="/blogs/${blog.slug}/" class="item-link item-content">
                            <div class="item-inner">
                              <div class="item-title-row">
                                <div class="item-title font-bold">${blog.title}</div>
                                <div class="item-after text-color-gray" style="font-size: 10px">${blog.date}</div>
                              </div>
                            </div>
                          </a>
                        </li>
                      `)}
                    </ul>
                  </div>
                ` : $h`<div class="block text-color-gray text-center mt-8">No blogs yet.</div>`}
              </div>
              <div id="tab-comments" class="tab">
                ${state.comments.length > 0 ? $h`
                  <div class="list media-list no-chevron no-hairlines">
                    <ul>
                      ${state.comments.map((c) => $h`
                        <li class="item-content">
                          <div class="item-inner">
                            <div class="item-title-row">
                              <div class="item-subtitle text-color-gray" style="font-size: 10px">${c.date}</div>
                            </div>
                            <div class="item-text text-color-white margin-top-xs" style="font-size: 13px">"${c.body}"</div>
                            ${c.url ? $h`
                              <div class="margin-top-sm">
                                <a href="${c.url}" class="text-color-blue uppercase font-bold tracking-widest" style="font-size: 9px">Go to content</a>
                              </div>
                            ` : ''}
                          </div>
                        </li>
                      `)}
                    </ul>
                  </div>
                ` : $h`<div class="block text-color-gray text-center mt-8">No comments yet.</div>`}
              </div>
            </div>
          `
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';

export default (props, { $onMounted, $update, $f7route, $f7 }) => {
  const person = $f7route.params.person;
  const state = {
    loading: true,
    error: '',
    user: {},
    stats: {},
    blogs: [],
    comments: [],
    isFollowing: false,
  };

  const loadData = async () => {
    try {
      const payload = await api.user.getPublicProfile(person);
      const data = payload?.data || payload || {};
      
      const user = data.user || {};
      state.user = {
        username: user.username || 'User',
        avatar: user.avatar || null,
        bio: user.bio || '',
      };

      const stats = data.statistics || {};
      state.stats = {
        score: stats.score || 0,
        followers: stats.followers_count || 0,
        following: stats.following_count || 0,
        blogs: stats.approved_blog_count || 0,
      };

      state.isFollowing = !!data.is_following;

      const blogs = data.blogs || [];
      state.blogs = (Array.isArray(blogs) ? blogs : []).map(b => ({
        title: b.title || 'Blog',
        slug: b.slug || '',
        date: b.approved_at || b.created_at ? new Date(b.approved_at || b.created_at).toLocaleDateString() : '',
      }));

      const comments = data.recent_comments || [];
      state.comments = (Array.isArray(comments) ? comments : []).map(c => ({
        body: c.body || '',
        date: c.created_at ? new Date(c.created_at).toLocaleDateString() : '',
        url: c.url_path || null,
      }));

    } catch (err) {
      state.error = err.message || 'Failed to load profile.';
    } finally {
      state.loading = false;
      $update();
    }
  };

  const toggleFollow = async () => {
    if (!store.state.auth.isLoggedIn) {
      $f7.popup.open('.login-popup');
      return;
    }
    try {
      if (state.isFollowing) {
        await api.user.unfollow(person);
        state.isFollowing = false;
        state.stats.followers--;
      } else {
        await api.user.follow(person);
        state.isFollowing = true;
        state.stats.followers++;
      }
      $update();
    } catch (err) {
      $f7.dialog.alert(err.message || 'Action failed');
    }
  };

  $onMounted(() => {
    loadData();
  });

  return $render;
};
</script>
