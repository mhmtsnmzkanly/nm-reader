<template>
  <div class="page" data-name="type-list">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left">
          <a class="link back">Back</a>
        </div>
        <div class="title">${state.typeTitle}</div>
      </div>
    </div>

    <div class="page-content">
      ${state.loading
        ? $h`<div class="block">${i18n.loading || 'Loading...'}</div>`
        : state.error
          ? $h`<div class="block error-state">${state.error}</div>`
          : $h`<div class="list media-list">
            <ul>
              ${state.items.map((item) => $h`
                <li>
                  <a class="item-link item-content" href="/content/${item.type}/${item.slug}/">
                    <div class="item-inner">
                      <div class="item-title">${item.title}</div>
                      <div class="item-after">
                        ${item.series_unlock_price
                          ? $h`<span class="badge badge--price">${item.series_unlock_price} ${i18n.coins || 'coins'}</span>`
                          : $h`<span class="badge badge--free">${i18n.free || 'Free'}</span>`
                        }
                      </div>
                    </div>
                  </a>
                </li>
              `)}
            </ul>
          </div>`
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $f7route }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    items: [],
    type: $f7route.params.type,
    typeTitle: ($f7route.params.type || '').toUpperCase(),
  };

  const normalizeSeries = (item) => ({
    title: item.title || 'Series',
    slug: item.slug || '',
    type: item.type || state.type,
    series_unlock_price: item.series_unlock_price || item.series_unlock_price_coin || item.access?.series_unlock_price || 0,
  });

  $onMounted(async () => {
    try {
      const payload = await api.content.getByType(state.type, 1, 20);
      const data = payload?.data || payload || [];
      state.items = data.map(normalizeSeries).filter((row) => row.slug);
    } catch (err) {
      state.error = err.message || i18n.failed_load_list || 'Failed to load list.';
      document.dispatchEvent(new CustomEvent('page:error', { detail: { message: state.error } }));
    } finally {
      state.loading = false;
      $update();
    }
  });

  return $render;
};
</script>
