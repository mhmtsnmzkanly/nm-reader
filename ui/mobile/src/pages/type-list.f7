<template>
  <div class="page nmr-page" data-name="type-list">
    <div class="navbar nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left">
          <a class="link back text-slate-200">Back</a>
        </div>
        <div class="title nmr-title">${state.typeTitle}</div>
      </div>
    </div>

    <div class="page-content px-5 pb-6 space-y-4">
      ${state.loading
        ? $h`<div class="nmr-panel">${i18n.loading || 'Loading...'}</div>`
        : state.error
          ? $h`<div class="nmr-panel text-red-200">${state.error}</div>`
          : $h`<div class="space-y-3">
            ${state.items.map((item) => $h`
              <a class="nmr-card nmr-card-hover block px-4 py-3" href="/content/${item.type}/${item.slug}/">
                <div class="flex items-center justify-between">
                  <div class="font-semibold text-slate-100">${item.title}</div>
                  ${item.series_unlock_price
                    ? $h`<span class="nmr-chip nmr-chip--price">${item.series_unlock_price} ${i18n.coins || 'coins'}</span>`
                    : $h`<span class="nmr-chip nmr-chip--free">${i18n.free || 'Free'}</span>`
                  }
                </div>
              </a>
            `)}
          </div>`
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $f7route }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    items: [],
    type: $f7route.params.type,
    typeTitle: ($f7route.params.type || '').toUpperCase(),
  };

  const normalizeSeries = (item) => ({
    title: item.title || 'Series',
    slug: item.slug || '',
    type: item.type || state.type,
    series_unlock_price: item.series_unlock_price || item.series_unlock_price_coin || item.access?.series_unlock_price || 0,
  });

  $onMounted(async () => {
    try {
      const payload = await api.content.getByType(state.type, 1, 20);
      const data = payload?.data || payload || [];
      state.items = data.map(normalizeSeries).filter((row) => row.slug);
    } catch (err) {
      state.error = err.message || i18n.failed_load_list || 'Failed to load list.';
      document.dispatchEvent(new CustomEvent('page:error', { detail: { message: state.error } }));
    } finally {
      state.loading = false;
      $update();
    }
  });

  return $render;
};
</script>
