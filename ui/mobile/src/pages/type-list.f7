<template>
  <div class="page" data-name="type-list">
    ${renderAppHeader({ title: pageTitle, subtitle: 'Browse by content type', back: true, large: true })}
    <div class="page-content">
      ${state.loading ? renderLoadingBlock('Loading type list...') : ''}
      ${state.error ? renderErrorState({ title: 'Type list failed', message: state.error }) : ''}
      ${!state.loading && !state.error
        ? (state.items.length
          ? state.items.map((item) => renderContentCard(item)).join('')
          : renderEmptyState({ title: 'Nothing found', message: 'There is no content for this type yet.' }))
        : ''}
    </div>
    ${renderBottomNav('home')}
  </div>
</template>
<script>
import { fetchTypeList } from '../services/content/content-service.js';
import { renderAppHeader } from '../components/app-header.js';
import { renderBottomNav } from '../components/bottom-nav.js';
import { renderContentCard } from '../components/content-card.js';
import { renderLoadingBlock } from '../components/loading-block.js';
import { renderErrorState } from '../components/error-state.js';
import { renderEmptyState } from '../components/empty-state.js';

export default (props, { $route, $onMounted, $onBeforeUnmount, $update, $el }) => {
  const type = $route.params.type || 'manga';
  const pageTitle = type.charAt(0).toUpperCase() + type.slice(1);
  const state = {
    loading: true,
    error: '',
    items: [],
  };

  /**
   * Loads the content list for the current type route param.
   */
  async function loadPage() {
    state.loading = true;
    state.error = '';
    $update();

    try {
      const payload = await fetchTypeList(type);
      state.items = payload.items;
    } catch (error) {
      state.error = error.message || 'Unable to load this type.';
    } finally {
      state.loading = false;
      $update();
    }
  }

  /**
   * Retries type loading when the shared retry button is tapped.
   */
  function handleClick(event) {
    if (event.target.closest('[data-action="retry-page"]')) {
      loadPage();
    }
  }

  $onMounted(() => {
    $el.addEventListener('click', handleClick);
    loadPage();
  });

  $onBeforeUnmount(() => {
    $el.removeEventListener('click', handleClick);
  });

  return $render;
};
</script>
