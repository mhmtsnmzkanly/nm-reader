<template>
  <div class="page nmr-page" data-name="reader">
    <div class="navbar nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left">
          <a class="link back text-slate-200">Back</a>
        </div>
        <div class="title nmr-title">${state.title}</div>
      </div>
    </div>

    <div class="page-content px-5 pb-6 space-y-6">
      ${state.loading
        ? $h`<div class="nmr-panel">${i18n.loading || 'Loading...'}</div>`
        : state.error
          ? $h`<div class="nmr-panel text-red-200">${state.error}</div>`
          : state.is_locked
            ? $h`<div class="nmr-panel space-y-3 text-center">
              <div class="text-slate-100">${i18n.reader_locked || 'This chapter is locked.'}</div>
              <div class="text-amber-200">${state.price_coin} ${i18n.coins || 'coins'}</div>
              <a class="nmr-button nmr-button-primary inline-block" data-action="unlock" href="#">${i18n.unlock || 'Unlock'}</a>
            </div>`
            : $h`
              ${state.is_image
                ? $h`<div class="space-y-5">
                  ${state.pages.map((page) => $h`<img class="reader-image" src="${page}" alt="" loading="lazy" />`)}
                </div>`
                : $h`
                  <div class="flex gap-3">
                    <button class="nmr-button nmr-button-ghost" data-action="font-dec" type="button">A-</button>
                    <button class="nmr-button nmr-button-ghost" data-action="font-inc" type="button">A+</button>
                  </div>
                  <div class="nmr-panel" style="font-size: ${state.font_size}px;">
                    ${state.paragraphs.map((para) => $h`<p class="mb-5 leading-8 text-slate-100">${para}</p>`)}
                  </div>
                `
              }

              <div class="nmr-section-title">${i18n.comments || 'Comments'}</div>
              <div class="space-y-3 pb-8">
                ${state.comments.map((comment) => $h`
                  <div class="nmr-card px-4 py-3 space-y-2">
                    <div class="text-sm text-slate-100">${comment.author}</div>
                    <div class="text-sm text-slate-300">${comment.body}</div>
                    <div class="flex items-center gap-3 text-xs text-slate-400">
                      <span>${comment.created_at}</span>
                      <button class="text-amber-200" data-action="comment-vote" data-id="${comment.id}">+${comment.votes}</button>
                    </div>
                  </div>
                `)}
                <form class="nmr-card px-4 py-3 space-y-2" id="chapter-comment-form">
                  <textarea class="nmr-input" name="body" rows="3" placeholder="${i18n.comment_placeholder || 'Write a comment...'}"></textarea>
                  <button class="nmr-button nmr-button-primary" type="submit">${i18n.post || 'Post'}</button>
                </form>
              </div>
            `
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $onBeforeUnmount, $update, $f7route, $el, $f7 }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    title: 'Chapter',
    is_locked: false,
    price_coin: 0,
    is_image: false,
    pages: [],
    paragraphs: [],
    font_size: 16,
    type: $f7route.params.type,
    slug: $f7route.params.slug,
    chapterNumber: $f7route.params.chapterNumber,
    chapterId: null,
    comments: [],
  };

  const fontKey = 'nmr_reader_font_size';
  const onPurchaseSuccess = async (event) => {
    if (event.detail?.chapterId !== state.chapterId) return;
    await loadChapter();
    $update();
  };

  const loadComments = async () => {
    if (!state.chapterId) return;
    try {
      const payload = await api.interactions.listChapterComments(state.chapterId, 1, 20);
      const data = payload?.data || payload || [];
      state.comments = (Array.isArray(data) ? data : []).map((row) => ({
        id: row.id || row.comment_id || 0,
        author: row.username || row.author_username || 'User',
        body: row.body || row.comment || '',
        created_at: row.created_at || '',
        votes: row.votes || row.score || 0,
      }));
    } catch (err) {
      state.comments = [];
    }
  };

  const loadChapter = async () => {
    const payload = await api.content.getChapterFull(state.type, state.slug, state.chapterNumber);
    const chapter = payload?.data || payload || {};
    state.chapterId = chapter.id || null;
    state.title = chapter.title || `Chapter ${state.chapterNumber}`;
    state.is_locked = chapter.is_locked ?? !(chapter.access?.granted ?? true);
    state.price_coin = chapter.price_coin || chapter.access?.chapter_unlock_price || 0;
    state.is_image = chapter.type === 'image';
    if (state.is_image) {
      state.pages = Array.isArray(chapter.pages) ? chapter.pages : [];
      state.paragraphs = [];
    } else {
      const body = String(chapter.body || '');
      state.paragraphs = body.split('\n').filter((line) => line.trim() !== '');
      state.pages = [];
    }
    await loadComments();
  };

  $onMounted(async () => {
    if (typeof localStorage !== 'undefined') {
      const storedSize = Number(localStorage.getItem(fontKey) || '16');
      if (!Number.isNaN(storedSize) && storedSize > 10 && storedSize < 40) {
        state.font_size = storedSize;
      }
    }
    try {
      await loadChapter();
    } catch (err) {
      state.error = err.message || i18n.failed_load_chapter || 'Failed to load chapter.';
      document.dispatchEvent(new CustomEvent('page:error', { detail: { message: state.error } }));
    } finally {
      state.loading = false;
      $update();
    }

    document.addEventListener('purchase:success', onPurchaseSuccess);

    $el.on('click', '[data-action="unlock"]', async (event) => {
      event.preventDefault();
      if (!store.state.auth.isLoggedIn) {
        $f7.popup.open('.login-popup');
        return;
      }
      if (!state.chapterId) {
        $f7.dialog.alert(i18n.chapter_not_available || 'Chapter not available.');
        return;
      }
      document.dispatchEvent(new CustomEvent('purchase:open', { detail: { chapterId: state.chapterId, price: state.price_coin } }));
    });

    $el.on('click', '[data-action="font-inc"]', (event) => {
      event.preventDefault();
      state.font_size = Math.min(32, state.font_size + 1);
      if (typeof localStorage !== 'undefined') {
        localStorage.setItem(fontKey, String(state.font_size));
      }
      $update();
    });

    $el.on('click', '[data-action="font-dec"]', (event) => {
      event.preventDefault();
      state.font_size = Math.max(12, state.font_size - 1);
      if (typeof localStorage !== 'undefined') {
        localStorage.setItem(fontKey, String(state.font_size));
      }
      $update();
    });

    $el.on('submit', '#chapter-comment-form', async (event) => {
      event.preventDefault();
      if (!store.state.auth.isLoggedIn) {
        $f7.popup.open('.login-popup');
        return;
      }
      const form = event.target;
      const body = form.querySelector('textarea[name="body"]')?.value || '';
      if (!body.trim()) return;
      try {
        await api.interactions.createChapterComment(state.chapterId, body.trim());
        form.reset();
        await loadComments();
        $update();
      } catch (err) {
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Comment failed' } }));
      }
    });

    $el.on('click', '[data-action="comment-vote"]', async (event) => {
      event.preventDefault();
      if (!store.state.auth.isLoggedIn) {
        $f7.popup.open('.login-popup');
        return;
      }
      const id = event.target.getAttribute('data-id');
      if (!id) return;
      try {
        await api.interactions.voteComment(id, 1);
        await loadComments();
        $update();
      } catch (err) {
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Vote failed' } }));
      }
    });
  });

  $onBeforeUnmount(() => {
    document.removeEventListener('purchase:success', onPurchaseSuccess);
  });

  return $render;
};
</script>
