<template>
  <div class="page nmr-page no-toolbar" data-name="reader">
    <!-- Immersive Navbar (Hides on Scroll) -->
    <div class="navbar nmr-navbar navbar-hidden-on-scroll">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left">
          <a class="link back">
            <i class="f7-icons">chevron_left</i>
          </a>
        </div>
        <div class="title nmr-title">${state.title}</div>
        <div class="right">
          <a class="link icon-only" @click="${() => state.showSettings = !state.state.showSettings}">
            <i class="f7-icons">slider_horizontal_3</i>
          </a>
        </div>
      </div>
    </div>

    <!-- Reader Progress Bar (Custom) -->
    <div class="reader-progress-bar" id="reader-progress"></div>

    <div class="page-content" @scroll="${handleScroll}">
      ${state.loading
        ? $h`<div class="block display-flex justify-content-center align-items-center" style="height: 100%"><div class="preloader"></div></div>`
        : state.error
          ? $h`<div class="block nmr-panel color-red text-center m-5">${state.error}</div>`
          : state.is_locked
            ? $h`
              <div class="block text-center pt-12 space-y-4">
                <i class="f7-icons size-64 text-orange-400">lock_fill</i>
                <h2 class="nmr-title text-2xl text-white">Unlock Chapter</h2>
                <p class="text-slate-400">This chapter costs ${state.price_coin} coins.</p>
                <button class="button button-fill button-large color-purple" data-action="unlock">Unlock Now</button>
              </div>`
            : $h`
              <div class="reader-container animate-fade-in pb-12">
                ${state.is_image
                  ? $h`<div class="manga-images">
                    ${state.pages.map((page) => $h`<img class="reader-image" src="${page}" loading="lazy" />`)}
                  </div>`
                  : $h`
                    <div class="novel-content reader-theme-${state.theme} p-6" style="font-size: ${state.font_size}px;">
                      ${state.paragraphs.map((para) => $h`<p class="mb-6 leading-relaxed">${para}</p>`)}
                    </div>
                  `
                }

                <!-- Discussion Section at Bottom -->
                <div class="block-title mt-12">Comments</div>
                <div class="list media-list inset mb-12">
                  <ul>
                    ${state.comments.map((c) => $h`
                      <li class="item-content">
                        <div class="item-inner">
                          <div class="item-title-row">
                            <div class="item-title text-xs font-bold">${c.author}</div>
                          </div>
                          <div class="item-text text-xs">${c.body}</div>
                        </div>
                      </li>
                    `)}
                  </ul>
                </div>
              </div>
            `
      }
    </div>

    <!-- Reader Settings (Sheet Modal) -->
    <div class="sheet-modal reader-settings-sheet" style="height: auto">
      <div class="sheet-modal-inner p-5 space-y-6">
        <div class="block-title">Reader Settings</div>
        <div class="list no-hairlines">
          <ul>
            <li class="item-content">
              <div class="item-inner">
                <div class="item-title">Font Size</div>
                <div class="item-after">
                  <div class="stepper stepper-init" data-value="${state.font_size}">
                    <div class="stepper-button-minus" @click="${() => updateFont(-1)}"></div>
                    <div class="stepper-button-plus" @click="${() => updateFont(1)}"></div>
                  </div>
                </div>
              </div>
            </li>
            <li class="item-content">
              <div class="item-inner">
                <div class="item-title">Theme</div>
                <div class="item-after">
                  <div class="segmented segmented-strong segmented-round">
                    <button class="button ${state.theme === 'dark' ? 'button-active' : ''}" @click="${() => setTheme('dark')}">Dark</button>
                    <button class="button ${state.theme === 'sepia' ? 'button-active' : ''}" @click="${() => setTheme('sepia')}">Sepia</button>
                    <button class="button ${state.theme === 'light' ? 'button-active' : ''}" @click="${() => setTheme('light')}">Light</button>
                  </div>
                </div>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</template>
<script>
import $ from 'dom7';
import api from '../js/api.js';
import store from '../js/store.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $onBeforeUnmount, $update, $f7route, $el, $f7 }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    title: 'Chapter',
    is_locked: false,
    price_coin: 0,
    is_image: false,
    pages: [],
    paragraphs: [],
    font_size: 16,
    theme: 'dark',
    type: $f7route.params.type,
    slug: $f7route.params.slug,
    chapterNumber: $f7route.params.chapterNumber,
    chapterId: null,
    comments: [],
  };

  const fontKey = 'nmr_reader_font_size';
  const themeKey = 'nmr_reader_theme';

  const updateFont = (delta) => {
    state.font_size = Math.max(12, Math.min(32, state.font_size + delta));
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(fontKey, String(state.font_size));
    }
    $update();
  };

  const setTheme = (t) => {
    state.theme = t;
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(themeKey, t);
    }
    $update();
  };

  const handleScroll = (e) => {
    const el = e.target;
    const progress = (el.scrollTop / (el.scrollHeight - el.offsetHeight)) * 100;
    const progressEl = document.getElementById('reader-progress');
    if (progressEl) progressEl.style.width = `${progress}%`;
  };

  const onPurchaseSuccess = async (event) => {
    if (event.detail?.chapterId !== state.chapterId) return;
    await loadChapter();
    $update();
  };

  const loadComments = async () => {
    if (!state.chapterId) return;
    try {
      const payload = await api.interactions.listChapterComments(state.chapterId, 1, 20);
      const data = payload?.data || payload || [];
      state.comments = (Array.isArray(data) ? data : []).map((row) => ({
        id: row.id || row.comment_id || 0,
        author: row.username || row.author_username || 'User',
        body: row.body || row.comment || '',
        created_at: row.created_at || '',
        votes: row.votes || row.score || 0,
      }));
    } catch (err) {
      state.comments = [];
    }
  };

  const loadChapter = async () => {
    const payload = await api.content.getChapterFull(state.type, state.slug, state.chapterNumber);
    const chapter = payload?.data || payload || {};
    state.chapterId = chapter.id || null;
    state.title = chapter.title || `Chapter ${state.chapterNumber}`;
    state.is_locked = chapter.is_locked ?? !(chapter.access?.granted ?? true);
    state.price_coin = chapter.price_coin || chapter.access?.chapter_unlock_price || 0;
    state.is_image = chapter.type === 'image';
    if (state.is_image) {
      state.pages = Array.isArray(chapter.pages) ? chapter.pages : [];
      state.paragraphs = [];
    } else {
      const body = String(chapter.body || '');
      state.paragraphs = body.split('\n').filter((line) => line.trim() !== '');
      state.pages = [];
    }
    await loadComments();
  };

  $onMounted(async () => {
    if (typeof localStorage !== 'undefined') {
      const storedSize = Number(localStorage.getItem(fontKey) || '16');
      if (!Number.isNaN(storedSize) && storedSize > 10 && storedSize < 40) {
        state.font_size = storedSize;
      }
      const storedTheme = localStorage.getItem(themeKey);
      if (storedTheme) {
        state.theme = storedTheme;
      }
    }
    try {
      await loadChapter();
    } catch (err) {
      state.error = err.message || i18n.failed_load_chapter || 'Failed to load chapter.';
      document.dispatchEvent(new CustomEvent('page:error', { detail: { message: state.error } }));
    } finally {
      state.loading = false;
      $update();
    }

    document.addEventListener('purchase:success', onPurchaseSuccess);

    $($el).on('click', '[data-action="unlock"]', async (event) => {
      event.preventDefault();
      if (!store.state.auth.isLoggedIn) {
        $f7.popup.open('.login-popup');
        return;
      }
      if (!state.chapterId) {
        $f7.dialog.alert(i18n.chapter_not_available || 'Chapter not available.');
        return;
      }
      document.dispatchEvent(new CustomEvent('purchase:open', { detail: { chapterId: state.chapterId, price: state.price_coin } }));
    });

    $($el).on('click', '[data-action="font-inc"]', (event) => {
      event.preventDefault();
      updateFont(1);
    });

    $($el).on('click', '[data-action="font-dec"]', (event) => {
      event.preventDefault();
      updateFont(-1);
    });

    $($el).on('click', '[data-action="set-theme"]', (event) => {
      event.preventDefault();
      const theme = $(event.target).data('theme');
      if (theme) setTheme(theme);
    });

    $($el).on('submit', '#chapter-comment-form', async (event) => {
      event.preventDefault();
      if (!store.state.auth.isLoggedIn) {
        $f7.popup.open('.login-popup');
        return;
      }
      const form = event.target;
      const body = $(form).find('textarea[name="body"]').val() || '';
      if (!body.trim()) return;
      try {
        await api.interactions.createChapterComment(state.chapterId, body.trim());
        form.reset();
        await loadComments();
        $update();
      } catch (err) {
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Comment failed' } }));
      }
    });

    $($el).on('click', '[data-action="comment-vote"]', async (event) => {
      event.preventDefault();
      if (!store.state.auth.isLoggedIn) {
        $f7.popup.open('.login-popup');
        return;
      }
      const id = $(event.target).data('id');
      if (!id) return;
      try {
        await api.interactions.voteComment(id, 1);
        await loadComments();
        $update();
      } catch (err) {
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Vote failed' } }));
      }
    });
  });

  $onBeforeUnmount(() => {
    document.removeEventListener('purchase:success', onPurchaseSuccess);
  });

  return $render;
};
</script>
