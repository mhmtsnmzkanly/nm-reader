<template>
  <div class="page reader-page theme-${state.readerTheme}" data-name="reader">
    ${renderAppHeader($h, { title: state.chapter?.series?.title || 'Reader', subtitle: state.chapter?.title || 'Reading mode', back: true })}
    <div class="page-content reader-page__content">
      ${state.loading ? renderLoadingBlock($h, 'Loading chapter...') : ''}
      ${state.error ? renderErrorState($h, { title: 'Reader failed', message: state.error }) : ''}

      ${!state.loading && !state.error && state.chapter ? $h`
        ${state.isLocked ? $h`
          <div class="block block-strong mobile-feedback-block">
            <div class="mobile-feedback-title">Chapter locked</div>
            <p>This chapter requires unlock before reading.</p>
            ${state.chapterId ? $h`<button class="button button-fill color-orange" data-action="unlock-chapter">Unlock chapter</button>` : ''}
          </div>
        ` : $h`
          <div class="reader-toolbar">
            <button class="button button-small" data-action="decrease-font">A-</button>
            <button class="button button-small" data-action="increase-font">A+</button>
            <button class="button button-small" data-action="toggle-reader-theme">Theme</button>
          </div>

          ${state.chapter.readerType === 'text'
            ? $h`<div class="reader-text" style="font-size:${state.fontSize}px">${$h`${state.renderedText}`}</div>`
            : $h`<div class="reader-image-list">${$h`${state.chapter.images.map((image) => `<img src="${image}" alt="Chapter page" loading="lazy" />`).join('')}`}</div>`
          }
        `}

        <div class="block block-strong reader-navigation">
          <a class="button ${state.chapter.previousChapter ? '' : 'disabled'}" href="${state.chapter.previousChapter ? `/reader/${type}/${slug}/${state.chapter.previousChapter.chapter_number || state.chapter.previousChapter.number}/` : '#'}">Previous</a>
          <a class="button button-fill" href="/content/${type}/${slug}/">Chapters</a>
          <a class="button ${state.chapter.nextChapter ? '' : 'disabled'}" href="${state.chapter.nextChapter ? `/reader/${type}/${slug}/${state.chapter.nextChapter.chapter_number || state.chapter.nextChapter.number}/` : '#'}">Next</a>
        </div>
      ` : ''}
    </div>
  </div>
</template>
<script>
import { appStore } from '../store/app-store.js';
import { fetchChapter } from '../services/reader/reader-service.js';
import { fetchWalletSummary, unlockChapter } from '../services/wallet/wallet-service.js';
import { renderAppHeader } from '../components/app-header.js';
import { renderLoadingBlock } from '../components/loading-block.js';
import { renderErrorState } from '../components/error-state.js';
import { debugError, debugTrace } from '../utils/debug.js';
import { resolveComponentElement } from '../utils/dom.js';
import { escapeHtml } from '../utils/format.js';

export default (props, { $route, $onMounted, $onBeforeUnmount, $update, $el, $f7 }) => {
  const rootEl = () => resolveComponentElement($el);
  const type = $route.params.type;
  const slug = $route.params.slug;
  const chapterNumber = $route.params.chapterNumber;
  const state = {
    loading: true,
    error: '',
    chapter: null,
    chapterId: '',
    isLocked: false,
    fontSize: appStore.getState().readerPreferences.fontSize,
    readerTheme: appStore.getState().readerPreferences.theme,
    renderedText: '',
  };

  /**
   * Converts plain text chapter bodies into safe paragraph blocks.
   */
  function renderText(body) {
    return String(body || '')
      .split(/\n{2,}/)
      .map((paragraph) => paragraph.trim())
      .filter(Boolean)
      .map((paragraph) => `<p>${escapeHtml(paragraph).replace(/\n/g, '<br>')}</p>`)
      .join('');
  }

  /**
   * Loads the current chapter and derives the reader mode state.
   */
  async function loadPage() {
    debugTrace({
      scope: 'reader',
      action: 'loadPage:start',
      caller: 'ui/mobile/src/pages/reader.f7#loadPage',
      callee: `fetchChapter(${type}, ${slug}, ${chapterNumber})`,
      next: 'load reader payload and derive mode',
    });

    state.loading = true;
    state.error = '';
    $update();

    try {
      const chapter = await fetchChapter(type, slug, chapterNumber);
      state.chapter = chapter;
      state.chapterId = chapter.id;
      state.isLocked = !(chapter.access?.granted ?? true);
      state.renderedText = chapter.readerType === 'text' ? renderText(chapter.body) : '';
      debugTrace({
        scope: 'reader',
        action: 'loadPage:success',
        caller: 'reader loadPage',
        callee: 'reader state',
        next: state.isLocked ? 'show locked prompt' : `render ${chapter.readerType} reader`,
        detail: {
          chapterId: state.chapterId,
          readerType: chapter.readerType,
          isLocked: state.isLocked,
        },
      });
    } catch (error) {
      debugError({
        scope: 'reader',
        action: 'loadPage:error',
        caller: 'reader loadPage',
        callee: `fetchChapter(${type}, ${slug}, ${chapterNumber})`,
        next: 'render reader error state',
        error,
      });
      state.error = error.message || 'Unable to load chapter.';
    } finally {
      state.loading = false;
      $update();
    }
  }

  /**
   * Updates reader preferences and persists them to the global store.
   */
  function updateReaderPreferences(patch) {
    debugTrace({
      scope: 'reader',
      action: 'updateReaderPreferences',
      caller: 'ui/mobile/src/pages/reader.f7#updateReaderPreferences',
      callee: 'appStore.actions.setReaderPreferences',
      next: 'refresh reader controls and page styles',
      detail: {
        patch,
      },
    });
    appStore.actions.setReaderPreferences(patch);
    state.fontSize = appStore.getState().readerPreferences.fontSize;
    state.readerTheme = appStore.getState().readerPreferences.theme;
    $update();
  }

  /**
   * Handles local reader controls and unlock flow.
   */
  async function handleClick(event) {
    if (event.target.closest('[data-action="retry-page"]')) {
      debugTrace({
        scope: 'reader',
        action: 'handleClick:retry',
        caller: 'reader click handler',
        callee: 'loadPage',
        next: 'retry chapter load',
      });
      loadPage();
      return;
    }

    if (event.target.closest('[data-action="decrease-font"]')) {
      updateReaderPreferences({
        fontSize: Math.max(14, state.fontSize - 2),
      });
    }

    if (event.target.closest('[data-action="increase-font"]')) {
      updateReaderPreferences({
        fontSize: Math.min(30, state.fontSize + 2),
      });
    }

    if (event.target.closest('[data-action="toggle-reader-theme"]')) {
      updateReaderPreferences({
        theme: state.readerTheme === 'dark' ? 'light' : 'dark',
      });
    }

    if (event.target.closest('[data-action="unlock-chapter"]')) {
      try {
        debugTrace({
          scope: 'reader',
          action: 'handleClick:unlockChapter',
          caller: 'reader click handler',
          callee: `unlockChapter(${state.chapterId})`,
          next: 'refresh wallet and reload chapter',
          detail: {
            chapterId: state.chapterId,
          },
        });
        await unlockChapter(state.chapterId);
        const wallet = await fetchWalletSummary();
        appStore.actions.setWalletSummary(wallet);
        await loadPage();
      } catch (error) {
        debugError({
          scope: 'reader',
          action: 'handleClick:unlockChapterError',
          caller: 'reader click handler',
          callee: `unlockChapter(${state.chapterId})`,
          next: 'show unlock failure dialog',
          error,
        });
        $f7.dialog.alert(error.message || 'Unlock failed.');
      }
    }
  }

  $onMounted(() => {
    debugTrace({
      scope: 'reader',
      action: 'page:mounted',
      caller: 'reader page lifecycle',
      callee: 'loadPage',
      next: 'fetch initial chapter payload',
      detail: {
        type,
        slug,
        chapterNumber,
      },
    });
    rootEl()?.addEventListener('click', handleClick);
    loadPage();
  });

  $onBeforeUnmount(() => {
    rootEl()?.removeEventListener('click', handleClick);
  });

  return $render;
};
</script>
