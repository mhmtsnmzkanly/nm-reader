<template>
  <div class="page" data-name="reader">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left">
          <a class="link back">Back</a>
        </div>
        <div class="title">{{state.title}}</div>
      </div>
    </div>

    <div class="page-content">
      {{#if state.loading}}
        <div class="block">Loading...</div>
      {{else}}
        {{#if state.error}}
          <div class="block">{{state.error}}</div>
        {{else}}
          {{#if state.is_locked}}
            <div class="block">
              <div>This chapter is locked.</div>
              <div>{{state.price_coin}} coins required.</div>
              <a class="button button-fill" data-action="unlock" href="#">Unlock</a>
            </div>
          {{else}}
            {{#if state.is_image}}
              <div class="block">
                {{#each state.pages}}
                  <img class="reader-image" src="{{this}}" alt="" loading="lazy" />
                {{/each}}
              </div>
            {{else}}
              <div class="block reader-text">
                {{#each state.paragraphs}}
                  <p>{{this}}</p>
                {{/each}}
              </div>
            {{/if}}
          {{/if}}
        {{/if}}
      {{/if}}
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';

export default (props, { $onMounted, $update, $f7route, $el, $f7 }) => {
  const state = {
    loading: true,
    error: '',
    title: 'Chapter',
    is_locked: false,
    price_coin: 0,
    is_image: false,
    pages: [],
    paragraphs: [],
    type: $f7route.params.type,
    slug: $f7route.params.slug,
    chapterNumber: $f7route.params.chapterNumber,
    chapterId: null,
  };

  const loadChapter = async () => {
    const payload = await api.content.getChapterFull(state.type, state.slug, state.chapterNumber);
    const chapter = payload?.data || payload || {};
    state.chapterId = chapter.id || null;
    state.title = chapter.title || `Chapter ${state.chapterNumber}`;
    state.is_locked = chapter.is_locked ?? !(chapter.access?.granted ?? true);
    state.price_coin = chapter.price_coin || chapter.access?.chapter_unlock_price || 0;
    state.is_image = chapter.type === 'image';
    if (state.is_image) {
      state.pages = Array.isArray(chapter.pages) ? chapter.pages : [];
      state.paragraphs = [];
    } else {
      const body = String(chapter.body || '');
      state.paragraphs = body.split('\n').filter((line) => line.trim() !== '');
      state.pages = [];
    }
  };

  $onMounted(async () => {
    try {
      await loadChapter();
    } catch (err) {
      state.error = err.message || 'Failed to load chapter.';
    } finally {
      state.loading = false;
      $update();
    }

    $el.on('click', '[data-action="unlock"]', async (event) => {
      event.preventDefault();
      if (!store.state.auth.isLoggedIn) {
        $f7.popup.open('.login-popup');
        return;
      }
      if (!state.chapterId) {
        $f7.dialog.alert('Chapter not available.');
        return;
      }
      try {
        await api.wallet.unlockChapter(state.chapterId);
        const walletPayload = await api.wallet.getSummary();
        const walletData = walletPayload?.data || walletPayload || {};
        store.dispatch('setWallet', { balance: walletData.balance || 0 });
        await loadChapter();
        $update();
      } catch (err) {
        $f7.dialog.alert(err.message || 'Unlock failed');
      }
    });
  });

  return $render;
};
</script>
