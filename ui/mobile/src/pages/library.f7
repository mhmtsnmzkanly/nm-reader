<template>
  <div class="page nmr-page" data-name="library">
    <div class="navbar nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="title nmr-title">My Library</div>
        <div class="right">
          <a class="link icon-only">
            <i class="f7-icons">sort_down</i>
          </a>
        </div>
      </div>
    </div>

    <div class="page-content">
      ${state.loading
        ? $h`
          <div class="row p-4">
            ${[1, 2, 3, 4].map(() => $h`
              <div class="col-50 mb-4">
                <div class="skeleton-block rounded-xl" style="height: 220px"></div>
                <div class="skeleton-text mt-2 h-4 w-3/4"></div>
              </div>
            `)}
          </div>
        `
        : state.error
          ? $h`<div class="block nmr-panel color-red m-5">${state.error}</div>`
          : state.items.length
            ? $h`
              <div class="row p-4 no-gap">
                ${state.items.map((item) => $h`
                  <div class="col-50 p-2 animate-fade-in">
                    <a href="/content/${item.type}/${item.slug}/" class="block group">
                      <div class="nmr-card no-margin relative shadow-lg group-active:scale-95 transition-transform">
                        <img src="${item.cover}" style="width: 100%; height: 220px; object-fit: cover; display: block;" />
                        <div class="absolute top-2 right-2">
                           <span class="badge color-purple text-[9px] px-1">${item.type}</span>
                        </div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
                        <div class="absolute bottom-3 left-3 right-3">
                           <div class="text-xs font-bold text-white line-clamp-2">${item.title}</div>
                        </div>
                      </div>
                    </a>
                  </div>
                `)}
              </div>`
            : $h`
              <div class="block text-center pt-12 space-y-4">
                <i class="f7-icons size-64 text-slate-600">book</i>
                <h3 class="text-white nmr-title">Library Empty</h3>
                <p class="text-slate-400 text-sm">Start following your favorite series to see them here.</p>
                <a href="/" class="button button-fill color-purple">Explore Stories</a>
              </div>
            `
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $f7 }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    items: [],
  };

  const normalizeCover = (value) => {
    if (!value) return '/assets/img/covers/placeholder.svg';
    if (value.startsWith('http://') || value.startsWith('https://')) return value;
    let normalized = value;
    while (normalized.startsWith('/')) normalized = normalized.slice(1);
    return `/${normalized}`;
  };

  const normalizeItem = (item) => ({
    title: item.title || item.series_title || 'Series',
    slug: item.slug || item.series_slug || '',
    type: item.type || item.type_path || item.series_type || 'novel',
    cover: normalizeCover(item.cover_image || item.cover || item.thumbnail || item.image || item.series_cover || item.series_cover_image || item.series_thumbnail),
  });

  $onMounted(async () => {
    if (!store.state.auth.isLoggedIn) {
      state.loading = false;
      state.error = i18n.login_required || 'Login required.';
      $f7.popup.open('.login-popup');
      $update();
      return;
    }
    try {
      const payload = await api.user.getFollows(1, 50);
      const data = payload?.data || payload || [];
      state.items = (Array.isArray(data) ? data : []).map(normalizeItem).filter((row) => row.slug);
    } catch (err) {
      state.error = err.message || 'Failed to load library.';
    } finally {
      state.loading = false;
      $update();
    }
  });

  return $render;
};
</script>
