<template>
  <div class="page" data-name="library">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="title">My Library</div>
      </div>
    </div>

    <div class="page-content">
      ${state.loading
        ? $h`
          <div class="row p-2">
            ${[1, 2, 3, 4].map(() => $h`
              <div class="col-50">
                <div class="skeleton-block rounded" style="height: 180px; margin: 8px"></div>
              </div>
            `)}
          </div>
        `
        : state.items.length
          ? $h`
            <div class="row no-gap">
              ${state.items.map((item) => $h`
                <div class="col-50">
                  <a href="/content/${item.type}/${item.slug}/" class="card card-outline demo-card-header-pic">
                    <div style="background-image:url(${item.cover}); height: 180px; background-size: cover; background-position: center;" class="card-header align-items-flex-end text-color-white font-bold"></div>
                    <div class="card-content card-content-padding">
                      <p class="no-margin font-bold text-xs line-clamp-1">${item.title}</p>
                      <p class="no-margin text-color-gray" style="font-size: 10px">${item.type}</p>
                    </div>
                  </a>
                </div>
              `)}
            </div>`
          : $h`
            <div class="block text-center pt-12">
              <p class="text-color-gray">Your library is empty.</p>
              <a href="/" class="button button-fill color-blue mt-4">Explore Stories</a>
            </div>
          `
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $f7 }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    items: [],
  };

  const normalizeCover = (value) => {
    if (!value) return '/assets/img/covers/placeholder.svg';
    if (value.startsWith('http://') || value.startsWith('https://')) return value;
    let normalized = value;
    while (normalized.startsWith('/')) normalized = normalized.slice(1);
    return `/${normalized}`;
  };

  const normalizeItem = (item) => ({
    title: item.title || item.series_title || 'Series',
    slug: item.slug || item.series_slug || '',
    type: item.type || item.type_path || item.series_type || 'novel',
    cover: normalizeCover(item.cover_image || item.cover || item.thumbnail || item.image || item.series_cover || item.series_cover_image || item.series_thumbnail),
  });

  $onMounted(async () => {
    if (!store.state.auth.isLoggedIn) {
      state.loading = false;
      state.error = i18n.login_required || 'Login required.';
      $f7.popup.open('.login-popup');
      $update();
      return;
    }
    try {
      const payload = await api.user.getFollows(1, 50);
      const data = payload?.data || payload || [];
      state.items = (Array.isArray(data) ? data : []).map(normalizeItem).filter((row) => row.slug);
    } catch (err) {
      state.error = err.message || 'Failed to load library.';
    } finally {
      state.loading = false;
      $update();
    }
  });

  return $render;
};
</script>
