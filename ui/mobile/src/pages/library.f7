<template>
  <div class="page" data-name="library">
    ${renderAppHeader({ title: 'Library', subtitle: 'Followed content', large: true })}
    <div class="page-content">
      ${!isAuthed ? renderAuthGuardBlock() : ''}
      ${isAuthed && state.loading ? renderLoadingBlock('Loading your library...') : ''}
      ${isAuthed && state.error ? renderErrorState({ title: 'Library failed', message: state.error }) : ''}
      ${isAuthed && !state.loading && !state.error
        ? (state.items.length
          ? state.items.map((item) => renderContentCard(item)).join('')
          : renderEmptyState({ title: 'Library is empty', message: 'Follow a series to keep it here.', actionHref: '/home/', actionLabel: 'Explore' }))
        : ''}
    </div>
    ${renderBottomNav('library')}
  </div>
</template>
<script>
import { appStore } from '../store/app-store.js';
import { fetchLibrary } from '../services/user/user-service.js';
import { renderAppHeader } from '../components/app-header.js';
import { renderBottomNav } from '../components/bottom-nav.js';
import { renderAuthGuardBlock } from '../components/auth-guard-block.js';
import { renderContentCard } from '../components/content-card.js';
import { renderLoadingBlock } from '../components/loading-block.js';
import { renderErrorState } from '../components/error-state.js';
import { renderEmptyState } from '../components/empty-state.js';
import { debugError, debugTrace } from '../utils/debug.js';

export default (props, { $el, $onMounted, $onBeforeUnmount, $update }) => {
  const isAuthed = appStore.isAuthenticated();
  const state = {
    loading: true,
    error: '',
    items: [],
  };

  /**
   * Loads followed content for the authenticated user.
   */
  async function loadPage() {
    if (!isAuthed) {
      debugTrace({
        scope: 'libraryPage',
        action: 'loadPage:skipped',
        caller: 'libraryPage.loadPage',
        callee: 'authGuard',
        next: 'render-auth-required',
      });
      state.loading = false;
      return;
    }

    try {
      debugTrace({
        scope: 'libraryPage',
        action: 'loadPage:start',
        caller: 'libraryPage.loadPage',
        callee: 'userService.fetchLibrary',
        next: 'render-library',
      });
      const payload = await fetchLibrary();
      state.items = payload.items;
      debugTrace({
        scope: 'libraryPage',
        action: 'loadPage:success',
        caller: 'libraryPage.loadPage',
        callee: 'userService.fetchLibrary',
        next: 'paint-library',
        detail: { count: state.items.length },
      });
    } catch (error) {
      state.error = error.message || 'Unable to load library.';
      debugError({
        scope: 'libraryPage',
        action: 'loadPage:error',
        caller: 'libraryPage.loadPage',
        callee: 'userService.fetchLibrary',
        next: 'render-library-error',
        detail: { message: state.error },
      });
    } finally {
      state.loading = false;
      $update();
    }
  }

  /**
   * Retries library loading on demand.
   */
  function handleClick(event) {
    if (event.target.closest('[data-action="retry-page"]')) {
      debugTrace({
        scope: 'libraryPage',
        action: 'retry:click',
        caller: 'libraryPage.handleClick',
        callee: 'libraryPage.loadPage',
        next: 'reload-library',
      });
      state.loading = true;
      state.error = '';
      $update();
      loadPage();
    }
  }

  $onMounted(() => {
    debugTrace({
      scope: 'libraryPage',
      action: 'mounted',
      caller: 'framework7.page',
      callee: 'libraryPage.loadPage',
      next: 'load-library',
    });
    $el.addEventListener('click', handleClick);
    loadPage();
  });

  $onBeforeUnmount(() => {
    $el.removeEventListener('click', handleClick);
  });

  return $render;
};
</script>
