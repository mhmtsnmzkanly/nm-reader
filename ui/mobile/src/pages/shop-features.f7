<template>
  <div class="page" data-name="shop-features">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <a class="link back">
            <i class="icon icon-back"></i>
            <span class="if-not-md">Back</span>
          </a>
        </div>
        <div class="title">${i18n.features || 'Features'}</div>
      </div>
    </div>

    <div class="page-content">
      ${state.loading
        ? $h`<div class="block text-center pt-12"><div class="preloader"></div></div>`
        : state.error
          ? $h`<div class="block block-strong inset color-red"><p>${state.error}</p></div>`
          : $h`
            <div class="list inset">
              <ul>
                ${state.items.map((item) => $h`
                  <li class="item-content">
                    <div class="item-inner">
                      <div class="item-title">${item.name}</div>
                      <div class="item-after text-color-orange font-bold">${item.price}</div>
                    </div>
                  </li>
                `)}
              </ul>
            </div>
            <div class="block block-footer">
              <p>${i18n.features_info || 'Payments coming soon. Features are informational.'}</p>
            </div>
          `
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    items: [],
  };

  const normalize = (item) => ({
    name: item.name || item.title || item.slug || 'Feature',
    price: item.coin_price ? `${item.coin_price} coins` : `${item.price_coin || 0} coins`,
  });

  $onMounted(async () => {
    try {
      const payload = await api.shop.getFeatures();
      const data = payload?.data || payload || {};
      state.items = data.map(normalize);
    } catch (err) {
      state.error = err.message || i18n.failed_load_features || 'Failed to load features.';
    } finally {
      state.loading = false;
      $update();
    }
  });

  return $render;
};
</script>
