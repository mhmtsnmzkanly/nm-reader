<template>
  <div class="page" data-name="shop-features">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left"><a class="link back">Back</a></div>
        <div class="title">${i18n.features || 'Features'}</div>
      </div>
    </div>

    <div class="page-content">
      ${state.loading
        ? $h`<div class="block">${i18n.loading || 'Loading...'}</div>`
        : state.error
          ? $h`<div class="block error-state">${state.error}</div>`
          : $h`
            <div class="list">
              <ul>
                ${state.items.map((item) => $h`
                  <li>
                    <div class="item-content">
                      <div class="item-inner">
                        <div class="item-title">${item.name}</div>
                        <div class="item-after">${item.price}</div>
                      </div>
                    </div>
                  </li>
                `)}
              </ul>
            </div>
            <div class="block empty-state">${i18n.features_info || 'Payments coming soon. Features are informational.'}</div>
          `
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    items: [],
  };

  const normalize = (item) => ({
    name: item.name || item.title || item.slug || 'Feature',
    price: item.coin_price ? `${item.coin_price} coins` : `${item.price_coin || 0} coins`,
  });

  $onMounted(async () => {
    try {
      const payload = await api.shop.getFeatures();
      const data = payload?.data || payload || [];
      state.items = data.map(normalize);
    } catch (err) {
      state.error = err.message || i18n.failed_load_features || 'Failed to load features.';
      document.dispatchEvent(new CustomEvent('page:error', { detail: { message: state.error } }));
    } finally {
      state.loading = false;
      $update();
    }
  });

  return $render;
};
</script>
