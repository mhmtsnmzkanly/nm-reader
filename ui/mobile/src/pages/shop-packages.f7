<template>
  <div class="page" data-name="shop-packages">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <a class="link back">
            <i class="icon icon-back"></i>
            <span class="if-not-md">Back</span>
          </a>
        </div>
        <div class="title">${i18n.coin_packages || 'Coin Packages'}</div>
      </div>
    </div>

    <div class="page-content">
      ${state.loading
        ? $h`<div class="block text-center pt-12"><div class="preloader"></div></div>`
        : state.error
          ? $h`<div class="block block-strong inset color-red"><p>${state.error}</p></div>`
          : $h`
            <div class="list inset">
              <ul>
                ${state.items.map((item) => $h`
                  <li class="item-content">
                    <div class="item-inner">
                      <div class="item-title">${item.name}</div>
                      <div class="item-after text-color-blue font-bold">${item.display_price}</div>
                    </div>
                  </li>
                `)}
              </ul>
            </div>
            <div class="block block-footer">
              <p>${i18n.payments_soon || 'Payments coming soon. Packages are informational.'}</p>
            </div>
          `
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    items: [],
  };

  const normalize = (item) => ({
    name: item.name || item.title || 'Package',
    display_price: item.display_price || item.price_display || `${item.coin_amount || 0} coins`,
  });

  $onMounted(async () => {
    try {
      const payload = await api.shop.getPackages();
      const data = payload?.data || payload || [];
      state.items = data.map(normalize);
    } catch (err) {
      state.error = err.message || i18n.failed_load_packages || 'Failed to load packages.';
    } finally {
      state.loading = false;
      $update();
    }
  });

  return $render;
};
</script>
