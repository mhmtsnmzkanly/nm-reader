<template>
  <div class="page nmr-page" data-name="shop-packages">
    <div class="navbar nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left"><a class="link back text-slate-200">Back</a></div>
        <div class="title nmr-title">${i18n.coin_packages || 'Coin Packages'}</div>
      </div>
    </div>

    <div class="page-content px-5 pb-6 space-y-5">
      ${state.loading
        ? $h`<div class="nmr-panel">${i18n.loading || 'Loading...'}</div>`
        : state.error
          ? $h`<div class="nmr-panel text-red-200">${state.error}</div>`
          : $h`
            <div class="space-y-4">
              ${state.items.map((item) => $h`
                <div class="nmr-card px-4 py-3 flex items-center justify-between">
                  <div class="font-semibold text-slate-100">${item.name}</div>
                  <div class="text-sm text-amber-200">${item.display_price}</div>
                </div>
              `)}
            </div>
            <div class="nmr-panel text-slate-300">${i18n.payments_soon || 'Payments coming soon. Packages are informational.'}</div>
          `
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    items: [],
  };

  const normalize = (item) => ({
    name: item.name || item.title || 'Package',
    display_price: item.display_price || item.price_display || `${item.coin_amount || 0} coins`,
  });

  $onMounted(async () => {
    try {
      const payload = await api.shop.getPackages();
      const data = payload?.data || payload || [];
      state.items = data.map(normalize);
    } catch (err) {
      state.error = err.message || i18n.failed_load_packages || 'Failed to load packages.';
      document.dispatchEvent(new CustomEvent('page:error', { detail: { message: state.error } }));
    } finally {
      state.loading = false;
      $update();
    }
  });

  return $render;
};
</script>
