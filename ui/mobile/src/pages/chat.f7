<template>
  <div class="page" data-name="chat">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="title">Global Chat</div>
        <div class="right">
          <a class="link icon-only" @click="${loadMessages}">
            <i class="f7-icons">arrow_2_circlepath</i>
          </a>
        </div>
      </div>
    </div>

    <div class="page-content messages-content">
      <div class="messages">
        <div class="messages-title"><b>Today</b>, ${new Date().toLocaleDateString()}</div>
        
        ${state.messages.map((m) => $h`
          <div class="message ${m.isMe ? 'message-sent' : 'message-received'}">
            ${!m.isMe ? $h`
              <div class="message-avatar" style="background-image:url(${m.avatar || 'https://cdn.framework7.io/placeholder/people-100x100-1.jpg'})"></div>
            ` : ''}
            <div class="message-content">
              <div class="message-name">${m.username}</div>
              <div class="message-bubble">
                <div class="message-text">${m.text}</div>
                <div class="message-footer">${m.time}</div>
              </div>
            </div>
          </div>
        `)}

        ${state.messages.length === 0 ? $h`
          <div class="block text-center mt-12">
            <i class="f7-icons size-64 text-color-gray">chat_bubble_2</i>
            <p class="text-color-gray">No messages yet. Be the first to say hi!</p>
          </div>
        ` : ''}
      </div>
    </div>

    <!-- Message Toolbar -->
    <div class="toolbar messagebar">
      <div class="toolbar-inner">
        <div class="messagebar-area">
          <textarea class="resizable" placeholder="Message" id="chat-message-input"></textarea>
        </div>
        <a class="link icon-only" @click="${sendMessage}">
          <i class="f7-icons">arrow_up_circle_fill</i>
        </a>
      </div>
    </div>
  </div>
</template>
<script>
import store from '../js/store.js';
import api from '../js/api.js';

export default (props, { $onMounted, $onBeforeUnmount, $update, $f7 }) => {
  const state = {
    loading: true,
    messages: [],
    polling: null,
    slug: 'global-chat',
  };

  const loadMessages = async (silent = false) => {
    try {
      const payload = await api.blog.listComments(state.slug, 1, 50);
      const data = payload?.data || payload || [];
      const newMessages = (Array.isArray(data) ? data : []).map((row) => ({
        id: row.id || row.comment_id,
        username: row.username || row.author_username || 'User',
        text: row.body || row.comment || '',
        time: row.created_at ? new Date(row.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '',
        isMe: store.state.auth.isLoggedIn && (row.username === store.state.auth.user.username),
        avatar: null,
      })).reverse(); // Oldest first for chat flow

      // Only update and scroll if message count changed
      if (newMessages.length !== state.messages.length) {
        state.messages = newMessages;
        $update();
        if (!silent) scrollToBottom();
      }
    } catch (err) {
      console.error('Chat load failed:', err);
    } finally {
      state.loading = false;
      $update();
    }
  };

  const scrollToBottom = () => {
    setTimeout(() => {
      const pageContent = document.querySelector('.messages-content');
      if (pageContent) pageContent.scrollTop = pageContent.scrollHeight;
    }, 100);
  };

  const sendMessage = async () => {
    const input = document.getElementById('chat-message-input');
    const text = input?.value?.trim();
    if (!text) return;

    if (!store.state.auth.isLoggedIn) {
      $f7.popup.open('.login-popup');
      return;
    }

    try {
      await api.blog.createComment(state.slug, text);
      input.value = '';
      await loadMessages();
      scrollToBottom();
    } catch (err) {
      $f7.dialog.alert(err.message || 'Send failed');
    }
  };

  $onMounted(() => {
    loadMessages();
    state.polling = setInterval(() => loadMessages(true), 5000);
  });

  $onBeforeUnmount(() => {
    if (state.polling) clearInterval(state.polling);
  });

  return $render;
};
</script>
