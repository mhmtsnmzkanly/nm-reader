<template>
  <div class="page nmr-page" data-name="wallet">
    <div class="navbar nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left">
          <a class="link back text-slate-200">Back</a>
        </div>
        <div class="title nmr-title">${i18n.wallet || 'Wallet'}</div>
      </div>
    </div>

    <div class="page-content px-5 pb-6 space-y-5">
      ${state.loading
        ? $h`<div class="nmr-panel">${i18n.loading || 'Loading...'}</div>`
        : state.error
          ? $h`<div class="nmr-panel text-red-200">${state.error}</div>`
          : $h`
            <div class="nmr-card px-5 py-4">
              <div class="text-xs uppercase tracking-[1.2px] text-amber-200/80">${i18n.balance || 'Balance'}</div>
              <div class="mt-2 text-2xl font-semibold text-slate-100">${state.balance} ${i18n.coins || 'coins'}</div>
            </div>
            <div class="space-y-4">
              <a class="nmr-card nmr-card-hover block px-4 py-3" href="/wallet/transactions/">
                <div class="font-semibold text-slate-100">${i18n.transactions || 'Transactions'}</div>
              </a>
              <a class="nmr-card nmr-card-hover block px-4 py-3" href="/shop/packages/">
                <div class="font-semibold text-slate-100">${i18n.coin_packages || 'Coin Packages'}</div>
              </a>
              <a class="nmr-card nmr-card-hover block px-4 py-3" href="/shop/features/">
                <div class="font-semibold text-slate-100">${i18n.features || 'Features'}</div>
              </a>
            </div>
          `
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $f7, $onBeforeUnmount }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    balance: store.state.wallet.balance || 0,
  };

  const loadWallet = async () => {
    try {
      const payload = await api.wallet.getSummary();
      const data = payload?.data || payload || {};
      state.balance = data.balance || 0;
      store.dispatch('setWallet', { balance: state.balance });
      state.error = '';
    } catch (err) {
      state.error = err.message || i18n.failed_load_wallet || 'Failed to load wallet.';
      if (!store.state.auth.isLoggedIn) {
        state.error = i18n.login_required || 'Login required.';
      }
      document.dispatchEvent(new CustomEvent('page:error', { detail: { message: state.error } }));
      if (!store.state.auth.isLoggedIn) {
        $f7.popup.open('.login-popup');
      }
    } finally {
      state.loading = false;
      $update();
    }
  };

  const onAuthUpdated = () => {
    if (store.state.auth.isLoggedIn) {
      state.loading = true;
      loadWallet();
    }
  };

  $onMounted(async () => {
    document.addEventListener('auth:updated', onAuthUpdated);
    if (!store.state.auth.isLoggedIn) {
      state.loading = false;
      state.error = i18n.login_required || 'Login required.';
      $f7.popup.open('.login-popup');
      $update();
      return;
    }
    await loadWallet();
  });

  $onBeforeUnmount(() => {
    document.removeEventListener('auth:updated', onAuthUpdated);
  });

  return $render;
};
</script>
