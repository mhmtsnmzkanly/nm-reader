<template>
  <div class="page" data-name="wallet">
    ${renderAppHeader({ title: 'Wallet', subtitle: 'Balance and unlock flows', large: true })}
    <div class="page-content">
      ${!isAuthed ? renderAuthGuardBlock() : ''}
      ${isAuthed && state.loading ? renderLoadingBlock('Loading wallet...') : ''}
      ${isAuthed && state.error ? renderErrorState({ title: 'Wallet failed', message: state.error }) : ''}

      ${isAuthed && !state.loading && !state.error ? $h`
        ${renderWalletSummaryCard(state.wallet)}

        <div class="block-title">Packages</div>
        ${state.packages.length
          ? `<div class="list inset simple-list"><ul>${state.packages.map((item) => `<li>${item.name || item.title || 'Package'} • ${item.price_display || item.price_coin || 0}</li>`).join('')}</ul></div>`
          : renderEmptyState({ title: 'No packages', message: 'Packages are not configured yet.' })}

        <div class="block-title">Features</div>
        ${state.features.length
          ? `<div class="list inset simple-list"><ul>${state.features.map((item) => `<li>${item.code || item.name || 'Feature'} • ${item.price_coin || 0} coin</li>`).join('')}</ul></div>`
          : renderEmptyState({ title: 'No features', message: 'Feature products are not configured yet.' })}

        <div class="block-title">Transactions</div>
        ${state.transactions.length
          ? `<div class="list inset simple-list"><ul>${state.transactions.map((item) => `<li>${item.type || item.reference_type || 'transaction'} • ${item.amount || 0}</li>`).join('')}</ul></div>`
          : renderEmptyState({ title: 'No transactions', message: 'Wallet activity will appear here.' })}
      ` : ''}
    </div>
    ${renderBottomNav('wallet')}
  </div>
</template>
<script>
import { appStore } from '../store/app-store.js';
import { fetchShopFeatures, fetchShopPackages, fetchWalletSummary, fetchWalletTransactions } from '../services/wallet/wallet-service.js';
import { renderAppHeader } from '../components/app-header.js';
import { renderBottomNav } from '../components/bottom-nav.js';
import { renderAuthGuardBlock } from '../components/auth-guard-block.js';
import { renderLoadingBlock } from '../components/loading-block.js';
import { renderErrorState } from '../components/error-state.js';
import { renderEmptyState } from '../components/empty-state.js';
import { renderWalletSummaryCard } from '../components/wallet-summary-card.js';

export default (props, { $el, $onMounted, $onBeforeUnmount, $update }) => {
  const isAuthed = appStore.isAuthenticated();
  const state = {
    loading: true,
    error: '',
    wallet: appStore.getState().wallet,
    packages: [],
    features: [],
    transactions: [],
  };

  /**
   * Loads all wallet-related panels together to keep the screen coherent.
   */
  async function loadPage() {
    if (!isAuthed) {
      state.loading = false;
      return;
    }

    try {
      const [wallet, packages, features, transactions] = await Promise.all([
        fetchWalletSummary(),
        fetchShopPackages(),
        fetchShopFeatures(),
        fetchWalletTransactions(),
      ]);
      state.wallet = wallet;
      state.packages = packages;
      state.features = features;
      state.transactions = transactions.items;
      appStore.actions.setWalletSummary(wallet);
    } catch (error) {
      state.error = error.message || 'Unable to load wallet.';
    } finally {
      state.loading = false;
      $update();
    }
  }

  /**
   * Retries wallet loading when needed.
   */
  function handleClick(event) {
    if (event.target.closest('[data-action="retry-page"]')) {
      state.loading = true;
      state.error = '';
      $update();
      loadPage();
    }
  }

  $onMounted(() => {
    $el.addEventListener('click', handleClick);
    loadPage();
  });

  $onBeforeUnmount(() => {
    $el.removeEventListener('click', handleClick);
  });

  return $render;
};
</script>
