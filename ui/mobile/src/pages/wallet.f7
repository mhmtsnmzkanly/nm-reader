<template>
  <div class="page" data-name="wallet">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left">
          <a class="link back">Back</a>
        </div>
        <div class="title">${i18n.wallet || 'Wallet'}</div>
      </div>
    </div>

    <div class="page-content">
      ${state.loading
        ? $h`<div class="block">${i18n.loading || 'Loading...'}</div>`
        : state.error
          ? $h`<div class="block error-state">${state.error}</div>`
          : $h`
            <div class="block block-strong">
              <div>${i18n.balance || 'Balance'}</div>
              <h2>${state.balance} ${i18n.coins || 'coins'}</h2>
            </div>
            <div class="list">
              <ul>
                <li><a class="item-link item-content" href="/wallet/transactions/"><div class="item-inner"><div class="item-title">${i18n.transactions || 'Transactions'}</div></div></a></li>
                <li><a class="item-link item-content" href="/shop/packages/"><div class="item-inner"><div class="item-title">${i18n.coin_packages || 'Coin Packages'}</div></div></a></li>
                <li><a class="item-link item-content" href="/shop/features/"><div class="item-inner"><div class="item-title">${i18n.features || 'Features'}</div></div></a></li>
              </ul>
            </div>
          `
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $f7, $onBeforeUnmount }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    balance: store.state.wallet.balance || 0,
  };

  const loadWallet = async () => {
    try {
      const payload = await api.wallet.getSummary();
      const data = payload?.data || payload || {};
      state.balance = data.balance || 0;
      store.dispatch('setWallet', { balance: state.balance });
      state.error = '';
    } catch (err) {
      state.error = err.message || i18n.failed_load_wallet || 'Failed to load wallet.';
      if (!store.state.auth.isLoggedIn) {
        state.error = i18n.login_required || 'Login required.';
      }
      document.dispatchEvent(new CustomEvent('page:error', { detail: { message: state.error } }));
      if (!store.state.auth.isLoggedIn) {
        $f7.popup.open('.login-popup');
      }
    } finally {
      state.loading = false;
      $update();
    }
  };

  const onAuthUpdated = () => {
    if (store.state.auth.isLoggedIn) {
      state.loading = true;
      loadWallet();
    }
  };

  $onMounted(async () => {
    document.addEventListener('auth:updated', onAuthUpdated);
    if (!store.state.auth.isLoggedIn) {
      state.loading = false;
      state.error = i18n.login_required || 'Login required.';
      $f7.popup.open('.login-popup');
      $update();
      return;
    }
    await loadWallet();
  });

  $onBeforeUnmount(() => {
    document.removeEventListener('auth:updated', onAuthUpdated);
  });

  return $render;
};
</script>
