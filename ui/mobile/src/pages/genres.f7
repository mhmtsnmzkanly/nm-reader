<template>
  <div class="page nmr-page" data-name="genres">
    <div class="navbar nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left"><a class="link back text-slate-200">Back</a></div>
        <div class="title nmr-title">Genres</div>
      </div>
    </div>

    <div class="page-content px-5 pb-6 space-y-5">
      ${state.loading
        ? $h`<div class="nmr-panel">${i18n.loading || 'Loading...'}</div>`
        : state.error
          ? $h`<div class="nmr-panel text-red-200">${state.error}</div>`
          : $h`<div class="space-y-3">
            ${state.items.map((item) => $h`
              <a class="nmr-card nmr-card-hover block px-4 py-3" href="/genre/${item.slug}/">
                <div class="font-semibold text-slate-100">${item.name}</div>
                ${item.description ? $h`<div class="text-xs text-slate-400 mt-1">${item.description}</div>` : ''}
              </a>
            `)}
          </div>`
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    items: [],
  };

  $onMounted(async () => {
    try {
      const payload = await api.content.getGenres();
      const data = payload?.data || payload || [];
      state.items = Array.isArray(data) ? data : [];
    } catch (err) {
      state.error = err.message || 'Failed to load genres.';
    } finally {
      state.loading = false;
      $update();
    }
  });

  return $render;
};
</script>
