<template>
  <div class="page nmr-page" data-name="content-detail">
    <div class="navbar nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left">
          <a class="link back text-slate-200">Back</a>
        </div>
        <div class="title nmr-title">${state.title}</div>
      </div>
    </div>

    <div class="page-content px-5 pb-6 space-y-6">
      ${state.loading
        ? $h`<div class="nmr-panel">${i18n.loading || 'Loading...'}</div>`
        : state.error
          ? $h`<div class="nmr-panel text-red-200">${state.error}</div>`
          : $h`
            <div class="nmr-panel text-slate-200 leading-7">${state.description}</div>
            <div class="nmr-section-title">${i18n.chapters || 'Chapters'}</div>
            <div class="space-y-4">
              ${state.chapters.map((chapter) => $h`
                <a class="nmr-card nmr-card-hover block px-4 py-3" href="/reader/${chapter.type}/${chapter.slug}/${chapter.chapter_number}/">
                  <div class="flex items-center gap-4">
                    <div class="w-14 h-16 rounded-xl bg-white/10 border border-white/10 overflow-hidden shrink-0" style="background-image:url('${state.cover}');background-size:cover;background-position:center;"></div>
                    <div class="flex-1 flex items-start justify-between gap-3">
                      <div>
                        <div class="font-semibold text-slate-100">${chapter.title}</div>
                        <div class="text-xs text-slate-400 mt-1">#${chapter.chapter_number}</div>
                      </div>
                      ${chapter.is_locked
                        ? $h`<span class="nmr-chip nmr-chip--price">${chapter.price_coin} ${i18n.coins || 'coins'}</span>`
                        : $h`<span class="nmr-chip nmr-chip--free">${i18n.free || 'Free'}</span>`
                      }
                    </div>
                  </div>
                </a>
              `)}
            </div>
          `
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $f7route }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    title: 'Series',
    description: '',
    chapters: [],
    cover: '/assets/img/covers/one-piece.jpg',
    type: $f7route.params.type,
    slug: $f7route.params.slug,
  };

  const normalizeCover = (value) => {
    if (!value) return '/assets/img/covers/one-piece.jpg';
    if (value.startsWith('http://') || value.startsWith('https://')) return value;
    let normalized = value;
    while (normalized.startsWith('/')) {
      normalized = normalized.slice(1);
    }
    return `/${normalized}`;
  };

  const normalizeChapter = (item) => ({
    title: item.title || `Chapter ${item.chapter_number || item.chapterNumber || ''}`,
    slug: state.slug,
    type: state.type,
    chapter_number: item.chapter_number || item.chapterNumber || item.number || '',
    price_coin: item.price_coin || item.access?.chapter_unlock_price || 0,
    is_locked: item.is_locked ?? !(item.access?.granted ?? true),
  });

  $onMounted(async () => {
    try {
      const [contentPayload, chaptersPayload] = await Promise.all([
        api.content.getDetails(state.type, state.slug),
        api.content.getChapters(state.type, state.slug),
      ]);

      const contentData = contentPayload?.data || contentPayload || {};
      const chaptersData = chaptersPayload?.data || chaptersPayload || [];

      state.title = contentData.title || 'Series';
      state.description = contentData.description || '';
      state.cover = normalizeCover(contentData.cover_image || contentData.cover || contentData.thumbnail || contentData.image);
      state.chapters = chaptersData.map(normalizeChapter).filter((row) => row.chapter_number !== '');
    } catch (err) {
      state.error = err.message || i18n.failed_load_content || 'Failed to load content.';
      document.dispatchEvent(new CustomEvent('page:error', { detail: { message: state.error } }));
    } finally {
      state.loading = false;
      $update();
    }
  });

  return $render;
};
</script>
