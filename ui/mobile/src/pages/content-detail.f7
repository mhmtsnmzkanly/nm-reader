<template>
  <div class="page" data-name="content-detail">
    ${renderAppHeader({ title: state.detail?.title || 'Content', subtitle: 'Summary and chapters', back: true, large: true })}
    <div class="page-content">
      ${state.loading ? renderLoadingBlock('Loading content details...') : ''}
      ${state.error ? renderErrorState({ title: 'Content failed', message: state.error }) : ''}

      ${!state.loading && !state.error && state.detail ? $h`
        <div class="card mobile-detail-card">
          <div class="card-content card-content-padding">
            <div class="mobile-detail-card__hero">
              <img src="${state.detail.cover}" alt="${state.detail.title}" />
              <div>
                <div class="mobile-detail-card__title">${state.detail.title}</div>
                <div class="mobile-detail-card__meta">${state.detail.type} • ${state.detail.status || 'Ongoing'}</div>
                <p>${state.detail.description || 'No description available yet.'}</p>
              </div>
            </div>
            ${state.wallet ? renderWalletSummaryCard(state.wallet) : ''}
            <div class="mobile-detail-card__actions">
              ${state.canFollow ? `<button class="button ${state.isFollowing ? 'button-outline' : 'button-fill'}" data-action="toggle-follow">${state.isFollowing ? 'Unfollow' : 'Follow'}</button>` : ''}
              ${state.canUnlockSeries ? '<button class="button button-fill color-orange" data-action="unlock-series">Unlock series</button>' : ''}
            </div>
          </div>
        </div>

        <div class="block-title">Chapters</div>
        ${state.chapters.length ? `
          <div class="list inset media-list no-chevron">
            <ul>${state.chapters.map((chapter) => renderChapterListItem({ type, slug, chapter })).join('')}</ul>
          </div>
        ` : renderEmptyState({ title: 'No chapters yet', message: 'This series does not have readable chapters yet.' })}
      ` : ''}
    </div>
    ${renderBottomNav('home')}
  </div>
</template>
<script>
import { appStore } from '../store/app-store.js';
import { fetchChapters, fetchContentDetail, followSeries, unlockSeries, unfollowSeries } from '../services/content/content-service.js';
import { fetchWalletSummary } from '../services/wallet/wallet-service.js';
import { renderAppHeader } from '../components/app-header.js';
import { renderBottomNav } from '../components/bottom-nav.js';
import { renderWalletSummaryCard } from '../components/wallet-summary-card.js';
import { renderChapterListItem } from '../components/chapter-list-item.js';
import { renderLoadingBlock } from '../components/loading-block.js';
import { renderErrorState } from '../components/error-state.js';
import { renderEmptyState } from '../components/empty-state.js';

export default (props, { $route, $onMounted, $onBeforeUnmount, $update, $el, $f7 }) => {
  const type = $route.params.type;
  const slug = $route.params.slug;
  const state = {
    loading: true,
    error: '',
    detail: null,
    chapters: [],
    wallet: null,
    canFollow: false,
    isFollowing: false,
    canUnlockSeries: false,
  };

  /**
   * Loads detail, chapter list, and optional wallet context in one place.
   */
  async function loadPage() {
    state.loading = true;
    state.error = '';
    $update();

    try {
      const [detail, chapters] = await Promise.all([
        fetchContentDetail(type, slug),
        fetchChapters(type, slug),
      ]);

      state.detail = detail;
      state.chapters = chapters.items;
      state.canFollow = appStore.isAuthenticated();
      state.isFollowing = Boolean(detail.access?.is_following);
      state.canUnlockSeries = Boolean(detail.access?.series_unlock_price && !detail.access?.granted && appStore.isAuthenticated());

      if (appStore.isAuthenticated()) {
        state.wallet = await fetchWalletSummary();
      }
    } catch (error) {
      state.error = error.message || 'Unable to load this content.';
    } finally {
      state.loading = false;
      $update();
    }
  }

  /**
   * Handles follow/unfollow and series unlock actions from the detail page.
   */
  async function handleClick(event) {
    if (event.target.closest('[data-action="retry-page"]')) {
      loadPage();
      return;
    }

    if (event.target.closest('[data-action="toggle-follow"]')) {
      try {
        if (state.isFollowing) {
          await unfollowSeries(type, slug);
        } else {
          await followSeries(type, slug);
        }
        state.isFollowing = !state.isFollowing;
        $update();
      } catch (error) {
        $f7.dialog.alert(error.message || 'Follow action failed.');
      }
    }

    if (event.target.closest('[data-action="unlock-series"]')) {
      try {
        await unlockSeries(type, slug);
        state.wallet = await fetchWalletSummary();
        await loadPage();
      } catch (error) {
        $f7.dialog.alert(error.message || 'Series unlock failed.');
      }
    }
  }

  $onMounted(() => {
    $el.addEventListener('click', handleClick);
    loadPage();
  });

  $onBeforeUnmount(() => {
    $el.removeEventListener('click', handleClick);
  });

  return $render;
};
</script>
