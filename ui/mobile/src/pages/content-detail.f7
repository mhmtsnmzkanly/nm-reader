<template>
  <div class="page" data-name="content-detail">
    ${renderAppHeader($h, { title: state.detail?.title || 'Content', subtitle: 'Summary and chapters', back: true, large: true })}
    <div class="page-content">
      ${state.loading ? renderLoadingBlock($h, 'Loading content details...') : ''}
      ${state.error ? renderErrorState($h, { title: 'Content failed', message: state.error }) : ''}

      ${!state.loading && !state.error && state.detail ? $h`
        <div class="card mobile-detail-card">
          <div class="card-content card-content-padding">
            <div class="mobile-detail-card__hero">
              <img src="${state.detail.cover}" alt="${state.detail.title}" />
              <div>
                <div class="mobile-detail-card__title">${state.detail.title}</div>
                <div class="mobile-detail-card__meta">${state.detail.type} • ${state.detail.status || 'Ongoing'}</div>
                <p>${state.detail.description || 'No description available yet.'}</p>
              </div>
            </div>
            ${state.wallet ? renderWalletSummaryCard($h, state.wallet) : ''}
            <div class="mobile-detail-card__actions">
              ${state.canFollow ? $h`<button class="button ${state.isFollowing ? 'button-outline' : 'button-fill'}" data-action="toggle-follow">${state.isFollowing ? 'Unfollow' : 'Follow'}</button>` : ''}
              ${state.canUnlockSeries ? $h`<button class="button button-fill color-orange" data-action="unlock-series">Unlock series</button>` : ''}
            </div>
          </div>
        </div>

        <div class="block-title">Chapters</div>
        ${state.chapters.length ? $h`
          <div class="list inset media-list no-chevron">
            <ul>${state.chapters.map((chapter) => renderChapterListItem($h, { type, slug, chapter }))}</ul>
          </div>
        ` : renderEmptyState($h, { title: 'No chapters yet', message: 'This series does not have readable chapters yet.' })}
      ` : ''}
    </div>
    ${renderBottomNav($h, 'home')}
  </div>
</template>
<script>
import { appStore } from '../store/app-store.js';
import { fetchChapters, fetchContentDetail, followSeries, unlockSeries, unfollowSeries } from '../services/content/content-service.js';
import { fetchWalletSummary } from '../services/wallet/wallet-service.js';
import { renderAppHeader } from '../components/app-header.js';
import { renderBottomNav } from '../components/bottom-nav.js';
import { renderWalletSummaryCard } from '../components/wallet-summary-card.js';
import { renderChapterListItem } from '../components/chapter-list-item.js';
import { renderLoadingBlock } from '../components/loading-block.js';
import { renderErrorState } from '../components/error-state.js';
import { renderEmptyState } from '../components/empty-state.js';
import { debugError, debugTrace } from '../utils/debug.js';
import { resolveComponentElement } from '../utils/dom.js';

export default (props, { $route, $onMounted, $onBeforeUnmount, $update, $el, $f7 }) => {
  const rootEl = () => resolveComponentElement($el);
  const type = $route.params.type;
  const slug = $route.params.slug;
  const state = {
    loading: true,
    error: '',
    detail: null,
    chapters: [],
    wallet: null,
    canFollow: false,
    isFollowing: false,
    canUnlockSeries: false,
  };

  /**
   * Loads detail, chapter list, and optional wallet context in one place.
   */
  async function loadPage() {
    debugTrace({
      scope: 'contentDetailPage',
      action: 'loadPage:start',
      caller: 'contentDetailPage.loadPage',
      callee: 'contentService.fetchContentDetail+fetchChapters',
      next: 'render-content-detail',
      detail: { type, slug },
    });
    state.loading = true;
    state.error = '';
    $update();

    try {
      const [detail, chapters] = await Promise.all([
        fetchContentDetail(type, slug),
        fetchChapters(type, slug),
      ]);

      state.detail = detail;
      state.chapters = chapters.items;
      state.canFollow = appStore.isAuthenticated();
      state.isFollowing = Boolean(detail.access?.is_following);
      state.canUnlockSeries = Boolean(detail.access?.series_unlock_price && !detail.access?.granted && appStore.isAuthenticated());

      if (appStore.isAuthenticated()) {
        state.wallet = await fetchWalletSummary();
      }
      debugTrace({
        scope: 'contentDetailPage',
        action: 'loadPage:success',
        caller: 'contentDetailPage.loadPage',
        callee: 'contentService.fetchContentDetail+fetchChapters',
        next: 'paint-content-detail',
        detail: { type, slug, chapterCount: state.chapters.length },
      });
    } catch (error) {
      state.error = error.message || 'Unable to load this content.';
      debugError({
        scope: 'contentDetailPage',
        action: 'loadPage:error',
        caller: 'contentDetailPage.loadPage',
        callee: 'contentService.fetchContentDetail+fetchChapters',
        next: 'render-content-detail-error',
        detail: { type, slug, message: state.error },
      });
    } finally {
      state.loading = false;
      $update();
    }
  }

  /**
   * Handles follow/unfollow and series unlock actions from the detail page.
   */
  async function handleClick(event) {
    if (event.target.closest('[data-action="retry-page"]')) {
      debugTrace({
        scope: 'contentDetailPage',
        action: 'retry:click',
        caller: 'contentDetailPage.handleClick',
        callee: 'contentDetailPage.loadPage',
        next: 'reload-content-detail',
        detail: { type, slug },
      });
      loadPage();
      return;
    }

    if (event.target.closest('[data-action="toggle-follow"]')) {
      debugTrace({
        scope: 'contentDetailPage',
        action: 'toggleFollow:start',
        caller: 'contentDetailPage.handleClick',
        callee: state.isFollowing ? 'contentService.unfollowSeries' : 'contentService.followSeries',
        next: 'update-follow-state',
        detail: { type, slug, currentlyFollowing: state.isFollowing },
      });
      try {
        if (state.isFollowing) {
          await unfollowSeries(type, slug);
        } else {
          await followSeries(type, slug);
        }
        state.isFollowing = !state.isFollowing;
        $update();
        debugTrace({
          scope: 'contentDetailPage',
          action: 'toggleFollow:success',
          caller: 'contentDetailPage.handleClick',
          callee: 'contentService.follow-toggle',
          next: 'paint-follow-state',
          detail: { type, slug, nowFollowing: state.isFollowing },
        });
      } catch (error) {
        debugError({
          scope: 'contentDetailPage',
          action: 'toggleFollow:error',
          caller: 'contentDetailPage.handleClick',
          callee: 'contentService.follow-toggle',
          next: 'show-follow-dialog',
          detail: { type, slug, message: error.message },
        });
        $f7.dialog.alert(error.message || 'Follow action failed.');
      }
    }

    if (event.target.closest('[data-action="unlock-series"]')) {
      debugTrace({
        scope: 'contentDetailPage',
        action: 'unlockSeries:start',
        caller: 'contentDetailPage.handleClick',
        callee: 'contentService.unlockSeries',
        next: 'refresh-wallet-and-detail',
        detail: { type, slug },
      });
      try {
        await unlockSeries(type, slug);
        state.wallet = await fetchWalletSummary();
        await loadPage();
        debugTrace({
          scope: 'contentDetailPage',
          action: 'unlockSeries:success',
          caller: 'contentDetailPage.handleClick',
          callee: 'contentService.unlockSeries',
          next: 'paint-unlocked-detail',
          detail: { type, slug },
        });
      } catch (error) {
        debugError({
          scope: 'contentDetailPage',
          action: 'unlockSeries:error',
          caller: 'contentDetailPage.handleClick',
          callee: 'contentService.unlockSeries',
          next: 'show-unlock-dialog',
          detail: { type, slug, message: error.message },
        });
        $f7.dialog.alert(error.message || 'Series unlock failed.');
      }
    }
  }

  $onMounted(() => {
    debugTrace({
      scope: 'contentDetailPage',
      action: 'mounted',
      caller: 'framework7.page',
      callee: 'contentDetailPage.loadPage',
      next: 'load-content-detail',
      detail: { type, slug },
    });
    rootEl()?.addEventListener('click', handleClick);
    loadPage();
  });

  $onBeforeUnmount(() => {
    rootEl()?.removeEventListener('click', handleClick);
  });

  return $render;
};
</script>
