<template>
  <div class="page nmr-page" data-name="content-detail">
    <div class="navbar nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <a class="link back">
            <i class="f7-icons">chevron_left</i>
            <span>Back</span>
          </a>
        </div>
        <div class="title nmr-title">${state.title}</div>
        <div class="right">
          <a class="link icon-only" data-action="share">
            <i class="f7-icons">square_arrow_up</i>
          </a>
        </div>
      </div>
    </div>

    <div class="page-content">
      <!-- Hero Header with Background Blur (Native Style) -->
      <div class="block no-margin p-0 relative overflow-hidden" style="height: 300px">
        <div class="absolute inset-0 bg-cover bg-center" style="background-image:url('${state.cover}'); filter: blur(20px); transform: scale(1.1); opacity: 0.4"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#050508] to-transparent"></div>
        <div class="relative z-10 flex flex-col items-center justify-center h-full p-5 text-center pt-12">
          <img src="${state.cover}" class="detail-cover-shadow" style="width: 120px; height: 170px; border-radius: 12px; object-fit: cover" />
          <div class="mt-4">
            <div class="text-[10px] uppercase tracking-[3px] text-purple-400 font-black mb-1">${state.type}</div>
            <h1 class="text-2xl nmr-title text-white no-margin">${state.title}</h1>
          </div>
        </div>
      </div>

      <!-- Action Buttons (F7 Block) -->
      <div class="block">
        <div class="row">
          <div class="col">
            <button class="button button-fill button-large color-purple" data-action="${state.following ? 'unfollow' : 'follow'}">
              <i class="f7-icons size-18 mr-2">${state.following ? 'heart_fill' : 'heart'}</i>
              ${state.following ? 'Following' : 'Follow'}
            </button>
          </div>
          <div class="col-25">
            <button class="button button-fill button-large color-gray" data-action="rate" style="background: rgba(255,255,255,0.1)">
              <i class="f7-icons size-18">star_fill</i>
            </button>
          </div>
        </div>
      </div>

      <!-- Synopsis (F7 Expandable Block Style) -->
      <div class="block-title nmr-section-title">Synopsis</div>
      <div class="block block-strong inset nmr-panel no-margin-top">
        <p class="text-sm text-slate-300 leading-relaxed">${state.description}</p>
      </div>

      <!-- Chapters List (F7 Inset List) -->
      <div class="block-title nmr-section-title">Chapters (${state.chapters.length})</div>
      <div class="list inset media-list no-hairlines-between nmr-panel p-0">
        <ul>
          ${state.chapters.map((chapter) => $h`
            <li>
              <a href="/reader/${chapter.type}/${chapter.slug}/${chapter.chapter_number}/" class="item-link item-content">
                <div class="item-inner">
                  <div class="item-title-row">
                    <div class="item-title text-sm font-bold text-slate-100">${chapter.title}</div>
                    <div class="item-after">
                      ${chapter.is_locked
                        ? $h`<i class="f7-icons size-14 text-orange-400">lock_fill</i>`
                        : $h`<i class="f7-icons size-14 text-green-400">checkmark_circle_fill</i>`
                      }
                    </div>
                  </div>
                  <div class="item-subtitle text-[10px] text-slate-500 uppercase">Chapter ${chapter.chapter_number}</div>
                </div>
              </a>
            </li>
          `)}
        </ul>
      </div>

      <!-- Comments (F7 List) -->
      <div class="block-title nmr-section-title">Discussion</div>
      <div class="list media-list no-hairlines animate-fade-in mb-12">
        <ul>
          ${state.comments.map((comment) => $h`
            <li class="item-content">
              <div class="item-media">
                <div class="w-10 h-10 rounded-full bg-purple-600 flex items-center justify-center text-xs font-bold text-white">
                  ${comment.author[0]}
                </div>
              </div>
              <div class="item-inner">
                <div class="item-title-row">
                  <div class="item-title text-xs font-bold text-slate-200">${comment.author}</div>
                  <div class="item-after text-[9px] text-slate-500">${comment.created_at}</div>
                </div>
                <div class="item-text text-xs text-slate-400 leading-relaxed">${comment.body}</div>
              </div>
            </li>
          `)}
        </ul>
        <div class="block">
          <form id="series-comment-form">
            <div class="list no-hairlines-md">
              <ul>
                <li class="item-content item-input nmr-panel p-2">
                  <div class="item-inner">
                    <div class="item-input-wrap">
                      <textarea name="body" placeholder="Write a comment..." class="text-sm"></textarea>
                    </div>
                  </div>
                </li>
              </ul>
            </div>
            <button class="button button-fill color-purple mt-2" type="submit">Post Comment</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $f7route, $el, $f7 }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    title: 'Series',
    description: '',
    chapters: [],
    cover: '/assets/img/covers/placeholder.svg',
    comments: [],
    following: false,
    type: $f7route.params.type,
    slug: $f7route.params.slug,
  };

  const normalizeCover = (value) => {
    if (!value) return '/assets/img/covers/placeholder.svg';
    if (value.startsWith('http://') || value.startsWith('https://')) return value;
    let normalized = value;
    while (normalized.startsWith('/')) {
      normalized = normalized.slice(1);
    }
    return `/${normalized}`;
  };

  const normalizeChapter = (item) => ({
    title: item.title || `Chapter ${item.chapter_number || item.chapterNumber || ''}`,
    slug: state.slug,
    type: state.type,
    chapter_number: item.chapter_number || item.chapterNumber || item.number || '',
    price_coin: item.price_coin || item.access?.chapter_unlock_price || 0,
    is_locked: item.is_locked ?? !(item.access?.granted ?? true),
  });

  const loadComments = async () => {
    try {
      const payload = await api.interactions.listSeriesComments(state.type, state.slug, 1, 20);
      const data = payload?.data || payload || [];
      state.comments = (Array.isArray(data) ? data : []).map((row) => ({
        id: row.id || row.comment_id || 0,
        author: row.username || row.author_username || 'User',
        body: row.body || row.comment || '',
        created_at: row.created_at || '',
        votes: row.votes || row.score || 0,
      }));
    } catch (err) {
      state.comments = [];
    }
  };

  $onMounted(async () => {
    try {
      const [contentPayload, chaptersPayload] = await Promise.all([
        api.content.getDetails(state.type, state.slug),
        api.content.getChapters(state.type, state.slug),
      ]);

      const contentData = contentPayload?.data || contentPayload || {};
      const chaptersData = chaptersPayload?.data || chaptersPayload || [];

      state.title = contentData.title || 'Series';
      state.description = contentData.description || '';
      state.cover = normalizeCover(contentData.cover_image || contentData.cover || contentData.thumbnail || contentData.image);
      state.following = !!contentData.is_following || !!contentData.following || false;
      state.chapters = chaptersData.map(normalizeChapter).filter((row) => row.chapter_number !== '');
      await loadComments();
    } catch (err) {
      state.error = err.message || i18n.failed_load_content || 'Failed to load content.';
      document.dispatchEvent(new CustomEvent('page:error', { detail: { message: state.error } }));
    } finally {
      state.loading = false;
      $update();
    }
  });

  $onMounted(() => {
    $el.on('click', '[data-action="follow"]', async (event) => {
      event.preventDefault();
      try {
        await api.interactions.follow(state.type, state.slug);
        state.following = true;
        $update();
      } catch (err) {
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Follow failed' } }));
      }
    });

    $el.on('click', '[data-action="unfollow"]', async (event) => {
      event.preventDefault();
      try {
        await api.interactions.unfollow(state.type, state.slug);
        state.following = false;
        $update();
      } catch (err) {
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Unfollow failed' } }));
      }
    });

    $el.on('click', '[data-action="rate"]', (event) => {
      event.preventDefault();
      $f7.dialog.prompt('Rate 1-5', 'Rate', async (value) => {
        const score = Number(value);
        if (!score || score < 1 || score > 5) return;
        try {
          await api.interactions.rate(state.type, state.slug, score);
          $f7.toast.create({ text: 'Thanks for rating!', closeTimeout: 2000 }).open();
        } catch (err) {
          document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Rating failed' } }));
        }
      });
    });

    $el.on('submit', '#series-comment-form', async (event) => {
      event.preventDefault();
      const form = event.target;
      const body = form.querySelector('textarea[name="body"]')?.value || '';
      if (!body.trim()) return;
      try {
        await api.interactions.createSeriesComment(state.type, state.slug, body.trim());
        form.reset();
        await loadComments();
        $update();
      } catch (err) {
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Comment failed' } }));
      }
    });

    $el.on('click', '[data-action="comment-vote"]', async (event) => {
      event.preventDefault();
      const id = event.target.getAttribute('data-id');
      if (!id) return;
      try {
        await api.interactions.voteComment(id, 1);
        await loadComments();
        $update();
      } catch (err) {
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Vote failed' } }));
      }
    });
  });

  return $render;
};
</script>
