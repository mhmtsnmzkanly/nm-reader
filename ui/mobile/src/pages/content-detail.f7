<template>
  <div class="page nmr-page" data-name="content-detail">
    <div class="navbar navbar-transparent nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left">
          <a class="link back text-slate-200">
            <i class="f7-icons text-xl">chevron_left</i>
          </a>
        </div>
        <div class="title nmr-title">${state.title}</div>
      </div>
    </div>

    <div class="page-content pt-0">
      ${state.loading
        ? $h`
          <div class="p-5 pt-24 space-y-8">
            <div class="flex flex-col items-center space-y-4">
              <div class="w-48 h-64 rounded-2xl skeleton-block"></div>
              <div class="h-8 w-2/3 skeleton-text"></div>
            </div>
            <div class="space-y-3">
              <div class="h-4 w-full skeleton-text"></div>
              <div class="h-4 w-5/6 skeleton-text"></div>
            </div>
          </div>
        `
        : $h`
          <!-- Hero Background -->
          <div class="detail-header-bg" style="background-image:url('${state.cover}')"></div>

          <div class="px-5 pt-24 pb-8 space-y-8 animate-fade-in">
            <!-- Cover & Title Card -->
            <div class="flex flex-col items-center text-center space-y-6">
              <div class="w-44 h-60 rounded-[2rem] detail-cover-shadow overflow-hidden bg-slate-800">
                <img src="${state.cover}" class="w-full h-full object-cover" />
              </div>
              <div class="space-y-2">
                <div class="text-[10px] uppercase tracking-[4px] text-purple-400 font-black">${state.type}</div>
                <h1 class="text-3xl nmr-title text-slate-100">${state.title}</h1>
                <div class="flex items-center justify-center gap-4 text-xs text-slate-400">
                   <span class="flex items-center gap-1"><i class="f7-icons text-[12px]">star_fill</i> 4.8</span>
                   <span class="w-1 h-1 rounded-full bg-slate-600"></span>
                   <span>${state.chapters.length} Chapters</span>
                </div>
              </div>
            </div>

            <!-- Action Bar -->
            <div class="flex gap-3">
              <button class="nmr-button nmr-button-primary flex-1" data-action="${state.following ? 'unfollow' : 'follow'}">
                <i class="f7-icons mr-2 text-lg">${state.following ? 'heart_fill' : 'heart'}</i>
                ${state.following ? 'Following' : 'Follow'}
              </button>
              <button class="nmr-button nmr-button-ghost px-4" data-action="rate">
                <i class="f7-icons text-lg">star</i>
              </button>
              <button class="nmr-button nmr-button-ghost px-4" data-action="share">
                <i class="f7-icons text-lg">square_arrow_up</i>
              </button>
            </div>

            <!-- Tabs/Description -->
            <div class="nmr-panel bg-white/5 border-white/5 backdrop-blur-md">
               <div class="text-xs uppercase tracking-[2px] text-amber-100/60 mb-3">Synopsis</div>
               <div class="text-sm text-slate-300 leading-relaxed">${state.description}</div>
            </div>

            <!-- Chapters List -->
            <div class="space-y-5">
              <div class="flex items-center justify-between">
                <div class="nmr-section-title mb-0">Chapters</div>
                <button class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Sort Desc</button>
              </div>
              
              <div class="space-y-3">
                ${state.chapters.map((chapter, index) => $h`
                  <a class="nmr-card nmr-card-hover block p-4 bg-white/[0.02] animate-fade-in" style="animation-delay: ${index * 50}ms" href="/reader/${chapter.type}/${chapter.slug}/${chapter.chapter_number}/">
                    <div class="flex items-center justify-between">
                      <div class="flex flex-col">
                        <span class="text-xs font-bold text-slate-100">${chapter.title}</span>
                        <span class="text-[10px] text-slate-500 mt-1 uppercase">Chapter ${chapter.chapter_number}</span>
                      </div>
                      ${chapter.is_locked
                        ? $h`<span class="nmr-chip nmr-chip--price">${chapter.price_coin} <i class="f7-icons text-[10px] ml-1">money_dollar</i></span>`
                        : $h`<span class="nmr-chip nmr-chip--free text-[9px]">FREE</span>`
                      }
                    </div>
                  </a>
                `)}
              </div>
            </div>

            <!-- Comments Preview -->
            <div class="space-y-5 pb-12">
              <div class="nmr-section-title">Discussion</div>
              ${state.comments.length > 0 
                ? state.comments.slice(0, 3).map((comment) => $h`
                  <div class="nmr-card p-4 space-y-3 bg-white/[0.01]">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center text-[10px] font-bold">${comment.author[0]}</div>
                      <div class="flex flex-col">
                        <span class="text-xs font-bold text-slate-200">${comment.author}</span>
                        <span class="text-[9px] text-slate-500">${comment.created_at}</span>
                      </div>
                    </div>
                    <div class="text-xs text-slate-400 leading-relaxed">${comment.body}</div>
                  </div>
                `)
                : $h`<div class="text-center py-4 text-xs text-slate-500">No comments yet. Be the first!</div>`
              }
              <form class="nmr-card p-4 space-y-3" id="series-comment-form">
                <textarea class="nmr-input text-xs" name="body" rows="2" placeholder="Share your thoughts..."></textarea>
                <button class="nmr-button nmr-button-primary w-full py-2 text-xs" type="submit">Post Comment</button>
              </form>
            </div>
          </div>
        `
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $f7route, $el, $f7 }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    title: 'Series',
    description: '',
    chapters: [],
    cover: '/assets/img/covers/placeholder.svg',
    comments: [],
    following: false,
    type: $f7route.params.type,
    slug: $f7route.params.slug,
  };

  const normalizeCover = (value) => {
    if (!value) return '/assets/img/covers/placeholder.svg';
    if (value.startsWith('http://') || value.startsWith('https://')) return value;
    let normalized = value;
    while (normalized.startsWith('/')) {
      normalized = normalized.slice(1);
    }
    return `/${normalized}`;
  };

  const normalizeChapter = (item) => ({
    title: item.title || `Chapter ${item.chapter_number || item.chapterNumber || ''}`,
    slug: state.slug,
    type: state.type,
    chapter_number: item.chapter_number || item.chapterNumber || item.number || '',
    price_coin: item.price_coin || item.access?.chapter_unlock_price || 0,
    is_locked: item.is_locked ?? !(item.access?.granted ?? true),
  });

  const loadComments = async () => {
    try {
      const payload = await api.interactions.listSeriesComments(state.type, state.slug, 1, 20);
      const data = payload?.data || payload || [];
      state.comments = (Array.isArray(data) ? data : []).map((row) => ({
        id: row.id || row.comment_id || 0,
        author: row.username || row.author_username || 'User',
        body: row.body || row.comment || '',
        created_at: row.created_at || '',
        votes: row.votes || row.score || 0,
      }));
    } catch (err) {
      state.comments = [];
    }
  };

  $onMounted(async () => {
    try {
      const [contentPayload, chaptersPayload] = await Promise.all([
        api.content.getDetails(state.type, state.slug),
        api.content.getChapters(state.type, state.slug),
      ]);

      const contentData = contentPayload?.data || contentPayload || {};
      const chaptersData = chaptersPayload?.data || chaptersPayload || [];

      state.title = contentData.title || 'Series';
      state.description = contentData.description || '';
      state.cover = normalizeCover(contentData.cover_image || contentData.cover || contentData.thumbnail || contentData.image);
      state.following = !!contentData.is_following || !!contentData.following || false;
      state.chapters = chaptersData.map(normalizeChapter).filter((row) => row.chapter_number !== '');
      await loadComments();
    } catch (err) {
      state.error = err.message || i18n.failed_load_content || 'Failed to load content.';
      document.dispatchEvent(new CustomEvent('page:error', { detail: { message: state.error } }));
    } finally {
      state.loading = false;
      $update();
    }
  });

  $onMounted(() => {
    $el.on('click', '[data-action="follow"]', async (event) => {
      event.preventDefault();
      try {
        await api.interactions.follow(state.type, state.slug);
        state.following = true;
        $update();
      } catch (err) {
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Follow failed' } }));
      }
    });

    $el.on('click', '[data-action="unfollow"]', async (event) => {
      event.preventDefault();
      try {
        await api.interactions.unfollow(state.type, state.slug);
        state.following = false;
        $update();
      } catch (err) {
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Unfollow failed' } }));
      }
    });

    $el.on('click', '[data-action="rate"]', (event) => {
      event.preventDefault();
      $f7.dialog.prompt('Rate 1-5', 'Rate', async (value) => {
        const score = Number(value);
        if (!score || score < 1 || score > 5) return;
        try {
          await api.interactions.rate(state.type, state.slug, score);
          $f7.toast.create({ text: 'Thanks for rating!', closeTimeout: 2000 }).open();
        } catch (err) {
          document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Rating failed' } }));
        }
      });
    });

    $el.on('submit', '#series-comment-form', async (event) => {
      event.preventDefault();
      const form = event.target;
      const body = form.querySelector('textarea[name="body"]')?.value || '';
      if (!body.trim()) return;
      try {
        await api.interactions.createSeriesComment(state.type, state.slug, body.trim());
        form.reset();
        await loadComments();
        $update();
      } catch (err) {
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Comment failed' } }));
      }
    });

    $el.on('click', '[data-action="comment-vote"]', async (event) => {
      event.preventDefault();
      const id = event.target.getAttribute('data-id');
      if (!id) return;
      try {
        await api.interactions.voteComment(id, 1);
        await loadComments();
        $update();
      } catch (err) {
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Vote failed' } }));
      }
    });
  });

  return $render;
};
</script>
