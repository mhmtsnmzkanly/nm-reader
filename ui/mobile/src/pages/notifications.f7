<template>
  <div class="page" data-name="notifications">
    ${renderAppHeader({ title: 'Notifications', subtitle: 'Unread and recent account events', large: true })}
    <div class="page-content">
      ${!isAuthed ? renderAuthGuardBlock() : ''}
      ${isAuthed && state.loading ? renderLoadingBlock('Loading notifications...') : ''}
      ${isAuthed && state.error ? renderErrorState({ title: 'Notifications failed', message: state.error }) : ''}
      ${isAuthed && !state.loading && !state.error ? `
        <div class="block">
          <button class="button button-outline" data-action="mark-read">Mark all as read</button>
        </div>
        ${state.items.length
          ? `<div class="list inset simple-list"><ul>${state.items.map((item) => `<li>${item.title || item.type || 'Notification'}</li>`).join('')}</ul></div>`
          : renderEmptyState({ title: 'No notifications', message: 'You are all caught up.' })}
      ` : ''}
    </div>
    ${renderBottomNav('settings')}
  </div>
</template>
<script>
import { appStore } from '../store/app-store.js';
import { fetchNotifications, markNotificationsRead } from '../services/user/user-service.js';
import { renderAppHeader } from '../components/app-header.js';
import { renderBottomNav } from '../components/bottom-nav.js';
import { renderAuthGuardBlock } from '../components/auth-guard-block.js';
import { renderLoadingBlock } from '../components/loading-block.js';
import { renderErrorState } from '../components/error-state.js';
import { renderEmptyState } from '../components/empty-state.js';

export default (props, { $el, $onMounted, $onBeforeUnmount, $update }) => {
  const isAuthed = appStore.isAuthenticated();
  const state = {
    loading: true,
    error: '',
    items: [],
  };

  /**
   * Loads the notification feed.
   */
  async function loadPage() {
    if (!isAuthed) {
      state.loading = false;
      return;
    }

    try {
      const payload = await fetchNotifications();
      state.items = payload.items;
    } catch (error) {
      state.error = error.message || 'Unable to load notifications.';
    } finally {
      state.loading = false;
      $update();
    }
  }

  /**
   * Handles retry and mark-read actions.
   */
  async function handleClick(event) {
    if (event.target.closest('[data-action="retry-page"]')) {
      state.loading = true;
      state.error = '';
      $update();
      loadPage();
      return;
    }

    if (event.target.closest('[data-action="mark-read"]')) {
      await markNotificationsRead().catch(() => null);
      loadPage();
    }
  }

  $onMounted(() => {
    $el.addEventListener('click', handleClick);
    loadPage();
  });

  $onBeforeUnmount(() => {
    $el.removeEventListener('click', handleClick);
  });

  return $render;
};
</script>
