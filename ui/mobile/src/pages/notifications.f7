<template>
  <div class="page nmr-page" data-name="notifications">
    <div class="navbar nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left"><a class="link back text-slate-200">Back</a></div>
        <div class="title nmr-title">Notifications</div>
      </div>
    </div>

    <div class="page-content px-5 pb-6 space-y-5">
      <div class="flex gap-3">
        <button class="nmr-button nmr-button-ghost" data-action="mark-read" type="button">Mark all read</button>
      </div>
      ${state.loading
        ? $h`<div class="nmr-panel">${i18n.loading || 'Loading...'}</div>`
        : state.error
          ? $h`<div class="nmr-panel text-red-200">${state.error}</div>`
          : state.items.length
            ? $h`<div class="space-y-3">
              ${state.items.map((item) => $h`
                <div class="nmr-card px-4 py-3 space-y-2">
                  <div class="text-sm text-slate-100">${item.title}</div>
                  <div class="text-sm text-slate-300">${item.body}</div>
                  <div class="text-xs text-slate-400">${item.created_at}</div>
                </div>
              `)}
            </div>`
            : $h`<div class="nmr-panel text-slate-300">No notifications.</div>`
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import store from '../js/store.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update, $f7, $el }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    items: [],
  };

  const normalize = (item) => ({
    title: item.title || item.subject || 'Notification',
    body: item.body || item.message || '',
    created_at: item.created_at || '',
  });

  const load = async () => {
    try {
      const payload = await api.user.getNotifications();
      const data = payload?.data || payload || [];
      state.items = (Array.isArray(data) ? data : []).map(normalize);
    } catch (err) {
      state.error = err.message || 'Failed to load notifications.';
    } finally {
      state.loading = false;
      $update();
    }
  };

  $onMounted(async () => {
    if (!store.state.auth.isLoggedIn) {
      state.loading = false;
      state.error = i18n.login_required || 'Login required.';
      $f7.popup.open('.login-popup');
      $update();
      return;
    }
    await load();
  });

  $onMounted(() => {
    $el.on('click', '[data-action="mark-read"]', async (event) => {
      event.preventDefault();
      try {
        await api.user.markNotificationsRead();
        await load();
      } catch (err) {
        document.dispatchEvent(new CustomEvent('page:error', { detail: { message: err.message || 'Failed to mark read' } }));
      }
    });
  });

  return $render;
};
</script>
