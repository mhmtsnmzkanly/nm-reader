<template>
  <div class="page nmr-page" data-name="blogs">
    <div class="navbar nmr-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left"><a class="link back text-slate-200">Back</a></div>
        <div class="title nmr-title">Blogs</div>
      </div>
    </div>

    <div class="page-content px-5 pb-6 space-y-5">
      ${state.loading
        ? $h`<div class="nmr-panel">${i18n.loading || 'Loading...'}</div>`
        : state.error
          ? $h`<div class="nmr-panel text-red-200">${state.error}</div>`
          : $h`<div class="space-y-4">
            ${state.items.map((item) => $h`
              <a class="nmr-card nmr-card-hover block px-4 py-3" href="/blogs/${item.slug}/">
                <div class="space-y-2">
                  <div class="text-sm font-semibold text-slate-100">${item.title}</div>
                  <div class="text-xs text-slate-400">${item.author}</div>
                </div>
              </a>
            `)}
          </div>`
      }
    </div>
  </div>
</template>
<script>
import api from '../js/api.js';
import { getI18n } from '../js/i18n.js';

export default (props, { $onMounted, $update }) => {
  const i18n = getI18n();
  const state = {
    loading: true,
    error: '',
    items: [],
  };

  const normalize = (item) => ({
    slug: item.slug || '',
    title: item.title || 'Blog',
    author: item.author_username || item.author || 'Author',
  });

  $onMounted(async () => {
    try {
      const payload = await api.blog.list(1, 20);
      const data = payload?.data || payload || [];
      state.items = (Array.isArray(data) ? data : []).map(normalize).filter((row) => row.slug);
    } catch (err) {
      state.error = err.message || 'Failed to load blogs.';
    } finally {
      state.loading = false;
      $update();
    }
  });

  return $render;
};
</script>
