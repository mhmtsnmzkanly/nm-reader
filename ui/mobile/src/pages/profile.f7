<template>
  <div class="page" data-name="profile">
    ${$h`${renderAppHeader({ title: 'Profile', subtitle: 'Current account overview', large: true })}`}
    <div class="page-content">
      ${!isAuthed ? $h`${renderAuthGuardBlock()}` : ''}
      ${isAuthed && state.loading ? $h`${renderLoadingBlock('Loading profile...')}` : ''}
      ${isAuthed && state.error ? $h`${renderErrorState({ title: 'Profile failed', message: state.error })}` : ''}
      ${isAuthed && !state.loading && !state.error && state.profile ? $h`
        <div class="card mobile-profile-card">
          <div class="card-content card-content-padding">
            <div class="mobile-profile-card__title">${state.profile.username}</div>
            <div class="mobile-profile-card__meta">${state.profile.email || 'No email available'}</div>
            <p>${state.profile.bio || 'This account has not added a bio yet.'}</p>
          </div>
        </div>
      ` : ''}
    </div>
    ${$h`${renderBottomNav('settings')}`}
  </div>
</template>
<script>
import { appStore } from '../store/app-store.js';
import { fetchProfile } from '../services/user/user-service.js';
import { renderAppHeader } from '../components/app-header.js';
import { renderBottomNav } from '../components/bottom-nav.js';
import { renderAuthGuardBlock } from '../components/auth-guard-block.js';
import { renderLoadingBlock } from '../components/loading-block.js';
import { renderErrorState } from '../components/error-state.js';
import { debugError, debugTrace } from '../utils/debug.js';
import { resolveComponentElement } from '../utils/dom.js';

export default (props, { $el, $onMounted, $onBeforeUnmount, $update }) => {
  const rootEl = () => resolveComponentElement($el);
  const isAuthed = appStore.isAuthenticated();
  const state = {
    loading: true,
    error: '',
    profile: null,
  };

  /**
   * Loads the authenticated profile page.
   */
  async function loadPage() {
    if (!isAuthed) {
      debugTrace({
        scope: 'profilePage',
        action: 'loadPage:skipped',
        caller: 'profilePage.loadPage',
        callee: 'authGuard',
        next: 'render-auth-required',
      });
      state.loading = false;
      return;
    }

    try {
      debugTrace({
        scope: 'profilePage',
        action: 'loadPage:start',
        caller: 'profilePage.loadPage',
        callee: 'userService.fetchProfile',
        next: 'render-profile',
      });
      state.profile = await fetchProfile();
      debugTrace({
        scope: 'profilePage',
        action: 'loadPage:success',
        caller: 'profilePage.loadPage',
        callee: 'userService.fetchProfile',
        next: 'paint-profile',
      });
    } catch (error) {
      state.error = error.message || 'Unable to load profile.';
      debugError({
        scope: 'profilePage',
        action: 'loadPage:error',
        caller: 'profilePage.loadPage',
        callee: 'userService.fetchProfile',
        next: 'render-profile-error',
        detail: { message: state.error },
      });
    } finally {
      state.loading = false;
      $update();
    }
  }

  /**
   * Handles retry button clicks from the shared error state.
   */
  function handleClick(event) {
    if (event.target.closest('[data-action="retry-page"]')) {
      debugTrace({
        scope: 'profilePage',
        action: 'retry:click',
        caller: 'profilePage.handleClick',
        callee: 'profilePage.loadPage',
        next: 'reload-profile',
      });
      state.loading = true;
      state.error = '';
      $update();
      loadPage();
    }
  }

  $onMounted(() => {
    debugTrace({
      scope: 'profilePage',
      action: 'mounted',
      caller: 'framework7.page',
      callee: 'profilePage.loadPage',
      next: 'load-profile',
    });
    rootEl()?.addEventListener('click', handleClick);
    loadPage();
  });

  $onBeforeUnmount(() => {
    rootEl()?.removeEventListener('click', handleClick);
  });

  return $render;
};
</script>
