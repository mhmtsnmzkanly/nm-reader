<template>
  <div class="page" data-name="history">
    ${$h`${renderAppHeader({ title: 'History', subtitle: 'Recent reading sessions', large: true })}`}
    <div class="page-content">
      ${!isAuthed ? $h`${renderAuthGuardBlock()}` : ''}
      ${isAuthed && state.loading ? $h`${renderLoadingBlock('Loading reading history...')}` : ''}
      ${isAuthed && state.error ? $h`${renderErrorState({ title: 'History failed', message: state.error })}` : ''}
      ${isAuthed && !state.loading && !state.error
        ? (state.items.length
          ? $h`<div class="list inset simple-list"><ul>${$h`${state.items.map((item) => `<li>${item.series_title || item.title || 'Chapter'}${item.chapter_number ? ` • Chapter ${item.chapter_number}` : ''}</li>`).join('')}`}</ul></div>`
          : $h`${renderEmptyState({ title: 'No history yet', message: 'Reading progress will appear here after you open chapters.' })}` )
        : ''}
    </div>
    ${$h`${renderBottomNav('history')}`}
  </div>
</template>
<script>
import { appStore } from '../store/app-store.js';
import { fetchHistory } from '../services/user/user-service.js';
import { renderAppHeader } from '../components/app-header.js';
import { renderBottomNav } from '../components/bottom-nav.js';
import { renderAuthGuardBlock } from '../components/auth-guard-block.js';
import { renderLoadingBlock } from '../components/loading-block.js';
import { renderErrorState } from '../components/error-state.js';
import { renderEmptyState } from '../components/empty-state.js';
import { debugError, debugTrace } from '../utils/debug.js';
import { resolveComponentElement } from '../utils/dom.js';

export default (props, { $el, $onMounted, $onBeforeUnmount, $update }) => {
  const rootEl = () => resolveComponentElement($el);
  const isAuthed = appStore.isAuthenticated();
  const state = {
    loading: true,
    error: '',
    items: [],
  };

  /**
   * Loads the authenticated history feed.
   */
  async function loadPage() {
    if (!isAuthed) {
      debugTrace({
        scope: 'historyPage',
        action: 'loadPage:skipped',
        caller: 'historyPage.loadPage',
        callee: 'authGuard',
        next: 'render-auth-required',
      });
      state.loading = false;
      return;
    }

    try {
      debugTrace({
        scope: 'historyPage',
        action: 'loadPage:start',
        caller: 'historyPage.loadPage',
        callee: 'userService.fetchHistory',
        next: 'render-history',
      });
      const payload = await fetchHistory();
      state.items = payload.items;
      debugTrace({
        scope: 'historyPage',
        action: 'loadPage:success',
        caller: 'historyPage.loadPage',
        callee: 'userService.fetchHistory',
        next: 'paint-history',
        detail: { count: state.items.length },
      });
    } catch (error) {
      state.error = error.message || 'Unable to load history.';
      debugError({
        scope: 'historyPage',
        action: 'loadPage:error',
        caller: 'historyPage.loadPage',
        callee: 'userService.fetchHistory',
        next: 'render-history-error',
        detail: { message: state.error },
      });
    } finally {
      state.loading = false;
      $update();
    }
  }

  /**
   * Retries history loading on demand.
   */
  function handleClick(event) {
    if (event.target.closest('[data-action="retry-page"]')) {
      debugTrace({
        scope: 'historyPage',
        action: 'retry:click',
        caller: 'historyPage.handleClick',
        callee: 'historyPage.loadPage',
        next: 'reload-history',
      });
      state.loading = true;
      state.error = '';
      $update();
      loadPage();
    }
  }

  $onMounted(() => {
    debugTrace({
      scope: 'historyPage',
      action: 'mounted',
      caller: 'framework7.page',
      callee: 'historyPage.loadPage',
      next: 'load-history',
    });
    rootEl()?.addEventListener('click', handleClick);
    loadPage();
  });

  $onBeforeUnmount(() => {
    rootEl()?.removeEventListener('click', handleClick);
  });

  return $render;
};
</script>
