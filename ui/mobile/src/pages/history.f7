<template>
  <div class="page" data-name="history">
    ${renderAppHeader({ title: 'History', subtitle: 'Recent reading sessions', large: true })}
    <div class="page-content">
      ${!isAuthed ? renderAuthGuardBlock() : ''}
      ${isAuthed && state.loading ? renderLoadingBlock('Loading reading history...') : ''}
      ${isAuthed && state.error ? renderErrorState({ title: 'History failed', message: state.error }) : ''}
      ${isAuthed && !state.loading && !state.error
        ? (state.items.length
          ? `<div class="list inset simple-list"><ul>${state.items.map((item) => `<li>${item.series_title || item.title || 'Chapter'}${item.chapter_number ? ` • Chapter ${item.chapter_number}` : ''}</li>`).join('')}</ul></div>`
          : renderEmptyState({ title: 'No history yet', message: 'Reading progress will appear here after you open chapters.' }))
        : ''}
    </div>
    ${renderBottomNav('history')}
  </div>
</template>
<script>
import { appStore } from '../store/app-store.js';
import { fetchHistory } from '../services/user/user-service.js';
import { renderAppHeader } from '../components/app-header.js';
import { renderBottomNav } from '../components/bottom-nav.js';
import { renderAuthGuardBlock } from '../components/auth-guard-block.js';
import { renderLoadingBlock } from '../components/loading-block.js';
import { renderErrorState } from '../components/error-state.js';
import { renderEmptyState } from '../components/empty-state.js';

export default (props, { $el, $onMounted, $onBeforeUnmount, $update }) => {
  const isAuthed = appStore.isAuthenticated();
  const state = {
    loading: true,
    error: '',
    items: [],
  };

  /**
   * Loads the authenticated history feed.
   */
  async function loadPage() {
    if (!isAuthed) {
      state.loading = false;
      return;
    }

    try {
      const payload = await fetchHistory();
      state.items = payload.items;
    } catch (error) {
      state.error = error.message || 'Unable to load history.';
    } finally {
      state.loading = false;
      $update();
    }
  }

  /**
   * Retries history loading on demand.
   */
  function handleClick(event) {
    if (event.target.closest('[data-action="retry-page"]')) {
      state.loading = true;
      state.error = '';
      $update();
      loadPage();
    }
  }

  $onMounted(() => {
    $el.addEventListener('click', handleClick);
    loadPage();
  });

  $onBeforeUnmount(() => {
    $el.removeEventListener('click', handleClick);
  });

  return $render;
};
</script>
