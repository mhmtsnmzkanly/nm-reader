<template>
  <div id="app">
    <!-- Views Tabs -->
    <div class="views tabs safe-areas">
      <!-- Tab Bar -->
      <div class="toolbar toolbar-tabbar-labels toolbar-bottom">
        <div class="toolbar-inner">
          <a href="#view-home" class="tab-link tab-link-active">
            <i class="f7-icons">house_fill</i>
            <span class="tabbar-label">Home</span>
          </a>
          <a href="#view-library" class="tab-link">
            <i class="f7-icons">book_fill</i>
            <span class="tabbar-label">Library</span>
          </a>
          <a href="#view-search" class="tab-link">
            <i class="f7-icons">search</i>
            <span class="tabbar-label">Search</span>
          </a>
          <a href="#view-profile" class="tab-link">
            <i class="f7-icons">person_fill</i>
            <span class="tabbar-label">Profile</span>
          </a>
        </div>
      </div>

      <!-- Views -->
      <div id="view-home" class="view view-main view-init tab tab-active" data-url="/"></div>
      <div id="view-library" class="view view-init tab" data-name="library" data-url="/library/"></div>
      <div id="view-search" class="view view-init tab" data-name="search" data-url="/search/"></div>
      <div id="view-profile" class="view view-init tab" data-name="profile" data-url="/profile/"></div>
    </div>

    <!-- Login Popup -->
    <div class="popup login-popup">
      <div class="view">
        <div class="page">
          <div class="navbar">
            <div class="navbar-bg"></div>
            <div class="navbar-inner sliding">
              <div class="title">Login</div>
              <div class="right"><a class="link popup-close">Close</a></div>
            </div>
          </div>
          <div class="page-content">
            <div class="block">
              <form id="login-form">
                <div class="list no-hairlines-md">
                  <ul>
                    <li class="item-content item-input">
                      <div class="item-inner">
                        <div class="item-title item-label">Email</div>
                        <div class="item-input-wrap">
                          <input type="email" name="email" placeholder="you@example.com" required />
                        </div>
                      </div>
                    </li>
                    <li class="item-content item-input">
                      <div class="item-inner">
                        <div class="item-title item-label">Password</div>
                        <div class="item-input-wrap">
                          <input type="password" name="password" placeholder="Password" required />
                        </div>
                      </div>
                    </li>
                  </ul>
                </div>
                <div class="block">
                  <button class="button button-fill color-blue" type="submit">Login</button>
                  <div class="margin-top text-align-center">
                    <a class="link popup-open" data-popup=".register-popup" href="#">Create account</a>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Register Popup -->
    <div class="popup register-popup">
      <div class="view">
        <div class="page">
          <div class="navbar">
            <div class="navbar-bg"></div>
            <div class="navbar-inner sliding">
              <div class="title">Register</div>
              <div class="right"><a class="link popup-close">Close</a></div>
            </div>
          </div>
          <div class="page-content">
            <div class="block">
              <form id="register-form">
                <div class="list no-hairlines-md">
                  <ul>
                    <li class="item-content item-input">
                      <div class="item-inner">
                        <div class="item-title item-label">Username</div>
                        <div class="item-input-wrap">
                          <input type="text" name="username" placeholder="Username" required />
                        </div>
                      </div>
                    </li>
                    <li class="item-content item-input">
                      <div class="item-inner">
                        <div class="item-title item-label">Email</div>
                        <div class="item-input-wrap">
                          <input type="email" name="email" placeholder="you@example.com" required />
                        </div>
                      </div>
                    </li>
                    <li class="item-content item-input">
                      <div class="item-inner">
                        <div class="item-title item-label">Password</div>
                        <div class="item-input-wrap">
                          <input type="password" name="password" placeholder="Password" required />
                        </div>
                      </div>
                    </li>
                  </ul>
                </div>
                <div class="block">
                  <button class="button button-fill color-blue" type="submit">Create account</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Purchase Popup -->
    <div class="popup purchase-popup">
      <div class="view">
        <div class="page">
          <div class="navbar">
            <div class="navbar-bg"></div>
            <div class="navbar-inner sliding">
              <div class="title">Unlock Chapter</div>
              <div class="right"><a class="link popup-close">Cancel</a></div>
            </div>
          </div>
          <div class="page-content">
            <div class="block block-strong-ios block-inset-ios text-align-center">
              <p id="purchase-message">Unlock this chapter for coins?</p>
              <div class="row">
                <div class="col">
                  <button class="button button-fill color-blue" data-action="purchase-confirm">Unlock Now</button>
                </div>
              </div>
              <div class="row margin-top">
                <div class="col">
                  <button class="button popup-close">Cancel</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Language Sheet -->
    <div class="sheet-modal language-sheet" style="height: auto">
      <div class="sheet-modal-inner">
        <div class="block-title">Select Language</div>
        <div class="list links-list">
          <ul>
            <li><a href="#" data-action="set-lang" data-lang="en">English</a></li>
            <li><a href="#" data-action="set-lang" data-lang="tr">Turkish</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</template>
<script>
import api from './js/api.js';
import store from './js/store.js';
import { loadI18n, getI18n } from './js/i18n.js';

export default (props, { $onMounted, $onBeforeUnmount, $f7 }) => {
  let pendingPurchase = null;

  const applySession = (data) => {
    const session = {
      apiToken: data.api_token || null,
      csrfToken: data.csrf_token || null,
      refreshToken: data.refresh_token || null,
      user: { id: data.id, username: data.username, email: data.email },
    };
    api.setSession(session);
    api.saveSession(session);
    store.dispatch('setAuth', session);
  };

  const onPurchaseOpen = (event) => {
    pendingPurchase = event.detail || {};
    const messageEl = document.getElementById('purchase-message');
    if (messageEl) messageEl.textContent = `Unlock this chapter for ${pendingPurchase.price || 0} coins?`;
    $f7.popup.open('.purchase-popup');
  };

  const onDocumentClick = async (event) => {
    const purchaseBtn = event.target.closest('[data-action="purchase-confirm"]');
    if (purchaseBtn) {
      event.preventDefault();
      if (!pendingPurchase?.chapterId) return;
      try {
        await api.wallet.unlockChapter(pendingPurchase.chapterId);
        const walletPayload = await api.wallet.getSummary();
        const walletData = walletPayload?.data || walletPayload || {};
        store.dispatch('setWallet', { balance: walletData.balance || 0 });
        document.dispatchEvent(new CustomEvent('purchase:success', { detail: { chapterId: pendingPurchase.chapterId } }));
        pendingPurchase = null;
        $f7.popup.close('.purchase-popup');
      } catch (err) {
        $f7.dialog.alert(err.message || 'Unlock failed');
      }
      return;
    }

    const langBtn = event.target.closest('[data-action="set-lang"]');
    if (langBtn) {
      event.preventDefault();
      const lang = langBtn.getAttribute('data-lang');
      await loadI18n(lang);
      $f7.sheet.close('.language-sheet');
      return;
    }

    const logoutBtn = event.target.closest('[data-action="logout"]');
    if (logoutBtn) {
      event.preventDefault();
      try { await api.auth.logout(); } catch (err) {}
      store.dispatch('clearAuth');
      $f7.dialog.alert('Logged out');
    }
  };

  const onDocumentSubmit = async (event) => {
    if (event.target.id === 'login-form') {
      event.preventDefault();
      const formData = new FormData(event.target);
      try {
        const result = await api.auth.login(formData.get('email'), formData.get('password'));
        applySession(result);
        $f7.popup.close('.login-popup');
      } catch (err) {
        $f7.dialog.alert(err.message || 'Login failed');
      }
    }

    if (event.target.id === 'register-form') {
      event.preventDefault();
      const formData = new FormData(event.target);
      try {
        await api.auth.register(formData.get('username'), formData.get('email'), formData.get('password'));
        const loginResult = await api.auth.login(formData.get('email'), formData.get('password'));
        applySession(loginResult);
        $f7.popup.close('.register-popup');
      } catch (err) {
        $f7.dialog.alert(err.message || 'Register failed');
      }
    }
  };

  $onMounted(() => {
    document.addEventListener('purchase:open', onPurchaseOpen);
    document.addEventListener('click', onDocumentClick);
    document.addEventListener('submit', onDocumentSubmit);
  });

  $onBeforeUnmount(() => {
    document.removeEventListener('purchase:open', onPurchaseOpen);
    document.removeEventListener('click', onDocumentClick);
    document.removeEventListener('submit', onDocumentSubmit);
  });

  return $render;
};
</script>
