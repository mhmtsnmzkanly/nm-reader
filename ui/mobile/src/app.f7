<template>
  <div id="app">
    <div class="view view-main view-init safe-areas" data-url="/"></div>

    <div class="popup login-popup">
      <div class="view">
        <div class="page">
          <div class="navbar">
            <div class="navbar-bg"></div>
            <div class="navbar-inner">
              <div class="title">{{@global.i18n.login_title}}</div>
              <div class="right"><a class="link popup-close" href="#">Close</a></div>
            </div>
          </div>
          <div class="page-content">
            <form id="login-form" class="list">
              <ul>
                <li>
                  <div class="item-content item-input">
                    <div class="item-inner">
                      <div class="item-title item-label">{{@global.i18n.email}}</div>
                      <div class="item-input-wrap">
                        <input type="email" name="email" placeholder="you@example.com" required />
                      </div>
                    </div>
                  </div>
                </li>
                <li>
                  <div class="item-content item-input">
                    <div class="item-inner">
                      <div class="item-title item-label">{{@global.i18n.password}}</div>
                      <div class="item-input-wrap">
                        <input type="password" name="password" placeholder="Password" required />
                      </div>
                    </div>
                  </div>
                </li>
                <li>
                  <label class="item-checkbox item-content">
                    <input type="checkbox" name="remember" />
                    <i class="icon icon-checkbox"></i>
                    <div class="item-inner">
                      <div class="item-title">{{@global.i18n.remember_me}}</div>
                    </div>
                  </label>
                </li>
                <li>
                  <label class="item-checkbox item-content">
                    <input type="checkbox" name="remember" />
                    <i class="icon icon-checkbox"></i>
                    <div class="item-inner">
                      <div class="item-title">{{@global.i18n.remember_me}}</div>
                    </div>
                  </label>
                </li>
              </ul>
              <div class="block">
                <button class="button button-fill" type="submit">{{@global.i18n.login}}</button>
                <div class="login-actions">
                  <a class="link popup-open" data-popup=".register-popup" href="#">{{@global.i18n.register}}</a>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="popup register-popup">
      <div class="view">
        <div class="page">
          <div class="navbar">
            <div class="navbar-bg"></div>
            <div class="navbar-inner">
              <div class="title">{{@global.i18n.register_title}}</div>
              <div class="right"><a class="link popup-close" href="#">Close</a></div>
            </div>
          </div>
          <div class="page-content">
            <form id="register-form" class="list">
              <ul>
                <li>
                  <div class="item-content item-input">
                    <div class="item-inner">
                      <div class="item-title item-label">{{@global.i18n.username}}</div>
                      <div class="item-input-wrap">
                        <input type="text" name="username" placeholder="username" required />
                      </div>
                    </div>
                  </div>
                </li>
                <li>
                  <div class="item-content item-input">
                    <div class="item-inner">
                      <div class="item-title item-label">{{@global.i18n.email}}</div>
                      <div class="item-input-wrap">
                        <input type="email" name="email" placeholder="you@example.com" required />
                      </div>
                    </div>
                  </div>
                </li>
                <li>
                  <div class="item-content item-input">
                    <div class="item-inner">
                      <div class="item-title item-label">{{@global.i18n.password}}</div>
                      <div class="item-input-wrap">
                        <input type="password" name="password" placeholder="Password" required />
                      </div>
                    </div>
                  </div>
                </li>
              </ul>
              <div class="block">
                <button class="button button-fill" type="submit">{{@global.i18n.register}}</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>
<script>
import api from './js/api.js';
import store from './js/store.js';
import { Template7 } from 'framework7';

export default (props, { $onMounted, $el, $f7 }) => {
  const applySession = (data) => {
    const session = {
      apiToken: data.api_token || null,
      csrfToken: data.csrf_token || null,
      refreshToken: data.refresh_token || null,
      user: {
        id: data.id,
        username: data.username,
        email: data.email,
      },
    };
    api.setSession(session);
    api.saveSession(session);
    store.dispatch('setAuth', session);
  };

  $onMounted(() => {
    $el.on('submit', '#login-form', async (event) => {
      event.preventDefault();
      const form = event.target;
      const formData = new FormData(form);
      const i18n = Template7.global?.i18n || {};
      try {
        const result = await api.auth.login(
          formData.get('email'),
          formData.get('password'),
          !!formData.get('remember'),
        );
        applySession(result);
        $f7.popup.close('.login-popup');
        $f7.dialog.alert(i18n.login_success || 'Login successful');
      } catch (err) {
        $f7.dialog.alert(err.message || i18n.login_failed || 'Login failed');
      }
    });

    $el.on('submit', '#register-form', async (event) => {
      event.preventDefault();
      const form = event.target;
      const formData = new FormData(form);
      const i18n = Template7.global?.i18n || {};
      try {
        await api.auth.register(
          formData.get('username'),
          formData.get('email'),
          formData.get('password'),
        );
        const loginResult = await api.auth.login(
          formData.get('email'),
          formData.get('password'),
          !!formData.get('remember'),
        );
        applySession(loginResult);
        $f7.popup.close('.register-popup');
        $f7.dialog.alert(i18n.register_success || 'Account created. You are now logged in.');
      } catch (err) {
        $f7.dialog.alert(err.message || i18n.register_failed || 'Register failed');
      }
    });

    $el.on('click', '[data-action="logout"]', async (event) => {
      event.preventDefault();
      try {
        await api.auth.logout();
      } catch (err) {
        // ignore logout errors
      }
      const i18n = Template7.global?.i18n || {};
      store.dispatch('clearAuth');
      $f7.dialog.alert(i18n.logout_success || 'Logged out');
    });
  });

  return $render;
};
</script>
