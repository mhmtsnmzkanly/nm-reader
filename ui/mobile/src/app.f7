<template>
  <div id="app">
    <div class="view view-main view-init safe-areas" data-url="/"></div>

    <div class="popup login-popup">
      <div class="view">
        <div class="page">
          <div class="navbar">
            <div class="navbar-bg"></div>
            <div class="navbar-inner">
              <div class="title">${i18n.login_title || 'Login'}</div>
              <div class="right"><a class="link popup-close" href="#">Close</a></div>
            </div>
          </div>
          <div class="page-content">
            <form id="login-form" class="list">
              <ul>
                <li>
                  <div class="item-content item-input">
                    <div class="item-inner">
                      <div class="item-title item-label">${i18n.email || 'Email'}</div>
                      <div class="item-input-wrap">
                        <input type="email" name="email" placeholder="you@example.com" required />
                      </div>
                    </div>
                  </div>
                </li>
                <li>
                  <div class="item-content item-input">
                    <div class="item-inner">
                      <div class="item-title item-label">${i18n.password || 'Password'}</div>
                      <div class="item-input-wrap">
                        <input type="password" name="password" placeholder="Password" required />
                      </div>
                    </div>
                  </div>
                </li>
                <li>
                  <label class="item-checkbox item-content">
                    <input type="checkbox" name="remember" />
                    <i class="icon icon-checkbox"></i>
                    <div class="item-inner">
                      <div class="item-title">${i18n.remember_me || 'Remember me'}</div>
                    </div>
                  </label>
                </li>
              </ul>
              <div class="block">
                <button class="button button-fill" type="submit">${i18n.login || 'Login'}</button>
                <div class="login-actions">
                  <a class="link popup-open" data-popup=".register-popup" href="#">${i18n.register || 'Create account'}</a>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="popup register-popup">
      <div class="view">
        <div class="page">
          <div class="navbar">
            <div class="navbar-bg"></div>
            <div class="navbar-inner">
              <div class="title">${i18n.register_title || 'Register'}</div>
              <div class="right"><a class="link popup-close" href="#">Close</a></div>
            </div>
          </div>
          <div class="page-content">
            <form id="register-form" class="list">
              <ul>
                <li>
                  <div class="item-content item-input">
                    <div class="item-inner">
                      <div class="item-title item-label">${i18n.username || 'Username'}</div>
                      <div class="item-input-wrap">
                        <input type="text" name="username" placeholder="username" required />
                      </div>
                    </div>
                  </div>
                </li>
                <li>
                  <div class="item-content item-input">
                    <div class="item-inner">
                      <div class="item-title item-label">${i18n.email || 'Email'}</div>
                      <div class="item-input-wrap">
                        <input type="email" name="email" placeholder="you@example.com" required />
                      </div>
                    </div>
                  </div>
                </li>
                <li>
                  <div class="item-content item-input">
                    <div class="item-inner">
                      <div class="item-title item-label">${i18n.password || 'Password'}</div>
                      <div class="item-input-wrap">
                        <input type="password" name="password" placeholder="Password" required />
                      </div>
                    </div>
                  </div>
                </li>
              </ul>
              <div class="block">
                <button class="button button-fill" type="submit">${i18n.register || 'Create account'}</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="popup purchase-popup">
      <div class="view">
        <div class="page">
          <div class="navbar">
            <div class="navbar-bg"></div>
            <div class="navbar-inner">
              <div class="title">${i18n.purchase_title || 'Unlock Chapter'}</div>
              <div class="right"><a class="link popup-close" href="#">${i18n.purchase_cancel || 'Cancel'}</a></div>
            </div>
          </div>
          <div class="page-content">
            <div class="block">
              <p class="purchase-message" id="purchase-message"></p>
              <div class="purchase-actions">
                <a class="button button-fill" data-action="purchase-confirm" href="#">${i18n.purchase_confirm || 'Unlock Now'}</a>
                <a class="button button-outline popup-close" href="#">${i18n.purchase_cancel || 'Cancel'}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="sheet-modal language-sheet">
      <div class="sheet-modal-inner">
        <div class="block-title">${i18n.language || 'Language'}</div>
        <div class="list">
          <ul>
            <li><a class="item-link item-content" data-action="set-lang" data-lang="en" href="#"><div class="item-inner"><div class="item-title">English</div></div></a></li>
            <li><a class="item-link item-content" data-action="set-lang" data-lang="tr" href="#"><div class="item-inner"><div class="item-title">Turkish</div></div></a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</template>
<script>
import api from './js/api.js';
import store from './js/store.js';
import { loadI18n, getI18n } from './js/i18n.js';

export default (props, { $onMounted, $onBeforeUnmount, $f7 }) => {
  const i18n = getI18n();
  let pendingPurchase = null;
  const applySession = (data) => {
    const session = {
      apiToken: data.api_token || null,
      csrfToken: data.csrf_token || null,
      refreshToken: data.refresh_token || null,
      user: {
        id: data.id,
        username: data.username,
        email: data.email,
      },
    };
    api.setSession(session);
    api.saveSession(session);
    store.dispatch('setAuth', session);
  };

  const onPurchaseOpen = (event) => {
    const detail = event.detail || {};
    pendingPurchase = detail;
    const i18n = getI18n();
    const message = (i18n.unlock_confirm_body || 'Unlock this chapter for {price} coins?')
      .replace('{price}', detail.price || 0);
    const messageEl = document.getElementById('purchase-message');
    if (messageEl) messageEl.textContent = message;
    $f7.popup.open('.purchase-popup');
  };

  const onDocumentClick = async (event) => {
    const purchaseBtn = event.target.closest('[data-action="purchase-confirm"]');
    if (purchaseBtn) {
      event.preventDefault();
      if (!pendingPurchase?.chapterId) return;
      try {
        await api.wallet.unlockChapter(pendingPurchase.chapterId);
        const walletPayload = await api.wallet.getSummary();
        const walletData = walletPayload?.data || walletPayload || {};
        store.dispatch('setWallet', { balance: walletData.balance || 0 });
        document.dispatchEvent(new CustomEvent('purchase:success', { detail: { chapterId: pendingPurchase.chapterId } }));
        pendingPurchase = null;
        $f7.popup.close('.purchase-popup');
      } catch (err) {
        $f7.dialog.alert(err.message || 'Unlock failed');
      }
      return;
    }

    const langBtn = event.target.closest('[data-action="set-lang"]');
    if (langBtn) {
      event.preventDefault();
      const lang = langBtn.getAttribute('data-lang');
      if (!lang) return;
      await loadI18n(lang);
      $f7.sheet.close('.language-sheet');
      return;
    }

    const logoutBtn = event.target.closest('[data-action="logout"]');
    if (logoutBtn) {
      event.preventDefault();
      try {
        await api.auth.logout();
      } catch (err) {
        // ignore logout errors
      }
      const i18n = getI18n();
      store.dispatch('clearAuth');
      $f7.dialog.alert(i18n.logout_success || 'Logged out');
    }
  };

  const onDocumentSubmit = async (event) => {
    if (!(event.target instanceof HTMLFormElement)) return;
    if (event.target.id === 'login-form') {
      event.preventDefault();
      const formData = new FormData(event.target);
      const i18n = getI18n();
      try {
        const result = await api.auth.login(
          formData.get('email'),
          formData.get('password'),
          !!formData.get('remember'),
        );
        applySession(result);
        $f7.popup.close('.login-popup');
        $f7.dialog.alert(i18n.login_success || 'Login successful');
      } catch (err) {
        $f7.dialog.alert(err.message || i18n.login_failed || 'Login failed');
      }
      return;
    }

    if (event.target.id === 'register-form') {
      event.preventDefault();
      const formData = new FormData(event.target);
      const i18n = getI18n();
      try {
        await api.auth.register(
          formData.get('username'),
          formData.get('email'),
          formData.get('password'),
        );
        const loginResult = await api.auth.login(
          formData.get('email'),
          formData.get('password'),
          !!formData.get('remember'),
        );
        applySession(loginResult);
        $f7.popup.close('.register-popup');
        $f7.dialog.alert(i18n.register_success || 'Account created. You are now logged in.');
      } catch (err) {
        $f7.dialog.alert(err.message || i18n.register_failed || 'Register failed');
      }
    }
  };

  $onMounted(() => {
    document.addEventListener('purchase:open', onPurchaseOpen);
    document.addEventListener('click', onDocumentClick);
    document.addEventListener('submit', onDocumentSubmit);
  });

  $onBeforeUnmount(() => {
    document.removeEventListener('purchase:open', onPurchaseOpen);
    document.removeEventListener('click', onDocumentClick);
    document.removeEventListener('submit', onDocumentSubmit);
  });

  return $render;
};
</script>
