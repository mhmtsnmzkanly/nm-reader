{
  "name": "novel-manga-reader/nm-reader",
  "description": "Online Novel&Manga Reader",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": ">=8.4",
    "slim/slim": "^4.13",
    "slim/psr7": "^1.7",
    "php-di/php-di": "^7.0",
    "monolog/monolog": "^3.8",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "serve": "php -S 127.0.0.1:8080 -t public public/index.php",
    "run:apitest": "php app/Console/ApiTestSuite.php",
    "test:api": "php app/Console/ApiTestSuite.php",
    "retention:cleanup": "php app/Console/retention_cleanup.php",
    "analytics:aggregate": "php app/Console/analytics_aggregate.php",
    "openapi:generate": "php app/Console/generate_openapi.php",
    "migrate": "php app/Console/migrate.php",
    "migrate:status": "php app/Console/migrate.php --status",
    "test:seo": "php app/Console/run_seo_test.php",
    "test:ssr": "php app/Console/run_ssr_retirement_test.php",
    "test:locale": "php app/Console/run_locale_regression_test.php",
    "check:storage": "php app/Console/StorageCheck.php"
  }
}
