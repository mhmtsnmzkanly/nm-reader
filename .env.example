# Application Settings
APP_NAME=NovelMangaReader
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Session & Tokens
SESSION_LIFETIME=7200
REFRESH_TOKEN_DAYS=30
CACHE_TTL=300
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
REMEMBER_COOKIE_SECURE=false
REMEMBER_COOKIE_SAME_SITE=Lax

# Site Address
SITE_ADDRESS=http://localhost:8080

# Security
ENFORCE_HTTPS=false
# Generate a unique value with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
MEDIA_SECRET=

# Integrations
RESEND_API_KEY=
GOOGLE_ANALYTICS_ID=
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Database Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nm-reader
DB_USERNAME=root
DB_PASSWORD=default000
DB_CHARSET=utf8mb4

# Admin Settings
ROOT_USER=user_id
