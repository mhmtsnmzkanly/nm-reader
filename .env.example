# Application Settings
APP_NAME=NovelMangaReader
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

# Session & Tokens
SESSION_LIFETIME=7200
REFRESH_TOKEN_DAYS=30
CACHE_TTL=300

# Site Identity
SITE_NAME=NovelMangaReader
SITE_ABBREVIATION=NMR
SITE_DESCRIPTION="Read manga, manhwa, webtoon and novels for free on NovelMangaReader."
SITE_LOGO=/assets/img/logo.svg
SITE_ADDRESS=http://localhost:8080

# Default User Experience
DEFAULT_LANGUAGE=tr
DEFAULT_THEME=dark
DEFAULT_PROFILE_IMAGE=//api.dicebear.com/9.x/bottts/svg
DEFAULT_CONTENT_COVER_IMAGE=//placehold.co/600x400?text=Default\nCover


# Security
ENFORCE_HTTPS=false

# Integrations
RESEND_API_KEY=
GOOGLE_ANALYTICS_ID=
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Database Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nm-reader
DB_USERNAME=root
DB_PASSWORD=default000
DB_CHARSET=utf8mb4

# Admin Settings
ROOT_USER=user_id
