# Application Settings
APP_NAME=NovelMangaReader
APP_ENV=production
APP_DEBUG=false
# APP_URL is the canonical public base URL used for generated links/SEO.
APP_URL=http://localhost:8080
# SITE_ADDRESS overrides APP_URL when the public site uses a separate address.
SITE_ADDRESS=http://localhost:8080
APP_TIMEZONE=UTC
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Session & Tokens
SESSION_LIFETIME=7200
SESSION_COOKIE_LIFETIME=0
REFRESH_TOKEN_DAYS=30
CACHE_TTL=300
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
REMEMBER_COOKIE_SECURE=false
REMEMBER_COOKIE_SAME_SITE=Lax

# Security
ENFORCE_HTTPS=false
# Comma-separated reverse proxy IPs/CIDRs allowed to provide forwarded client IP headers.
TRUSTED_PROXIES=
# Generate a unique value with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
MEDIA_SECRET=
# APP_SECRET is accepted as a backwards-compatible fallback for MEDIA_SECRET.
# Prefer setting MEDIA_SECRET explicitly.
# APP_SECRET=

# Integrations
RESEND_API_KEY=
GOOGLE_ANALYTICS_ID=
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# Optional environment overrides for mail sender values. Database site
# settings are used when these are empty.
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=

# Database Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nm-reader
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_PERSISTENT=false

# Admin Settings
# Set this to the actual eight-character ID of the installation owner.
ROOT_USER=

# Required only when the installer is exposed remotely. Keep this out of
# public documentation and use a random value of at least 16 characters.
# INSTALL_TOKEN=
